# BETAAI Environment Variables
# Copy this file to .env and fill in your values.
# For Vercel: add these in Project Settings > Environment Variables

# === Required for AI Chat ===

# NVIDIA NIM — primary AI provider (free tier: meta/llama-3.1-70b-instruct)
# Get key at: https://build.nvidia.com/
NVIDIA_KEY=

# OpenRouter — fallback provider (free models: gemini-2.5-flash, llama-3.3-70b, qwen-2.5-coder)
# Get key at: https://openrouter.ai/keys
OPENROUTER_KEY=

# Optional: second OpenRouter key for failover
OPENROUTER_ALT=
