# ═══════════════════════════════════════════════════════════════
# SHESHAAI — Server-Side Environment Variables
# ═══════════════════════════════════════════════════════════════
# IMPORTANT: These keys are ONLY readable on the server (api/chat.js).
# They are NEVER bundled into the browser — completely private.
#
# HOW TO USE:
#   Local dev  → Copy this file to .env and fill in values
#   Vercel     → Go to: Project Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── GEMINI (Free tier: 15 req/min, 1M tokens/day) ──────────────
# Get free key at: https://aistudio.google.com/app/apikey
# Single key or pool of up to 6 keys for rotation:
GEMINI_KEY=
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=

# ── GROQ (Free tier: very generous limits, fastest responses) ──
# Get free key at: https://console.groq.com/keys
# Default key for chat/notebooks:
GROQ_KEY=
# Coding-mode dedicated failover key (Chat/Notebooks do NOT use this):
GROQ_1=

# ── GITHUB Models (optional, Coding failover chain only) ──
# Get token at: https://github.com/settings/tokens
# Needs 'Models' read permission (public_repo is fine for free tier).
# Used ONLY in Coding failover chain, NOT for Chat/Notebook features.
GITHUB_TOKEN=

# ── NVIDIA NIM (Coding failover chain - Coding mode only) ──────────────
# Get key at: https://build.nvidia.com/
# Coding requests use NVIDIA_KEY_1 (and optional NVIDIA_KEY_2 for rotation).
# Chat/Notebook features are NOT affected by these keys.
NVIDIA_KEY_1=
NVIDIA_KEY_2=

# ── OPENROUTER (Free models available) ─────────────────────────
# Get key at: https://openrouter.ai/keys
# Used in Coding failover chain and also as general fallback.
OPENROUTER_KEY=
