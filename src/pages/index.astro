   ═══════════════════════════════════════════════════ */
document.getElementById('generate-img-btn').onclick = async () => {
  const prompt = document.getElementById('img-prompt').value.trim(); if (!prompt) return;
  const style = document.getElementById('img-style').value;
  const [w, h] = document.getElementById('img-size').value.split('x').map(Number);
  const count = parseInt(document.getElementById('img-count').value);
  const box = document.getElementById('img-results');
  const fullPrompt = style ? prompt + ', ' + style : prompt;

  const btn = document.getElementById('generate-img-btn');
  btn.disabled = true;
  const origBtnText = btn.textContent;
  btn.textContent = 'Generating...';

  for (let i = 0; i < count; i++) {
    if (i > 0) {
      await new Promise(r => setTimeout(r, 600));
    }
    const card = document.createElement('div');
    card.className = 'break-inside-avoid mb-4 surface-card rounded-lg border border-themed shadow-level-3 overflow-hidden animate-fade-up';
    card.innerHTML = `<div class="p-8 text-center text-sm text-themed-mute animate-pulse">Generating image ${i + 1} of ${count}...</div>`;
    box.prepend(card);

    const seed = Math.floor(Math.random() * 9000000) + Date.now() + (i * 1000);
    const candidateUrls = [
      `https://image.pollinations.ai/prompt/${encodeURIComponent(fullPrompt)}?width=${w}&height=${h}&seed=${seed}&nologo=true`,
      `https://image.pollinations.ai/prompt/${encodeURIComponent(fullPrompt)}?width=${w}&height=${h}&seed=${seed}&model=flux`,
      `https://image.pollinations.ai/prompt/${encodeURIComponent(fullPrompt)}?width=${w}&height=${h}&seed=${seed}&model=turbo`
    ];
    
    const tryLoadImage = (src) => new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => resolve(src);
      img.onerror = () => reject();
      img.src = src;
    });

    try {
      let finalUrl = null;
      for (const targetUrl of candidateUrls) {
        try {
          finalUrl = await tryLoadImage(targetUrl);
          if (finalUrl) break;
        } catch(e) {}
      }
      if (!finalUrl) throw new Error('All image generation models are currently busy. Please try again.');

      card.innerHTML = `
        <img src="${finalUrl}" class="w-full cursor-pointer" onclick="document.getElementById('lightbox-img').src='${finalUrl}';document.getElementById('lightbox').classList.remove('hidden')"/>
        <div class="p-3">
          <p class="text-[11px] text-themed-mute font-mono mb-2 truncate">${esc(prompt)}</p>
          <div class="flex gap-2">
            <a href="${finalUrl}" target="_blank" download class="h-7 px-3 btn-ink rounded-pill text-[11px] font-medium flex items-center">↓ Download</a>
            <button class="h-7 px-3 border border-themed rounded-pill text-[11px] font-medium text-themed-body hover-card2" onclick="navigator.clipboard.writeText('${finalUrl}');toast('Copied!','success')">Copy URL</button>
          </div>
        </div>`;
    } catch(err) {
      card.innerHTML = `<div class="p-6 text-center text-sm text-error">${esc(err.message)} <button class="ml-2 text-xs text-link underline" onclick="this.closest('.surface-card').remove()">Remove</button></div>`;
    }
  }

  btn.disabled = false;
  btn.textContent = origBtnText;
};

