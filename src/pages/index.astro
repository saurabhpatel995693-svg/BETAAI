/* ═══════════════════════════════════════════════════
   Cloud Sync (Firebase Realtime Database)
   ═══════════════════════════════════════════════════ */
function syncToCloud() {
  if (!currentUser || currentUser.isGuest) return;
  try {
    db.ref('users/' + currentUser.uid + '/conversations').set(conversations);
    db.ref('users/' + currentUser.uid + '/settings').set({
      model: getModel(),
      persona: currentPersona,
      theme: document.documentElement.getAttribute('data-theme'),
      updatedAt: Date.now()
    });
  } catch(e) { console.warn('Sync error:', e); }
}

function syncFromCloud() {
  if (!currentUser || currentUser.isGuest) return;
  db.ref('users/' + currentUser.uid + '/conversations').once('value').then(snap => {
    const data = snap.val();
    if (data && Array.isArray(data) && data.length > 0) {
      conversations = data;
      localStorage.setItem('betaai_convs', JSON.stringify(conversations));
      renderHistory();
      toast('☁ Synced from cloud', 'success');
    }
  }).catch(e => console.warn('Cloud read error:', e));
}

document.getElementById('sync-btn').onclick = () => {
  if (!currentUser || currentUser.isGuest) return toast('Sign in with Google to sync', 'error');
  syncToCloud();
  toast('☁ Synced to cloud', 'success');
};

