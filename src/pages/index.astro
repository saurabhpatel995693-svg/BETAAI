---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>BETAAI — by SAURABH</title>
  <meta name="description" content="BETAAI by SAURABH — AI Chat, Image Generation, VibeCoding, Notebooks with Quiz & Flashcards."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css"/>

  <!-- Firebase SDKs (compat for simplicity) -->
  <script is:inline src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script is:inline src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
  <script is:inline src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>
  <script is:inline src="https://www.gstatic.com/firebasejs/10.12.0/firebase-analytics-compat.js"></script>

  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: ['selector', '[data-theme="dark"]'],
      theme: {
        extend: {
          fontFamily: { sans: ['Inter','system-ui','sans-serif'], mono: ['JetBrains Mono','monospace'] },
          colors: {
            ink: '#171717', body: '#4d4d4d', mute: '#888888',
            canvas: '#ffffff', 'canvas-soft': '#fafafa', 'canvas-soft-2': '#f5f5f5',
            hairline: '#ebebeb', 'hairline-strong': '#a1a1a1',
            link: '#0070f3', 'link-deep': '#0761d1', 'link-bg-soft': '#d3e5ff',
            error: '#ee0000', 'error-soft': '#f7d4d6', 'error-deep': '#c50000',
            warning: '#f5a623', 'warning-soft': '#ffefcf',
            success: '#0070f3',
            violet: '#7928ca', cyan: '#50e3c2', pink: '#ff0080',
            /* dark-mode surfaces */
            'dk-bg': '#0a0a0a', 'dk-card': '#141414', 'dk-card2': '#1a1a1a', 'dk-border': '#2e2e2e', 'dk-mute': '#666666',
          },
          borderRadius: { xs:'4px', sm:'6px', md:'8px', lg:'12px', xl:'16px', pill:'100px' },
          spacing: { xxs:'4px', xs:'8px', sm:'12px', md:'16px', lg:'24px', xl:'32px', '2xl':'40px', '3xl':'48px', '4xl':'64px' },
          boxShadow: {
            'level-2':'0 0 0 1px rgba(0,0,0,0.08) inset,0 1px 1px rgba(0,0,0,0.02),0 2px 2px rgba(0,0,0,0.04)',
            'level-3':'0 0 0 1px rgba(0,0,0,0.08) inset,0 2px 2px rgba(0,0,0,0.04),0 8px 8px -8px rgba(0,0,0,0.04)',
            'level-4':'0 0 0 1px rgba(0,0,0,0.08) inset,0 2px 2px rgba(0,0,0,0.04),0 8px 16px -4px rgba(0,0,0,0.04)',
            'level-5':'0 0 0 1px rgba(0,0,0,0.08) inset,0 1px 1px rgba(0,0,0,0.02),0 8px 16px -4px rgba(0,0,0,0.04),0 24px 32px -8px rgba(0,0,0,0.06)',
          }
        }
      }
    }
  </script>
  <style>
    /* ── Light defaults ── */
    :root { --bg:#fafafa; --card:#fff; --card2:#f5f5f5; --border:#ebebeb; --ink:#171717; --body:#4d4d4d; --mute:#888; }
    [data-theme="dark"] { --bg:#0a0a0a; --card:#141414; --card2:#1a1a1a; --border:#2e2e2e; --ink:#ededed; --body:#a1a1a1; --mute:#666; }
    body { background:var(--bg); color:var(--ink); transition:background .3s,color .3s; }

    /* ── Vercel Typography ── */
    .text-display-xl{font-size:48px;line-height:48px;letter-spacing:-2.4px;font-weight:600}
    .text-display-lg{font-size:32px;line-height:40px;letter-spacing:-1.28px;font-weight:600}
    .text-display-md{font-size:24px;line-height:32px;letter-spacing:-0.96px;font-weight:600}
    .text-display-sm{font-size:20px;line-height:28px;letter-spacing:-.6px;font-weight:600}

    /* ── Mesh gradient ── */
    @keyframes gradient-shift{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
    .mesh-gradient{background:linear-gradient(135deg,#007cf0,#00dfd8,#7928ca,#ff0080,#ff4d4d,#f9cb28);background-size:300% 300%;animation:gradient-shift 8s ease infinite}

    /* ── Theme-adaptive surfaces ── */
    .surface-page{background:var(--bg)}
    .surface-card{background:var(--card);border-color:var(--border)}
    .surface-card2{background:var(--card2);border-color:var(--border)}
    .text-themed-ink{color:var(--ink)} .text-themed-body{color:var(--body)} .text-themed-mute{color:var(--mute)}
    .border-themed{border-color:var(--border)}
    .hover-card2:hover{background:var(--card2)}

    /* ── Markdown ── */
    .markdown-body pre{background:#171717!important;border-radius:8px;padding:16px;overflow-x:auto;margin:12px 0;position:relative}
    .markdown-body pre code{color:#e5e5e5;font-size:13px}
    .markdown-body code:not(pre code){background:var(--card2);color:var(--ink);padding:2px 6px;border-radius:4px;font-size:13px}
    .markdown-body blockquote{border-left:3px solid var(--border);padding-left:16px;color:var(--body);margin:12px 0}
    .markdown-body table{width:100%;border-collapse:collapse;margin:12px 0}
    .markdown-body th,.markdown-body td{border:1px solid var(--border);padding:8px 12px;text-align:left;font-size:14px}
    .markdown-body th{background:var(--card2);font-weight:500}
    .markdown-body ul,.markdown-body ol{padding-left:20px;margin:8px 0}
    .markdown-body li{margin:4px 0}
    .markdown-body h1,.markdown-body h2,.markdown-body h3{margin:16px 0 8px;font-weight:600;letter-spacing:-.02em}

    /* ── Scrollbar ── */
    ::-webkit-scrollbar{width:6px} ::-webkit-scrollbar-thumb{background:var(--mute);border-radius:100px}
    ::-webkit-scrollbar-track{background:transparent}

    /* ── Flashcards ── */
    .flashcard{perspective:1000px;cursor:pointer} .flashcard-inner{transition:transform .6s;transform-style:preserve-3d}
    .flashcard.flipped .flashcard-inner{transform:rotateY(180deg)}
    .flashcard-front,.flashcard-back{backface-visibility:hidden;position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:24px;border-radius:8px}
    .flashcard-back{transform:rotateY(180deg)}

    /* ── Animations ── */
    @keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
    @keyframes pulse-dot{0%,100%{opacity:1}50%{opacity:.3}}
    .animate-fade-up{animation:fadeUp .3s ease}
    .pulse-dot{animation:pulse-dot 1.2s ease infinite}

    /* ── Voice wave ── */
    @keyframes voice-wave{0%,100%{height:8px}50%{height:20px}}
    .voice-bar{width:3px;border-radius:100px;animation:voice-wave .8s ease infinite}
    .voice-bar:nth-child(2){animation-delay:.1s}.voice-bar:nth-child(3){animation-delay:.2s}.voice-bar:nth-child(4){animation-delay:.3s}

    /* ── Live preview iframe ── */
    .live-preview-frame{border:0;width:100%;height:300px;border-radius:0 0 8px 8px;background:#fff}

    /* ── Button ink themed ── */
    .btn-ink{background:var(--ink);color:var(--bg)}
    .btn-ink:hover{opacity:.9}
    [data-theme="dark"] .btn-ink{background:#ededed;color:#0a0a0a}

    /* ── Sidebar active indicator ── */
    .mode-active{position:relative}
    .mode-active::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:3px;height:16px;background:linear-gradient(180deg,#007cf0,#7928ca);border-radius:0 4px 4px 0}

    /* Mobile overlay */
    .sidebar-overlay{display:none}
    .sidebar-overlay.active{display:block;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:40}
    @media(max-width:1023px){.sidebar-mobile{transform:translateX(-100%);transition:transform .3s}.sidebar-mobile.open{transform:translateX(0)}}
  </style>
</head>
<body class="font-sans antialiased min-h-screen">

<!-- ══════════════════════════════════════════════════════════════ -->
<!--                        LOGIN SCREEN                           -->
<!-- ══════════════════════════════════════════════════════════════ -->
<div id="login-screen" class="fixed inset-0 z-50 flex items-center justify-center surface-page">
  <div class="max-w-sm w-full mx-4 animate-fade-up">
    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="w-20 h-20 rounded-xl mesh-gradient mx-auto mb-4 flex items-center justify-center text-white text-display-md shadow-level-4">β</div>
      <h1 class="text-display-lg text-themed-ink">BETAAI.</h1>
      <p class="text-themed-body text-sm mt-2">AI platform by <strong class="text-themed-ink">SAURABH</strong></p>
      <p class="text-themed-mute text-xs mt-1 font-mono">Chat · Image Gen · VibeCoding · Notebooks</p>
    </div>
    <!-- Auth Buttons -->
    <div class="space-y-3">
      <button id="login-google" class="w-full h-12 btn-ink rounded-pill text-sm font-medium flex items-center justify-center gap-2 transition shadow-level-3">
        <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A11.96 11.96 0 001 12c0 1.94.46 3.77 1.18 5.07l3.66-2.98z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Sign in with Google
      </button>
      <button id="login-guest" class="w-full h-12 surface-card border border-themed text-themed-ink rounded-pill text-sm font-medium hover-card2 transition shadow-level-2">
        Continue as guest
      </button>
    </div>
    <!-- Status -->
    <div id="login-status" class="text-center text-xs text-themed-mute mt-4 font-mono hidden"></div>
    <p class="text-center text-themed-mute text-[11px] font-mono mt-6">v2.5 · Firebase Auth · Cloud Sync · Created by SAURABH</p>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════ -->
<!--                          APP SHELL                            -->
<!-- ══════════════════════════════════════════════════════════════ -->
<div id="app-shell" class="hidden h-screen">
<div class="flex h-full">

  <!-- Sidebar overlay for mobile -->
  <div id="sidebar-overlay" class="sidebar-overlay" onclick="toggleSidebar()"></div>

  <!-- ─── SIDEBAR ─── -->
  <aside id="sidebar" class="w-[280px] border-r border-themed surface-card flex flex-col h-full shrink-0 fixed lg:relative z-50 sidebar-mobile">

    <!-- Brand -->
    <div class="p-4 flex items-center gap-3 border-b border-themed">
      <div class="w-9 h-9 rounded-lg mesh-gradient flex items-center justify-center text-white text-sm font-semibold shadow-level-2">β</div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-semibold tracking-tight text-themed-ink">BETAAI</div>
        <div class="text-[11px] font-mono text-themed-mute truncate">by SAURABH</div>
      </div>
      <button onclick="toggleTheme()" class="w-8 h-8 rounded-sm border border-themed flex items-center justify-center text-themed-mute hover:text-themed-ink transition" title="Toggle theme">
        <span id="theme-icon">🌙</span>
      </button>
    </div>

    <!-- Mode Navigation -->
    <div class="p-2 space-y-0.5">
      <button data-mode="chat" class="mode-btn mode-active w-full h-9 px-3 rounded-sm text-[13px] font-medium flex items-center gap-2 text-themed-ink transition hover-card2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        Chat
      </button>
      <button data-mode="image" class="mode-btn w-full h-9 px-3 rounded-sm text-[13px] font-medium flex items-center gap-2 text-themed-body transition hover-card2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Image Gen
      </button>
      <button data-mode="code" class="mode-btn w-full h-9 px-3 rounded-sm text-[13px] font-medium flex items-center gap-2 text-themed-body transition hover-card2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        VibeCoding
      </button>
      <button data-mode="notebook" class="mode-btn w-full h-9 px-3 rounded-sm text-[13px] font-medium flex items-center gap-2 text-themed-body transition hover-card2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        Notebooks
      </button>
      <button data-mode="search" class="mode-btn w-full h-9 px-3 rounded-sm text-[13px] font-medium flex items-center gap-2 text-themed-body transition hover-card2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        Web Search
      </button>
    </div>

    <div class="px-3"><div class="border-t border-themed"></div></div>

    <!-- New Chat + Search -->
    <div class="p-2 space-y-1.5">
      <button id="new-chat-btn" class="w-full h-9 btn-ink rounded-sm text-[13px] font-medium flex items-center justify-center gap-1 transition">
        <span>+</span> New chat
      </button>
      <div class="relative">
        <input id="search-history" placeholder="Search chats..." class="w-full h-8 pl-8 pr-2 rounded-sm text-xs surface-card2 border border-themed text-themed-ink placeholder:text-themed-mute focus:outline-none"/>
        <svg class="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-themed-mute" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
    </div>

    <!-- History -->
    <div id="history-list" class="flex-1 overflow-y-auto px-2 py-1 space-y-0.5 text-[13px]"></div>

    <!-- User Footer -->
    <div class="p-3 border-t border-themed">
      <div class="flex items-center gap-2">
        <img id="sidebar-avatar" class="w-8 h-8 rounded-full border border-themed" src="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32'><rect fill='%23f5f5f5' width='32' height='32' rx='16'/><text x='16' y='20' text-anchor='middle' fill='%23888' font-size='14'>G</text></svg>" alt="avatar"/>
        <div class="flex-1 min-w-0">
          <div id="sidebar-user-name" class="text-xs font-medium truncate text-themed-ink">Guest</div>
          <div id="sidebar-user-email" class="text-[10px] font-mono text-themed-mute truncate">local</div>
        </div>
        <button id="sync-btn" class="w-7 h-7 rounded-sm border border-themed flex items-center justify-center text-themed-mute hover:text-link text-xs transition" title="Cloud sync">☁</button>
        <button id="logout-btn" class="w-7 h-7 rounded-sm border border-themed flex items-center justify-center text-themed-mute hover:text-error text-xs transition" title="Logout">↗</button>
      </div>
      <div class="text-[10px] font-mono text-themed-mute mt-1.5 text-center">CREATED BY SAURABH</div>
    </div>
  </aside>

  <!-- ─── MAIN CONTENT ─── -->
  <main class="flex-1 flex flex-col h-full overflow-hidden surface-page">

    <!-- ── Top Bar ── -->
    <header class="h-14 px-4 flex items-center justify-between border-b border-themed surface-card shrink-0">
      <div class="flex items-center gap-2">
        <button id="mobile-menu-btn" class="lg:hidden w-8 h-8 rounded-sm border border-themed flex items-center justify-center text-themed-body" onclick="toggleSidebar()">☰</button>
        <h2 id="topbar-title" class="text-sm font-semibold tracking-tight truncate max-w-[180px] text-themed-ink">New chat</h2>
        <div id="model-pill" class="hidden items-center gap-1.5 px-2 h-6 rounded-full surface-card2 border border-themed text-[10px] font-mono text-themed-mute">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan pulse-dot"></span>
          <span id="model-pill-text">gpt-4o-mini</span>
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <select id="model-select" class="hidden h-7 px-2 rounded-sm surface-card2 border border-themed text-[11px] font-mono text-themed-ink focus:outline-none">
          <option value="nvidia/nemotron-3-ultra-550b-a55b:free" selected>nemotron-3-ultra:free</option>
          <option value="free02/glm5.1:part1">free02/glm5.1:part1</option>
          <option value="poolside/laguna-xs-2.1:free">poolside/laguna-xs-2.1:free</option>
          <option value="google/gemini-2.5-flash:free">gemini-2.5-flash:free</option>
          <option value="meta-llama/llama-4-maverick:free">llama-4-maverick:free</option>
          <option value="deepseek/deepseek-chat-v3-0324:free">deepseek-v3:free</option>
          <option value="qwen/qwen3-235b-a22b:free">qwen3-235b:free</option>
          <option value="mistralai/mistral-small-3.2-24b-instruct:free">mistral-small:free</option>
          <option value="openai/gpt-4o-mini">gpt-4o-mini</option>
          <option value="anthropic/claude-sonnet-4">claude-sonnet-4</option>
        </select>
        <button id="settings-btn" class="w-8 h-8 rounded-sm border border-themed flex items-center justify-center text-themed-body hover:text-themed-ink transition">⚙</button>
        <button id="export-btn" class="w-8 h-8 rounded-sm border border-themed flex items-center justify-center text-themed-body hover:text-themed-ink transition" title="Export chat">↓</button>
      </div>
    </header>

    <!-- ═══════════ VIEW: CHAT ═══════════ -->
    <div id="view-chat" class="flex-1 flex flex-col overflow-hidden">
      <!-- Welcome -->
      <div id="chat-welcome" class="flex-1 flex items-center justify-center p-6">
        <div class="max-w-lg text-center animate-fade-up">
          <div class="w-20 h-20 rounded-xl mesh-gradient mx-auto mb-6 flex items-center justify-center text-white text-3xl font-semibold shadow-level-4">β</div>
          <h2 class="text-display-lg text-themed-ink mb-2">What can I help with?</h2>
          <p class="text-themed-body text-sm mb-8">AI assistant by <strong class="text-themed-ink">SAURABH</strong> — chat, generate images, code, and study.</p>
          <!-- Suggestion Grid -->
          <div class="grid grid-cols-2 gap-3 text-left">
            <button class="suggest-btn p-4 rounded-md surface-card border border-themed shadow-level-2 hover:shadow-level-3 transition text-left animate-fade-up" style="animation-delay:0s">
              <div class="text-xs font-medium mb-1 text-themed-ink">💬 Explain quantum computing</div>
              <div class="text-[11px] text-themed-mute">In simple terms</div>
            </button>
            <button class="suggest-btn p-4 rounded-md surface-card border border-themed shadow-level-2 hover:shadow-level-3 transition text-left animate-fade-up" style="animation-delay:.05s">
              <div class="text-xs font-medium mb-1 text-themed-ink">🐍 Write a Python script</div>
              <div class="text-[11px] text-themed-mute">API data fetcher</div>
            </button>
            <button class="suggest-btn p-4 rounded-md surface-card border border-themed shadow-level-2 hover:shadow-level-3 transition text-left animate-fade-up" style="animation-delay:.1s">
              <div class="text-xs font-medium mb-1 text-themed-ink">🎨 Generate an image</div>
              <div class="text-[11px] text-themed-mute">Futuristic city at sunset</div>
            </button>
            <button class="suggest-btn p-4 rounded-md surface-card border border-themed shadow-level-2 hover:shadow-level-3 transition text-left animate-fade-up" style="animation-delay:.15s">
              <div class="text-xs font-medium mb-1 text-themed-ink">📝 Write a blog post</div>
              <div class="text-[11px] text-themed-mute">About AI in education</div>
            </button>
          </div>
          <!-- Persona selector -->
          <div class="mt-6">
