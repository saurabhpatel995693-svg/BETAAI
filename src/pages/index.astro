function getValidKey(userKey, defaultKey) {
  if (userKey && typeof userKey === 'string' && userKey.trim().length > 5) {
    const k = userKey.trim();
    if (k.startsWith('sk-or-v1-') || k.startsWith('nvapi-')) return k;
  }
  return defaultKey;
}

function getAPIKey() {
  const userEnteredKey = document.getElementById('s-api-key')?.value;
  return getValidKey(userEnteredKey, DEFAULT_API_KEY);
}
function getModel() { return document.getElementById('model-select').value; }
function getApiBaseUrl() { return document.getElementById('s-api-base')?.value?.trim() || localStorage.getItem('betaai_api_base') || 'https://openrouter.ai/api/v1'; }

/* ═══════════════════════════════════════════════════
   High-Availability API Key Failover Core
   ═══════════════════════════════════════════════════ */
async function fetchChatCompletion(config, bodyParams, signal = null) {
  const apiKey = getValidKey(config.key, DEFAULT_API_KEY);
  const endpoint = (config.base && config.base.startsWith('/api'))
    ? '/api/chat'
    : config.base + '/chat/completions';

  const res = await fetch(endpoint, {
    method: 'POST',
    signal: signal,
    headers: {
      'Authorization': 'Bearer ' + apiKey,
      'Content-Type': 'application/json',
      'X-Title': 'BETAAI'
    },
    body: JSON.stringify({
      key: apiKey,
      model: config.model,
      ...bodyParams
    })
  });

  if (!res.ok) {
    let errMsg = `HTTP error ${res.status}`;
    try {
      const errData = await res.json();
      errMsg = errData.error?.message || errMsg;
    } catch(e) {}
    throw new Error(errMsg);
  }
  return res;
}

async function fetchWithFailover(apiCallFn, mode = 'general') {
  const userEnteredKey = document.getElementById('s-api-key')?.value;
  const selectedModel = getModel();

  // ALL requests go through /api/chat server proxy which handles:
  // TIER 1: NVIDIA NIM (meta/llama-3.1-70b-instruct) — confirmed working
  // TIER 2: OpenRouter multi-key failover (if free models return)
  // This eliminates CORS, auth header, and timeout issues
  let attempts = [
    {
      label: 'BETAAI Server Proxy (NVIDIA + Failover)',
      key: getValidKey(userEnteredKey, DEFAULT_API_KEY),
      base: '/api',
      model: selectedModel
    }
  ];

  let lastError = null;
  for (let i = 0; i < attempts.length; i++) {
    const config = attempts[i];
    
    try {
      if (i > 0) {
        toast(`[Failover] Retrying with ${config.label}: ${config.model}...`, 'warning');
      }
      const response = await apiCallFn(config);
      if (!response) {
        throw new Error(`Provider ${config.label} returned no response.`);
      }
      return response;
    } catch (err) {
      console.warn(`[Failover] ${config.label} (${config.model}) failed:`, err.message);
      lastError = err;
    }
  }
  throw new Error(lastError ? lastError.message : 'All AI providers failed. Please check network or settings.');
}


