function enterApp() {
  isLoggingIn = false;
  const googleBtn = document.getElementById('login-google');
  const guestBtn = document.getElementById('login-guest');
  if (googleBtn && guestBtn) {
    googleBtn.disabled = false;
    guestBtn.disabled = false;
