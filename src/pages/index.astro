async function fetchChatCompletion(config, bodyParams, signal = null) {
  // ALWAYS route through /api/chat server proxy — never call 3rd-party APIs
  // directly from the browser (CORS will block them).
  // The proxy uses x-custom-key, x-custom-base, x-custom-model headers
  // to forward to the user's chosen provider server-side.
  const endpoint = '/api/chat';

  const customKey   = getCustomKey();
  const customBase  = getCustomBase();
  const customModel = getCustomModel();

  const headers = {
    'Content-Type': 'application/json',
    'X-Title': 'BETAAI',
    'x-custom-key':   customKey,
    'x-custom-base':  customBase,
    'x-custom-model': customModel,
    'x-gemini-key':   localStorage.getItem('betaai_gemini_key') || '',
    'x-grok-key':     localStorage.getItem('betaai_grok_key') || '',
    'x-openrouter-key': localStorage.getItem('betaai_openrouter_key') || '',
    'x-nvidia-key':   localStorage.getItem('betaai_nvidia_key') || '',
    'x-hf-token':     localStorage.getItem('betaai_hf_token') || '',
    'x-zen-key':      localStorage.getItem('betaai_zen_key') || ''
  };

  const payload = {
    customKey,
    customBase,
    customModel,
    model: customModel || config.model || '',
    geminiKey:     localStorage.getItem('betaai_gemini_key') || '',
    grokKey:       localStorage.getItem('betaai_grok_key') || '',
    openrouterKey: localStorage.getItem('betaai_openrouter_key') || '',
    nvidiaKey:     localStorage.getItem('betaai_nvidia_key') || '',
    hfToken:       localStorage.getItem('betaai_hf_token') || '',
    zenKey:        localStorage.getItem('betaai_zen_key') || '',
    mode: (isVibeChat || config.mode === 'code') ? 'code' : 'general',
    ...bodyParams
  };

  const res = await fetch(endpoint, {
    method: 'POST',
    signal: signal,
    headers: headers,
    body: JSON.stringify(payload)
  });

  if (!res.ok) {
    let errMsg = `HTTP error ${res.status}`;
    try {
      const errData = await res.json();
      errMsg = errData.error?.message || errData.message || errMsg;
    } catch(e) {}
    throw new Error(errMsg);
  }
  return res;
}

async function fetchWithFailover(apiCallFn, mode = 'general') {
  const selectedModel = getModel();

  // All requests always go through /api/chat — single attempt.
  // The server proxy handles routing to the user's custom provider.
  const attempts = [{
    label: 'BETAAI Server Proxy',
    base: '/api',
    model: selectedModel
  }];

  let lastError = null;
  for (let i = 0; i < attempts.length; i++) {
    const config = attempts[i];
    try {
      const response = await apiCallFn(config);
      if (!response) throw new Error(`No response from ${config.label}`);
      return response;
    } catch (err) {
      console.warn(`[BETAAI] ${config.label} failed:`, err.message);
      lastError = err;
    }
  }
  throw new Error(lastError ? lastError.message : 'AI request failed. Check your API key and settings.');
}


