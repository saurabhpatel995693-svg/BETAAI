async function sendChat() {
  const input = document.getElementById('chat-input');
  const text = input.value.trim(); if (!text) return;
  input.value = ''; input.style.height = 'auto';
  document.getElementById('char-count').textContent = '0';

  document.getElementById('chat-welcome').classList.add('hidden');
  document.getElementById('chat-messages').classList.remove('hidden');
  const list = document.getElementById('messages-list');

  if (!currentConvId) {
    currentConvId = 'c_' + Date.now();
    conversations.unshift({ id: currentConvId, title: text.substring(0,50), msgs: [], ts: Date.now() });
  }
  const conv = conversations.find(c => c.id === currentConvId);

  // Build user content
  let userContent = text;
  if (attachedFile) {
    userContent += '\n\n[Attached file: ' + attachedFile.name + ']\n```\n' + attachedFile.content + '\n```';
    attachedFile = null;
    document.getElementById('file-attach-preview').classList.add('hidden');
  }
  conv.msgs.push({ role: 'user', content: userContent });

  // User bubble
  const userEl = document.createElement('div');
  userEl.className = 'flex justify-end animate-fade-up';
  userEl.innerHTML = `<div class="max-w-[80%] btn-ink rounded-lg rounded-br-none p-4 text-sm">${esc(text)}${attachedFile?'<div class="text-[10px] opacity-60 mt-1">📎 '+esc(attachedFile.name)+'</div>':''}</div>`;
  list.appendChild(userEl);

  // AI bubble
  const aiEl = document.createElement('div');
  aiEl.className = 'flex gap-3 animate-fade-up';
  aiEl.innerHTML = `
    <div class="w-7 h-7 rounded-lg mesh-gradient flex items-center justify-center text-white text-[11px] font-semibold shrink-0 mt-0.5 shadow-level-2">β</div>
    <div class="flex-1 min-w-0">
      <div class="surface-card border border-themed rounded-lg rounded-tl-none p-4 shadow-level-2 text-sm markdown-body"><span class="text-themed-mute animate-pulse">Thinking...</span></div>
      <div class="flex gap-2 mt-1">
        <button class="copy-ai text-[10px] font-mono text-themed-mute hover:text-themed-ink">copy</button>
        <button class="tts-ai text-[10px] font-mono text-themed-mute hover:text-themed-ink">🔊 speak</button>
        <button class="regen-ai text-[10px] font-mono text-themed-mute hover:text-themed-ink">↻ regen</button>
      </div>
    </div>`;
  list.appendChild(aiEl);
  scrollToBottom(list);

  const mdBox = aiEl.querySelector('.markdown-body');
  document.getElementById('topbar-title').textContent = text.substring(0,30);
  abortCtrl = new AbortController();
  document.getElementById('stop-btn').classList.remove('hidden');

  let weatherContext = '';
  const city = extractCityForWeather(text);
  if (city) {
    toast(`Fetching real-time weather for ${city}...`, 'info');
    const weatherData = await fetchRealTimeWeather(city);
    if (weatherData) {
      weatherContext = `\n\n[Real-Time Background Knowledge: ${weatherData}]`;
    }
  }

  let res;
  try {
    res = await fetchWithFailover(async (config) => {
      return await fetchChatCompletion(config, {
        stream: true,
        temperature: getTemp(),
        max_tokens: getMaxTokens(),
        messages: [{ role:'system', content: getSystemPrompt(text) + weatherContext }, ...conv.msgs]
      }, abortCtrl.signal);
    }, 'chat');
  } catch (e) {
    mdBox.innerHTML = `<span class="text-error text-sm">${esc(e.message)}</span>`;
    document.getElementById('stop-btn').classList.add('hidden');
    return;
  }

  try {
    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let full = '', buf = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      const chunkText = dec.decode(value, { stream: true });
      buf += chunkText;

      const lines = buf.split('\n');
      buf = lines.pop() || '';

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed || trimmed === 'data: [DONE]') continue;

        if (trimmed.startsWith('data: ')) {
          try {
            const d = JSON.parse(trimmed.slice(6));
            const c = d.choices?.[0]?.delta?.content || d.choices?.[0]?.message?.content;
            if (c) { full += c; mdBox.innerHTML = marked.parse(full); }
          } catch(e) {}
        } else {
          try {
            const d = JSON.parse(trimmed);
            const c = d.choices?.[0]?.delta?.content || d.choices?.[0]?.message?.content;
            if (c) { full += c; mdBox.innerHTML = marked.parse(full); }
            else if (typeof d.content === 'string') { full += d.content; mdBox.innerHTML = marked.parse(full); }
          } catch(e) {
            full += trimmed + ' ';
            mdBox.innerHTML = marked.parse(full);
          }
        }
      }
      scrollToBottom(list);
    }

    if (!full.trim() && buf.trim()) {
      try {
        const d = JSON.parse(buf.trim());
        full = d.choices?.[0]?.message?.content || d.choices?.[0]?.delta?.content || buf.trim();
      } catch(e) {
        full = buf.trim();
      }
      mdBox.innerHTML = marked.parse(full);
    }

    if (!full.trim()) {
      full = "BETAAI response ready. Please try asking again.";
      mdBox.innerHTML = marked.parse(full);
    }

    conv.msgs.push({ role: 'assistant', content: full });
    conv.title = conv.msgs[0].content.substring(0,50);
    saveConvs(); renderHistory();

    // Highlight code blocks
    mdBox.querySelectorAll('pre code').forEach(block => hljs.highlightElement(block));
    addCopyToCodeBlocks(mdBox);

    // Auto-open VibeCoding canvas if code block is generated or isVibeChat mode is active
    const codeMatch = full.match(/```(?:html|jsx|javascript|js)?\n([\s\S]*?)```/);
    if (codeMatch && codeMatch[1]) {
      const codeText = codeMatch[1].trim();
      if (isVibeChat || codeText.includes('<html') || codeText.includes('<!DOCTYPE html') || codeText.includes('<div') || codeText.includes('function')) {
        openVibeDrawer(codeText);
      }
    }

  } catch(e) {
    if (e.name !== 'AbortError') mdBox.innerHTML = `<span class="text-error">Error: ${esc(e.message)}</span>`;
  }
  document.getElementById('stop-btn').classList.add('hidden');

  // Action buttons
  const fullText = conv.msgs[conv.msgs.length-1]?.content || '';
  aiEl.querySelector('.copy-ai').onclick = () => { navigator.clipboard.writeText(fullText); toast('Copied!','success'); };
  aiEl.querySelector('.tts-ai').onclick = () => speakText(fullText);
  aiEl.querySelector('.regen-ai').onclick = () => {
    conv.msgs.pop(); // remove last assistant
    list.removeChild(aiEl);
    sendChat2(conv, list, conv.msgs[conv.msgs.length-1]?.content || text);
  };
}

async function sendChat2(conv, list, text) {
  const aiEl = document.createElement('div');
  aiEl.className = 'flex gap-3 animate-fade-up';
  aiEl.innerHTML = `<div class="w-7 h-7 rounded-lg mesh-gradient flex items-center justify-center text-white text-[11px] font-semibold shrink-0 mt-0.5 shadow-level-2">β</div><div class="flex-1 min-w-0"><div class="surface-card border border-themed rounded-lg rounded-tl-none p-4 shadow-level-2 text-sm markdown-body"><span class="text-themed-mute animate-pulse">Regenerating...</span></div><div class="flex gap-2 mt-1"><button class="copy-ai text-[10px] font-mono text-themed-mute hover:text-themed-ink">copy</button><button class="tts-ai text-[10px] font-mono text-themed-mute hover:text-themed-ink">🔊 speak</button></div></div>`;
  list.appendChild(aiEl);
  const mdBox = aiEl.querySelector('.markdown-body');

  try {
    const res = await fetchWithFailover(async (config) => {
      return await fetchChatCompletion(config, {
        stream: true,
        temperature: getTemp() + 0.1,
        max_tokens: getMaxTokens(),
        messages: [{ role: 'system', content: getSystemPrompt() }, ...conv.msgs]
      });
    }, 'chat');

    const reader = res.body.getReader(); const dec = new TextDecoder(); let full='',buf='';
    while(true) { const{done,value}=await reader.read(); if(done)break; buf+=dec.decode(value,{stream:true}); const lines=buf.split('\n'); buf=lines.pop(); for(const line of lines){if(!line.startsWith('data: ')||line==='data: [DONE]')continue; try{const d=JSON.parse(line.slice(6));const c=d.choices?.[0]?.delta?.content;if(c){full+=c;mdBox.innerHTML=marked.parse(full);}}catch(e){}} scrollToBottom(list); }
    conv.msgs.push({role:'assistant',content:full}); saveConvs();
    mdBox.querySelectorAll('pre code').forEach(block => hljs.highlightElement(block));
    addCopyToCodeBlocks(mdBox);
    aiEl.querySelector('.copy-ai').onclick = () => { navigator.clipboard.writeText(full); toast('Copied!','success'); };
    aiEl.querySelector('.tts-ai').onclick = () => speakText(full);
  } catch(e) { mdBox.innerHTML = `<span class="text-error">${esc(e.message)}</span>`; }
}

document.getElementById('stop-btn').onclick = () => { if(abortCtrl) abortCtrl.abort(); };

function scrollToBottom(el) { el.scrollTop = el.scrollHeight; }

function addCopyToCodeBlocks(container) {
  container.querySelectorAll('pre').forEach(pre => {
    if (pre.querySelector('.code-actions-group')) return;
    pre.style.position = 'relative';
    const codeText = pre.querySelector('code')?.textContent || pre.textContent;

    const btnGroup = document.createElement('div');
    btnGroup.className = 'code-actions-group absolute top-2 right-2 flex items-center gap-1.5 z-10';

    const copyBtn = document.createElement('button');
    copyBtn.className = 'copy-code-btn px-2 py-0.5 rounded text-[10px] font-mono text-white/70 hover:text-white bg-white/10 hover:bg-white/20 transition';
    copyBtn.textContent = 'copy';
    copyBtn.onclick = () => { navigator.clipboard.writeText(codeText); copyBtn.textContent = '✓'; setTimeout(()=>copyBtn.textContent='copy',1500); };
    btnGroup.appendChild(copyBtn);

    const isWebCode = codeText.includes('<html') || codeText.includes('<!DOCTYPE html') || codeText.includes('<div') || codeText.includes('class=') || codeText.includes('function');

    if (isWebCode) {
      // Direct Run Live Preview inside Chat
      const runBtn = document.createElement('button');
      runBtn.className = 'px-2 py-0.5 rounded text-[10px] font-mono text-white bg-cyan hover:opacity-90 transition flex items-center gap-1 shadow-level-2';
      runBtn.innerHTML = '▶ Run Live Preview';
      runBtn.onclick = () => {
        let frameWrapper = pre.parentNode.querySelector('.chat-inline-preview');
        if (frameWrapper) {
          frameWrapper.remove();
          return;
        }
        frameWrapper = document.createElement('div');
        frameWrapper.className = 'chat-inline-preview mt-2 border border-themed rounded-lg overflow-hidden surface-card shadow-level-3 animate-fade-up';
        frameWrapper.innerHTML = `
          <div class="px-3 py-1.5 surface-card2 border-b border-themed flex items-center justify-between">
            <span class="text-[11px] font-mono text-cyan flex items-center gap-1">⚡ Live VibeCoding Sandbox</span>
            <div class="flex items-center gap-2">
              <button class="fullscreen-preview-btn text-[10px] font-mono text-link hover:underline">↗ Popout</button>
              <button class="close-preview-btn text-[10px] font-mono text-themed-mute hover:text-error">✕ Close</button>
            </div>
          </div>
          <iframe class="w-full border-0 rounded-b-lg" style="height:360px"></iframe>`;
        
        pre.parentNode.insertBefore(frameWrapper, pre.nextSibling);
        
        const iframe = frameWrapper.querySelector('iframe');
        try {
          const doc = iframe.contentWindow.document || iframe.contentDocument;
          doc.open();
          doc.write(codeText);
          doc.close();
        } catch(e) {}

        frameWrapper.querySelector('.fullscreen-preview-btn').onclick = () => {
          const w = window.open(); w.document.write(codeText); w.document.close();
        };
        frameWrapper.querySelector('.close-preview-btn').onclick = () => frameWrapper.remove();
      };
      btnGroup.appendChild(runBtn);

      const launchBtn = document.createElement('button');
      launchBtn.className = 'px-2 py-0.5 rounded text-[10px] font-mono text-cyan bg-cyan/10 hover:bg-cyan/20 transition flex items-center gap-1';
      launchBtn.innerHTML = '⚡ Edit in VibeCoding';
      launchBtn.onclick = () => {
        document.getElementById('code-prompt').value = codeText;
        document.querySelectorAll('.mode-btn')[2].click();
        document.getElementById('generate-code-btn').click();
      };
      btnGroup.appendChild(launchBtn);
    }
    pre.appendChild(btnGroup);
  });
}

/* ═══════════════════════════════════════════════════
   Voice Input (Web Speech API)
   ═══════════════════════════════════════════════════ */
let recognition = null;
document.getElementById('voice-btn').onclick = () => {
  if (!('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) return toast('Speech not supported in this browser','error');
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (recognition) { recognition.stop(); recognition = null; return; }

  recognition = new SR();
  recognition.continuous = true; recognition.interimResults = true; recognition.lang = 'en-US';
  document.getElementById('voice-indicator').classList.remove('hidden');
  document.getElementById('voice-btn').style.borderColor = '#ee0000';

  recognition.onresult = e => {
    let transcript = '';
    for (let i = e.resultIndex; i < e.results.length; i++) transcript += e.results[i][0].transcript;
    document.getElementById('chat-input').value = transcript;
  };
  recognition.onerror = recognition.onend = () => {
    document.getElementById('voice-indicator').classList.add('hidden');
    document.getElementById('voice-btn').style.borderColor = '';
    recognition = null;
  };
  recognition.start();
  toast('🎤 Listening...');
};

/* ═══════════════════════════════════════════════════
   Text-to-Speech
   ═══════════════════════════════════════════════════ */
function speakText(text) {
  if ('speechSynthesis' in window) {
    window.speechSynthesis.cancel();
    const clean = text.replace(/```[\s\S]*?```/g,'code block').replace(/[#*_`~>|]/g,'').substring(0,3000);
    const utt = new SpeechSynthesisUtterance(clean);
    utt.rate = 1; utt.pitch = 1;
    window.speechSynthesis.speak(utt);
    toast('🔊 Speaking...');
  }
}

/* ═══════════════════════════════════════════════════
   Conversation Management
   ═══════════════════════════════════════════════════ */
function saveConvs() {
  localStorage.setItem('betaai_convs', JSON.stringify(conversations));
  syncToCloud();
}

function renderHistory() {
  const el = document.getElementById('history-list'); el.innerHTML = '';
  const query = document.getElementById('search-history').value.toLowerCase();
  const filtered = query ? conversations.filter(c => c.title?.toLowerCase().includes(query)) : conversations;

  filtered.forEach(c => {
    const item = document.createElement('div');
    item.className = 'group flex items-center gap-1';
    item.innerHTML = `
      <button class="flex-1 text-left px-2 py-1 rounded-sm text-[13px] truncate hover-card2 transition ${c.id===currentConvId?'surface-card2 font-medium text-themed-ink':'text-themed-body'}">${esc(c.title||'New chat')}</button>
      <button class="del-btn opacity-0 group-hover:opacity-100 w-5 h-5 rounded-sm text-themed-mute hover:text-error text-[10px] flex items-center justify-center transition">✕</button>`;
    item.querySelector('button').onclick = () => { currentConvId = c.id; loadConv(c); document.querySelectorAll('.mode-btn')[0].click(); };
    item.querySelector('.del-btn').onclick = (e) => { e.stopPropagation(); conversations = conversations.filter(x=>x.id!==c.id); if(currentConvId===c.id) newChat(); saveConvs(); renderHistory(); };
    el.appendChild(item);
  });
}

document.getElementById('search-history').oninput = renderHistory;

function loadConv(c) {
  const list = document.getElementById('messages-list'); list.innerHTML = '';
  document.getElementById('chat-welcome').classList.add('hidden');
  document.getElementById('chat-messages').classList.remove('hidden');
  document.getElementById('topbar-title').textContent = c.title;
  c.msgs.forEach(m => {
    const d = document.createElement('div');
    if (m.role === 'user') {
      d.className = 'flex justify-end';
      d.innerHTML = `<div class="max-w-[80%] btn-ink rounded-lg rounded-br-none p-4 text-sm">${esc(m.content)}</div>`;
    } else {
      d.className = 'flex gap-3';
      d.innerHTML = `<div class="w-7 h-7 rounded-lg mesh-gradient flex items-center justify-center text-white text-[11px] font-semibold shrink-0 mt-0.5 shadow-level-2">β</div><div class="flex-1 min-w-0"><div class="surface-card border border-themed rounded-lg rounded-tl-none p-4 shadow-level-2 text-sm markdown-body">${marked.parse(m.content)}</div></div>`;
      setTimeout(() => { d.querySelectorAll('pre code').forEach(block => hljs.highlightElement(block)); addCopyToCodeBlocks(d); }, 10);
    }
    list.appendChild(d);
  });
  scrollToBottom(list);
}

/* ═══════════════════════════════════════════════════
   Export Conversations
   ═══════════════════════════════════════════════════ */
document.getElementById('export-btn').onclick = () => {
  const conv = conversations.find(c => c.id === currentConvId);
  if (!conv) return toast('No conversation to export','error');
  let md = '# ' + conv.title + '\n\n';
  conv.msgs.forEach(m => { md += (m.role === 'user' ? '**You**: ' : '**BETAAI**: ') + m.content + '\n\n---\n\n'; });
  md += '_Exported from BETAAI by SAURABH_\n';
  const blob = new Blob([md], {type:'text/markdown'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = (conv.title||'chat').replace(/[^a-z0-9]/gi,'_') + '.md'; a.click();
  toast('Exported as Markdown','success');
};

async function fetchRealAiImage(promptText, seed, w, h) {
  const encPrompt = encodeURIComponent(promptText);
  try {
    const res = await fetch(`https://lexica.art/api/v1/search?q=${encPrompt}`);
    if (res.ok) {
      const data = await res.json();
      if (data.images && data.images.length > 0) {
        const idx = Math.abs(seed) % Math.min(data.images.length, 12);
        const imgUrl = data.images[idx]?.src || data.images[0]?.src;
        if (imgUrl) return imgUrl;
      }
    }
  } catch (e) {
    console.warn('[Lexica fetch] failed:', e);
  }
  return `https://pollinations.ai/p/${encPrompt}?width=${w}&height=${h}&seed=${seed}&nologo=true`;
}

