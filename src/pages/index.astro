async function performLiveWebSearch(query) {
  let resultsText = '';
  try {
    const ddgUrl = `https://api.duckduckgo.com/?q=${encodeURIComponent(query)}&format=json&no_html=1&skip_disambig=1`;
    const ddgRes = await fetch(ddgUrl);
    if (ddgRes.ok) {
      const ddgData = await ddgRes.json();
      if (ddgData.AbstractText) {
        resultsText += `[Live Search Result]\nHeading: ${ddgData.Heading}\nSummary: ${ddgData.AbstractText}\nURL: ${ddgData.AbstractURL}\n\n`;
      }
      if (ddgData.RelatedTopics && ddgData.RelatedTopics.length > 0) {
        resultsText += `[Search References]\n`;
        ddgData.RelatedTopics.slice(0, 4).forEach(t => {
          if (t.Text && t.FirstURL) resultsText += `- ${t.Text} (URL: ${t.FirstURL})\n`;
        });
      }
    }
  } catch(e) {}

  try {
    const wikiUrl = `https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(query)}`;
    const wikiRes = await fetch(wikiUrl);
    if (wikiRes.ok) {
      const wikiData = await wikiRes.json();
      if (wikiData.extract) {
        resultsText += `\n[Wikipedia Knowledge]\nTitle: ${wikiData.title}\nExtract: ${wikiData.extract}\nURL: ${wikiData.content_urls?.desktop?.page || ''}\n`;
      }
    }
  } catch(e) {}

  return resultsText;
}

async function webSearch() {
  const query = document.getElementById('search-query').value.trim(); if(!query) return;
  const box = document.getElementById('search-results');
  const card = document.createElement('div');
  card.className = 'surface-card rounded-lg border border-themed shadow-level-3 p-6 animate-fade-up';
  card.innerHTML = '<span class="text-sm text-themed-mute animate-pulse">Searching real-time web...</span>';
  box.prepend(card);

  try {
    const liveSearchData = await performLiveWebSearch(query);
    const systemPrompt = `You are a real-time web search assistant by SAURABH. Use the following real-time web search results to answer the query accurately. Include citations and markdown links where applicable.\n\n${liveSearchData}`;

    const res = await fetchWithFailover(async (config) => {
      return await fetchChatCompletion(config, {
        messages: [
          { role: 'system', content: systemPrompt },
          { role: 'user', content: 'Search Query: ' + query }
        ]
      });
    });
    const data = await res.json();
    const reply = data.choices?.[0]?.message?.content || 'No search results found.';
    card.innerHTML = `<div class="flex items-center gap-2 mb-3 pb-3 border-b border-themed"><svg class="w-4 h-4 text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg><span class="text-xs font-mono text-themed-ink font-semibold">${esc(query)}</span><span class="ml-auto text-[10px] font-mono text-cyan">Live Results</span></div><div class="markdown-body text-sm text-themed-ink">${marked.parse(reply)}</div>`;
    card.querySelectorAll('pre code').forEach(block => hljs.highlightElement(block));
  } catch(e) { card.innerHTML = `<span class="text-error text-sm">Search Error: ${esc(e.message)}</span>`; }
}

/* ═══════════════════════════════════════════════════
   VibeCoding Split Canvas Drawer Engine
   ═══════════════════════════════════════════════════ */
function openVibeDrawer(code) {
  const drawer = document.getElementById('chat-vibe-drawer');
  const editor = document.getElementById('drawer-code-editor');
  const iframe = document.getElementById('drawer-preview-frame');
  if (!drawer || !editor || !iframe) return;

  editor.value = code;
  drawer.classList.remove('hidden');

  setTimeout(() => {
    try {
      const doc = iframe.contentWindow.document || iframe.contentDocument;
      doc.open();
      doc.write(code);
      doc.close();
    } catch(e) {
      console.error('Drawer preview error:', e);
    }
  }, 30);
}

document.getElementById('drawer-close')?.addEventListener('click', () => {
  document.getElementById('chat-vibe-drawer')?.classList.add('hidden');
});

document.getElementById('drawer-tab-preview')?.addEventListener('click', () => {
  document.getElementById('drawer-panel-preview')?.classList.remove('hidden');
  document.getElementById('drawer-panel-code')?.classList.add('hidden');
  document.getElementById('drawer-tab-preview')?.classList.add('btn-ink');
  document.getElementById('drawer-tab-preview')?.classList.remove('text-themed-body');
  document.getElementById('drawer-tab-code')?.classList.remove('btn-ink');
  document.getElementById('drawer-tab-code')?.classList.add('text-themed-body');
});

document.getElementById('drawer-tab-code')?.addEventListener('click', () => {
  document.getElementById('drawer-panel-preview')?.classList.add('hidden');
  document.getElementById('drawer-panel-code')?.classList.remove('hidden');
  document.getElementById('drawer-tab-code')?.classList.add('btn-ink');
  document.getElementById('drawer-tab-code')?.classList.remove('text-themed-body');
  document.getElementById('drawer-tab-preview')?.classList.remove('btn-ink');
  document.getElementById('drawer-tab-preview')?.classList.add('text-themed-body');
});

document.getElementById('drawer-popout')?.addEventListener('click', () => {
  const code = document.getElementById('drawer-code-editor')?.value || '';
  const w = window.open();
  w.document.write(code);
  w.document.close();
});

document.getElementById('drawer-refine-btn')?.addEventListener('click', () => {
  const input = document.getElementById('drawer-refine-input');
  const query = input?.value.trim();
  if (!query) return;
  input.value = '';
  document.getElementById('chat-input').value = `Refine VibeCoding Canvas app: ${query}`;
  sendChat();
});

document.getElementById('byok-btn')?.addEventListener('click', () => {
  document.getElementById('settings-modal').classList.remove('hidden');
});

const vibeChatBtn = document.getElementById('vibe-chat-toggle');
if (vibeChatBtn) {
  vibeChatBtn.onclick = () => {
    isVibeChat = !isVibeChat;
    if (isVibeChat) {
      vibeChatBtn.classList.add('bg-cyan/20', 'text-cyan', 'border-cyan');
      toast('⚡ VibeCoding mode active in Chat!', 'success');
      const sampleCode = `<!DOCTYPE html>\n<html>\n<head>\n<script src="https://cdn.tailwindcss.com"><\/script>\n</head>\n<body class="bg-slate-900 text-white min-h-screen flex items-center justify-center p-6">\n<div class="max-w-md w-full bg-slate-800/80 backdrop-blur border border-slate-700 p-8 rounded-2xl shadow-2xl text-center">\n<h1 class="text-2xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent mb-2">BETAAI VibeCoding Canvas</h1>\n<p class="text-slate-400 text-sm mb-6">Ask anything in chat to render full responsive web apps live on this split canvas.</p>\n<button onclick="alert('⚡ VibeCoding Canvas Ready!')" class="px-6 py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-full text-sm font-medium hover:opacity-90 transition">Test Interactive App</button>\n</div>\n</body>\n</html>`;
      openVibeDrawer(sampleCode);
    } else {
      vibeChatBtn.classList.remove('bg-cyan/20', 'text-cyan', 'border-cyan');
      document.getElementById('chat-vibe-drawer')?.classList.add('hidden');
      toast('Chat mode reset to standard assistant', 'info');
    }
  };
}

// Discover Chips and Live Cards
document.querySelectorAll('.discover-chip').forEach(btn => {
  btn.onclick = () => {
    document.getElementById('search-query').value = btn.dataset.query;
    webSearch();
  };
});
document.querySelectorAll('.discover-card').forEach(card => {
  card.onclick = () => {
    document.getElementById('search-query').value = card.dataset.query;
    webSearch();
  };
});

document.getElementById('settings-btn').onclick = () => document.getElementById('settings-modal').classList.remove('hidden');
document.getElementById('close-settings').onclick = () => document.getElementById('settings-modal').classList.add('hidden');
document.getElementById('settings-modal').onclick = e => { if(e.target===e.currentTarget) e.currentTarget.classList.add('hidden'); };
document.getElementById('s-temperature').oninput = function() { document.getElementById('temp-val').textContent = this.value; };

document.getElementById('save-settings').onclick = () => {
  const customKey = document.getElementById('custom-api-key')?.value?.trim() || '';
  const customBase = document.getElementById('custom-api-base')?.value?.trim() || '';
  const customModel = document.getElementById('custom-api-model')?.value?.trim() || '';

  if (customKey) {
    localStorage.setItem('betaai_custom_key', customKey);
    localStorage.setItem('GEMINI_API_KEY', customKey);
  } else {
    localStorage.removeItem('betaai_custom_key');
  }

  if (customBase) localStorage.setItem('betaai_custom_base', customBase);
  else localStorage.removeItem('betaai_custom_base');

  if (customModel) localStorage.setItem('betaai_custom_model', customModel);
  else localStorage.removeItem('betaai_custom_model');

  localStorage.setItem('betaai_settings', JSON.stringify({
    githubToken: document.getElementById('s-github-token')?.value || '',
    systemPrompt: document.getElementById('s-system-prompt')?.value || '',
    temperature: document.getElementById('s-temperature')?.value || '0.7',
    maxTokens: document.getElementById('s-max-tokens')?.value || '4096',
    model: getModel()
  }));
  toast('Settings saved successfully!','success');
  document.getElementById('settings-modal').classList.add('hidden');
};

// Load saved settings
(function() {
  const k = localStorage.getItem('betaai_custom_key') || localStorage.getItem('GEMINI_API_KEY');
  const b = localStorage.getItem('betaai_custom_base');
  const m = localStorage.getItem('betaai_custom_model');
  if (k && document.getElementById('custom-api-key')) document.getElementById('custom-api-key').value = k;
  if (b && document.getElementById('custom-api-base')) document.getElementById('custom-api-base').value = b;
  if (m && document.getElementById('custom-api-model')) document.getElementById('custom-api-model').value = m;

  const s = JSON.parse(localStorage.getItem('betaai_settings') || '{}');
  if (s.githubToken && document.getElementById('s-github-token')) document.getElementById('s-github-token').value = s.githubToken;
  if (s.systemPrompt && document.getElementById('s-system-prompt')) document.getElementById('s-system-prompt').value = s.systemPrompt;
  if (s.temperature && document.getElementById('s-temperature')) { document.getElementById('s-temperature').value = s.temperature; document.getElementById('temp-val').textContent = s.temperature; }
  if (s.maxTokens && document.getElementById('s-max-tokens')) document.getElementById('s-max-tokens').value = s.maxTokens;
  if (s.model && document.getElementById('model-select')) document.getElementById('model-select').value = s.model;
})();

document.getElementById('clear-all-data').onclick = () => {
  if (confirm('Clear all conversations, BYOK keys, and settings? This cannot be undone.')) {
    conversations = [];
    localStorage.removeItem('betaai_convs');
    localStorage.removeItem('betaai_settings');
    localStorage.removeItem('betaai_byok');
    newChat(); renderHistory(); toast('All data & keys cleared');
  }
};

document.getElementById('model-select').onchange = function() {
  document.getElementById('model-pill-text').textContent = this.value.split('/').pop();
};

/* ═══════════════════════════════════════════════════
   Keyboard Shortcuts
   ═══════════════════════════════════════════════════ */
document.addEventListener('keydown', e => {
  if (e.ctrlKey && e.key === 'k') { e.preventDefault(); newChat(); }
  if (e.key === 'Escape') {
    document.getElementById('settings-modal').classList.add('hidden');
    document.getElementById('lightbox').classList.add('hidden');
    if (recognition) { recognition.stop(); recognition = null; }
  }
});

/* ═══════════════════════════════════════════════════
   Init model pill & Load Background Knowledge
   ═══════════════════════════════════════════════════ */
document.getElementById('model-pill-text').textContent = getModel().split('/').pop();

fetch('/repo-knowledge.json')
  .then(r => r.json())
  .then(data => {
    repoKnowledge = data;
    console.log('[Knowledge Base] Repository documentation loaded successfully');
  })
  .catch(e => console.error('[Knowledge Base] Failed to load documentation:', e));
</script>
</body>
</html>
