function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function toast(msg, type='info') {
  const el = document.createElement('div');
  const colors = { info:'border-link', error:'border-error', success:'border-cyan' };
  el.className = `p-3 rounded-md surface-card border-l-4 ${colors[type]||colors.info} shadow-level-4 text-xs font-medium animate-fade-up text-themed-ink border border-themed`;
  el.textContent = msg;
  document.getElementById('toast-box').appendChild(el);
  setTimeout(() => { el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(),300); }, 3500);
}
