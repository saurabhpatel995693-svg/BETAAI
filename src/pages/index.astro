    guestBtn.style.opacity = '';
  }

  document.getElementById('login-screen').classList.add('hidden');
  const shell = document.getElementById('app-shell');
  shell.classList.remove('hidden');
  shell.style.display = 'block';

  // Update sidebar user info
  document.getElementById('sidebar-user-name').textContent = currentUser.displayName || 'User';
  document.getElementById('sidebar-user-email').textContent = currentUser.email || 'guest';
  if (currentUser.photoURL) {
    document.getElementById('sidebar-avatar').src = currentUser.photoURL;
  }
  document.getElementById('s-user-info').textContent = isAdmin ? '★ ADMIN USER' : '○ Standard user';

  // Sync from cloud if authenticated
  if (currentUser.email && !currentUser.isGuest) {
    syncFromCloud();
  }

  renderHistory();
  toast('Welcome, ' + (currentUser.displayName || 'Guest'), 'success');
}

