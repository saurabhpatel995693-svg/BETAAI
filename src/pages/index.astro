/* ═══════════════════════════════════════════════════
   Real-Time Weather Lookup Helpers
   ═══════════════════════════════════════════════════ */
function extractCityForWeather(text) {
  const textLower = text.toLowerCase();
  if (!textLower.includes('weather') && !textLower.includes('temperature') && !textLower.includes('forecast')) {
    return null;
  }
  const patterns = [
    /weather\s+(?:in|at|for)?\s*([a-zA-Z\s]{3,30})/i,
    /temperature\s+(?:in|at|for)?\s*([a-zA-Z\s]{3,30})/i,
    /forecast\s+(?:in|at|for)?\s*([a-zA-Z\s]{3,30})/i,
    /([a-zA-Z\s]{3,30})\s+weather/i,
    /([a-zA-Z\s]{3,30})\s+temperature/i
  ];
  for (const pattern of patterns) {
    const match = text.match(pattern);
    if (match && match[1]) {
      const city = match[1].trim().replace(/\b(?:how|is|the|what|whats|current|today|tomorrow|here|near|me)\b/gi, '').trim();
      if (city.length > 2) return city;
    }
  }
  return null;
}

async function fetchRealTimeWeather(city) {
  try {
    const res = await fetch(`https://wttr.in/${encodeURIComponent(city)}?format=j1`);
    if (!res.ok) throw new Error('Weather API returned error status');
    const data = await res.json();
    const current = data.current_condition?.[0];
    const temp = current?.temp_C || current?.temp_F;
    const desc = current?.lang_en?.[0]?.value || current?.weatherDesc?.[0]?.value;
    const humidity = current?.humidity;
    const wind = current?.windspeedKmph;
    return `Location: ${city}, Conditions: ${desc}, Temp: ${temp}°C, Humidity: ${humidity}%, Wind: ${wind} km/h (Source: wttr.in real-time)`;
  } catch (e) {
    console.warn('[Weather] JSON fetch failed, trying text fallback:', e.message);
    try {
      const resText = await fetch(`https://wttr.in/${encodeURIComponent(city)}?format=3`);
      if (resText.ok) {
        const text = await resText.text();
        return text.trim();
      }
    } catch (err) {
      console.error('[Weather] Text fallback failed:', err);
    }
    return null;
  }
}

