      quiz: 'Based on the following content, create a quiz with 8 multiple-choice questions. Format each question with A/B/C/D options. At the end, provide an ANSWER KEY. Make questions progressively harder.\n\nContent:\n' + combinedText,
      flashcard: 'Based on the following content, create 10 flashcards. Output as a JSON array: [{"front":"question","back":"answer"}]. ONLY output valid JSON, no other text.\n\nContent:\n' + combinedText,
      summary: 'Create a comprehensive, well-structured summary of the following content. Use markdown with headers (##), bullet points, and bold for key terms. Include a TL;DR at the top.\n\nContent:\n' + combinedText,
      mindmap: 'Extract the key concepts and relationships from the following content. Create a hierarchical outline with main topics, subtopics, and connections. Use markdown headers and nested lists.\n\nContent:\n' + combinedText,
      timeline: 'Create a chronological timeline of events, milestones, or steps from the following content. Format as a numbered list with dates/stages and descriptions.\n\nContent:\n' + combinedText,
      practice: 'Create a practice test based on the following content with 10 questions: mix of multiple-choice, true/false, and short-answer questions. Include an answer key at the end.\n\nContent:\n' + combinedText,
      explain: 'Explain the following content as if I am 5 years old. Use simple analogies, everyday examples, and fun language. Make it engaging and easy to understand.\n\nContent:\n' + combinedText,
    };

    try {
      const res = await fetchWithFailover(async (config) => {
        return await fetchChatCompletion(config, {
          temperature: 0.5,
          messages: [{role:'user',content:prompts[action]}]
        });
      });
      const data = await res.json();
      const reply = data.choices?.[0]?.message?.content || 'No output';

      if (action === 'flashcard') {
        try {
          const jsonMatch = reply.match(/\[[\s\S]*\]/);
          const cards = JSON.parse(jsonMatch ? jsonMatch[0] : reply);
          let html = '<h4 class="text-display-sm text-themed-ink mb-4">🃏 Flashcards</h4><p class="text-[11px] font-mono text-themed-mute mb-3">Click a card to flip it</p><div class="grid sm:grid-cols-2 gap-3">';
          cards.forEach(fc => {
            html += `<div class="flashcard h-40 rounded-md border border-themed shadow-level-2" onclick="this.classList.toggle('flipped')"><div class="flashcard-inner relative w-full h-full"><div class="flashcard-front surface-card text-center text-sm font-medium text-themed-ink">${esc(fc.front)}</div><div class="flashcard-back text-center text-sm" style="background:#171717;color:#fff">${esc(fc.back)}</div></div></div>`;
          });
          html += '</div>';
          card.innerHTML = html;
        } catch(e) { card.innerHTML = '<div class="markdown-body text-sm text-themed-ink">' + marked.parse(reply) + '</div>'; }
      } else {
        card.innerHTML = '<div class="markdown-body text-sm text-themed-ink">' + marked.parse(reply) + '</div>';
        card.querySelectorAll('pre code').forEach(block => hljs.highlightElement(block));
      }
    } catch(e) { card.innerHTML = `<span class="text-error text-sm">${esc(e.message)}</span>`; }
  };
});

/* ═══════════════════════════════════════════════════
   Web Search (AI-assisted)
   ═══════════════════════════════════════════════════ */
document.getElementById('search-go-btn').onclick = webSearch;
document.getElementById('search-query').onkeydown = e => { if(e.key==='Enter') webSearch(); };

async function webSearch() {
  const query = document.getElementById('search-query').value.trim(); if(!query) return;
  const box = document.getElementById('search-results');
  const card = document.createElement('div');
  card.className = 'surface-card rounded-lg border border-themed shadow-level-3 p-6 animate-fade-up';
  card.innerHTML = '<span class="text-sm text-themed-mute animate-pulse">Searching...</span>';
  box.prepend(card);

  try {
    const res = await fetchWithFailover(async (config) => {
      return await fetchChatCompletion(config, {
        messages: [
          {role:'system',content:'You are a web search assistant by SAURABH. The user is searching for information. Provide a comprehensive, well-formatted answer using markdown. Include relevant facts, explanations, and if applicable, cite sources. Format with headers, bullet points, and code blocks as needed.'},
          {role:'user',content:'Search query: ' + query}
        ]
      });
    });
    const data = await res.json();
    const reply = data.choices?.[0]?.message?.content || 'No results';
    card.innerHTML = `<div class="flex items-center gap-2 mb-3 pb-3 border-b border-themed"><svg class="w-4 h-4 text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg><span class="text-xs font-mono text-themed-mute">${esc(query)}</span></div><div class="markdown-body text-sm text-themed-ink">${marked.parse(reply)}</div>`;
    card.querySelectorAll('pre code').forEach(block => hljs.highlightElement(block));
  } catch(e) { card.innerHTML = `<span class="text-error text-sm">${esc(e.message)}</span>`; }
}

/* ═══════════════════════════════════════════════════
   Settings
   ═══════════════════════════════════════════════════ */
document.getElementById('settings-btn').onclick = () => document.getElementById('settings-modal').classList.remove('hidden');
document.getElementById('close-settings').onclick = () => document.getElementById('settings-modal').classList.add('hidden');
document.getElementById('settings-modal').onclick = e => { if(e.target===e.currentTarget) e.currentTarget.classList.add('hidden'); };
document.getElementById('s-temperature').oninput = function() { document.getElementById('temp-val').textContent = this.value; };

document.getElementById('save-settings').onclick = () => {
  localStorage.setItem('betaai_settings', JSON.stringify({
    apiKey: document.getElementById('s-api-key').value,
    apiBase: document.getElementById('s-api-base').value,
    githubToken: document.getElementById('s-github-token').value,
    systemPrompt: document.getElementById('s-system-prompt').value,
    temperature: document.getElementById('s-temperature').value,
    maxTokens: document.getElementById('s-max-tokens').value,
    model: getModel()
  }));
  localStorage.setItem('betaai_api_base', document.getElementById('s-api-base').value);
  toast('Settings saved','success');
  document.getElementById('settings-modal').classList.add('hidden');
};

// Load saved settings
(function() {
  const s = JSON.parse(localStorage.getItem('betaai_settings') || '{}');
  if (s.apiKey) document.getElementById('s-api-key').value = s.apiKey;
  if (s.apiBase) { document.getElementById('s-api-base').value = s.apiBase; localStorage.setItem('betaai_api_base', s.apiBase); }
  if (s.githubToken) document.getElementById('s-github-token').value = s.githubToken;
  if (s.systemPrompt) document.getElementById('s-system-prompt').value = s.systemPrompt;
  if (s.temperature) { document.getElementById('s-temperature').value = s.temperature; document.getElementById('temp-val').textContent = s.temperature; }
  if (s.maxTokens) document.getElementById('s-max-tokens').value = s.maxTokens;
  if (s.model) document.getElementById('model-select').value = s.model;
})();

document.getElementById('clear-all-data').onclick = () => {
  if (confirm('Clear all conversations and settings? This cannot be undone.')) {
    conversations = []; localStorage.removeItem('betaai_convs'); localStorage.removeItem('betaai_settings');
    newChat(); renderHistory(); toast('All data cleared');
  }
};

document.getElementById('model-select').onchange = function() {
  document.getElementById('model-pill-text').textContent = this.value.split('/').pop();
};

/* ═══════════════════════════════════════════════════
   Keyboard Shortcuts
   ═══════════════════════════════════════════════════ */
document.addEventListener('keydown', e => {
  if (e.ctrlKey && e.key === 'k') { e.preventDefault(); newChat(); }
  if (e.key === 'Escape') {
    document.getElementById('settings-modal').classList.add('hidden');
    document.getElementById('lightbox').classList.add('hidden');
    if (recognition) { recognition.stop(); recognition = null; }
  }
});

/* ═══════════════════════════════════════════════════
   Init model pill & Load Background Knowledge
   ═══════════════════════════════════════════════════ */
document.getElementById('model-pill-text').textContent = getModel().split('/').pop();

fetch('/repo-knowledge.json')
  .then(r => r.json())
  .then(data => {
    repoKnowledge = data;
    console.log('[Knowledge Base] Repository documentation loaded successfully');
  })
  .catch(e => console.error('[Knowledge Base] Failed to load documentation:', e));
</script>
</body>
</html>
