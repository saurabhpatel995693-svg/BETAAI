// Drag & drop for notebooks
const nbDrop = document.getElementById('nb-drop-zone');
nbDrop.ondragover = e => { e.preventDefault(); nbDrop.style.borderColor='#0070f3'; };
nbDrop.ondragleave = () => { nbDrop.style.borderColor=''; };
nbDrop.ondrop = e => {
  e.preventDefault(); nbDrop.style.borderColor='';
