---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ChatView from '../components/ChatView.astro';
import NotebookView from '../components/NotebookView.astro';
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>SHESHAAI — AI Workspace by SAURABH</title>
  <meta name="description" content="SHESHAAI by SAURABH — AI Chat, Image Generation, Coding, Notebooks."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Syne:wght@400..800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet"/>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>
</head>
<body class="min-h-screen flex flex-col surface-page text-themed-ink antialiased">
  <Header />

  <main class="flex-1 flex flex-col relative overflow-hidden">
    <ChatView />
    <NotebookView />
  </main>

  <script is:inline>
    // ── Ponytail State Engine ─────────────────────────────────────
    let chatHistory = [];
    let activeMode = 'chat'; // 'chat' or 'notebook'

    // DOM Elements
    const chatForm = document.getElementById('chat-form');
    const userInput = document.getElementById('user-input');
    const sendBtn = document.getElementById('send-btn');
    const msgContainer = document.getElementById('message-container');
    const welcomeBanner = document.getElementById('welcome-banner');
    const themeBtn = document.getElementById('theme-toggle-btn');
    const clearBtn = document.getElementById('clear-chat-btn');
    const navChatBtn = document.getElementById('nav-chat-btn');
    const navNotebookBtn = document.getElementById('nav-notebook-btn');
    const chatView = document.getElementById('chat-view');
    const notebookView = document.getElementById('notebook-view');

    // Theme Toggle
    themeBtn?.addEventListener('click', () => {
      const html = document.documentElement;
      const nextTheme = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', nextTheme);
      themeBtn.textContent = nextTheme === 'dark' ? '🌙' : '☀️';
    });

    // View Navigation
    navChatBtn?.addEventListener('click', () => switchView('chat'));
    navNotebookBtn?.addEventListener('click', () => switchView('notebook'));

    function switchView(mode) {
      activeMode = mode;
      if (mode === 'chat') {
        chatView?.classList.remove('hidden');
        notebookView?.classList.add('hidden');
        navChatBtn?.classList.add('bg-amber-500', 'text-slate-950', 'font-semibold');
        navChatBtn?.classList.remove('text-themed-mute');
        navNotebookBtn?.classList.remove('bg-amber-500', 'text-slate-950', 'font-semibold');
        navNotebookBtn?.classList.add('text-themed-mute');
      } else {
        chatView?.classList.add('hidden');
        notebookView?.classList.remove('hidden');
        navNotebookBtn?.classList.add('bg-amber-500', 'text-slate-950', 'font-semibold');
        navNotebookBtn?.classList.remove('text-themed-mute');
        navChatBtn?.classList.remove('bg-amber-500', 'text-slate-950', 'font-semibold');
        navChatBtn?.classList.add('text-themed-mute');
      }
    }

    // Auto-resize textarea
    userInput?.addEventListener('input', () => {
      userInput.style.height = 'auto';
      userInput.style.height = `${Math.min(userInput.scrollHeight, 144)}px`;
    });

    // Keyboard submit (Enter without Shift)
    userInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        chatForm?.dispatchEvent(new Event('submit'));
      }
    });

    // Quick Prompts
    document.querySelectorAll('.quick-prompt-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.querySelector('.text-themed-mute')?.textContent;
        if (text && userInput) {
          userInput.value = text;
          chatForm?.dispatchEvent(new Event('submit'));
        }
      });
    });

    // Clear Chat History
    clearBtn?.addEventListener('click', () => {
      chatHistory = [];
      if (msgContainer) {
        msgContainer.innerHTML = '';
        if (welcomeBanner) msgContainer.appendChild(welcomeBanner);
      }
    });

    // Send Message Handler
    chatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const prompt = userInput?.value.trim();
      if (!prompt) return;

      // Hide welcome banner on first prompt
      if (welcomeBanner && welcomeBanner.parentNode === msgContainer) {
        welcomeBanner.remove();
      }

      // Append User Message
      appendMessage('user', prompt);
      chatHistory.push({ role: 'user', content: prompt });
      userInput.value = '';
      userInput.style.height = 'auto';
      sendBtn.disabled = true;

      // Create Placeholder AI message
      const aiMsgEl = appendMessage('assistant', 'Thinking...');
      const contentEl = aiMsgEl.querySelector('.msg-content');

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: chatHistory })
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const data = await response.json();
        const reply = data.choices?.[0]?.message?.content || data.content || data.reply || 'No response generated.';

        chatHistory.push({ role: 'assistant', content: reply });
        if (contentEl) {
          contentEl.innerHTML = typeof marked !== 'undefined' ? marked.parse(reply) : reply;
        }
      } catch (err) {
        if (contentEl) {
          contentEl.innerHTML = `<span class="text-red-400">Error generating response. Please try again.</span>`;
        }
      } finally {
        sendBtn.disabled = false;
        msgContainer?.scrollTo({ top: msgContainer.scrollHeight, behavior: 'smooth' });
      }
    });

    // Helper: Append Message to Feed
    function appendMessage(role, content) {
      const isUser = role === 'user';
      const msgDiv = document.createElement('div');
      msgDiv.className = `flex gap-3 ${isUser ? 'justify-end' : 'justify-start'} animate-slide-in`;

      const bubble = document.createElement('div');
      bubble.className = `max-w-[85%] rounded-2xl p-4 text-xs md:text-sm ${
        isUser
          ? 'bg-amber-500 text-slate-950 font-medium rounded-tr-xs shadow-md'
          : 'bg-themed-card border border-themed text-themed-ink rounded-tl-xs markdown-body shadow-sm'
      }`;

      const contentDiv = document.createElement('div');
      contentDiv.className = 'msg-content';
      contentDiv.innerHTML = isUser ? escapeHtml(content) : (typeof marked !== 'undefined' ? marked.parse(content) : content);

      bubble.appendChild(contentDiv);
      msgDiv.appendChild(bubble);
      msgContainer?.appendChild(msgDiv);
      msgContainer?.scrollTo({ top: msgContainer.scrollHeight, behavior: 'smooth' });

      return msgDiv;
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
  </script>
</body>
</html>
