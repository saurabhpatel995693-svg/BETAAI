---
import Layout from '../layouts/Layout.astro';
---

<Layout title="OmniRoute — The Free AI Gateway & Universal LLM Proxy" wide={true} noSidebars={true}>
  <!-- Hero Section with Mesh Gradient backdrop -->
  <section class="relative pt-20 pb-16 overflow-hidden flex flex-col items-center text-center">
    <!-- Mesh Gradient Overlay specific to Hero -->
    <div class="absolute inset-0 w-full h-[400px] pointer-events-none z-0 opacity-20">
      <div class="mesh-gradient-bg w-full h-full"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center gap-6 px-4">
      <!-- Release Version Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-canvas-soft border border-hairline rounded-full shadow-level-2 transition-all hover:border-hairline-strong duration-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-caption-mono text-mute font-semibold">Release v3.8.45 Active</span>
      </div>

      <!-- Headline -->
      <h1 class="text-display-xl md:text-[56px] leading-[1.05] font-semibold text-ink tracking-[-2.4px] max-w-3xl">
        Connect every AI tool to 237 providers.
      </h1>

      <!-- Description -->
      <p class="text-body-lg text-body max-w-2xl leading-relaxed">
        One endpoint. 17 routing strategies. Auto-fallback across 90+ free models. 
        Stack RTK + Caveman compression to shrink prompts by up to 95% and never hit rate limits.
      </p>

      <!-- CTA Buttons -->
      <div class="flex items-center gap-4 mt-4">
        <a 
          href="#compression-studio" 
          class="h-12 px-8 bg-primary text-on-primary rounded-pill text-[15px] font-semibold hover:bg-black transition-all duration-200 shadow-level-4 flex items-center justify-center cursor-pointer"
        >
          Try Simulator
        </a>
        <a 
          href="#cli-setup" 
          class="h-12 px-8 bg-canvas text-ink border border-hairline rounded-pill text-[15px] font-semibold hover:border-hairline-strong hover:bg-canvas-soft-2 transition-all duration-200 shadow-level-2 flex items-center justify-center cursor-pointer"
        >
          CLI Setup
        </a>
      </div>
    </div>
  </section>

  <!-- Key Metrics Strip -->
  <section class="max-w-[1200px] mx-auto px-4 py-8 border-y border-hairline">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="flex flex-col gap-1">
        <span class="text-display-md text-ink tracking-[-0.96px] font-semibold">237</span>
        <span class="text-caption-mono text-mute">AI Providers</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="text-display-md text-ink tracking-[-0.96px] font-semibold">90+</span>
        <span class="text-caption-mono text-mute">Free Tiers</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="text-display-md text-ink tracking-[-0.96px] font-semibold">15–95%</span>
        <span class="text-caption-mono text-mute">Token Savings</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="text-display-md text-ink tracking-[-0.96px] font-semibold">1.6B</span>
        <span class="text-caption-mono text-mute">Free Tokens/Mo</span>
      </div>
    </div>
  </section>

  <!-- Section: Token Compression Studio -->
  <section id="compression-studio" class="max-w-[1200px] mx-auto px-4 py-16 flex flex-col gap-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="flex flex-col gap-2 max-w-2xl">
        <span class="text-caption-mono text-violet font-semibold">Token Compactor</span>
        <h2 class="text-display-lg text-ink tracking-[-1.28px] font-semibold">
          Save up to 95% tokens automatically.
        </h2>
        <p class="text-body-md text-body">
          Every request routes through OmniRoute's stacked compression pipeline. Drop technical logs, shorten prose, and de-duplicate conversation history before sending payloads to upstream LLMs.
        </p>
      </div>
    </div>

    <!-- Playground Widget Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 border border-hairline rounded-lg bg-canvas shadow-level-3 overflow-hidden">
      <!-- Left Column: Settings and Input -->
      <div class="lg:col-span-5 p-6 border-b lg:border-b-0 lg:border-r border-hairline flex flex-col gap-6 bg-canvas-soft">
        <div class="flex flex-col gap-2">
          <label class="text-caption-mono text-mute font-semibold">1. Choose Input Template</label>
          <div class="grid grid-cols-3 gap-2">
            <button 
              type="button" 
              id="preset-code-err"
              class="px-3 py-2 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm font-medium transition-all text-ink cursor-pointer"
            >
              React Error
            </button>
            <button 
              type="button" 
              id="preset-git-diff"
              class="px-3 py-2 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm font-medium transition-all text-ink cursor-pointer"
            >
              Git Diff
            </button>
            <button 
              type="button" 
              id="preset-prose"
              class="px-3 py-2 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm font-medium transition-all text-ink cursor-pointer"
            >
              Prose Explain
            </button>
          </div>
        </div>

        <div class="flex flex-col gap-2 flex-1">
          <label for="comp-input" class="text-caption-mono text-mute font-semibold">2. Prompt / Output Payload</label>
          <textarea 
            id="comp-input" 
            rows="8"
            class="w-full flex-1 p-3 bg-canvas border border-hairline rounded-sm text-code text-ink placeholder:text-mute focus:outline-none focus:border-hairline-strong font-mono resize-none transition-colors"
          ></textarea>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-caption-mono text-mute font-semibold">3. Select Compression Pipeline</label>
          <div class="grid grid-cols-2 gap-2">
            <button 
              type="button" 
              id="pipe-caveman"
              class="px-3 py-2.5 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm text-left transition-all text-ink cursor-pointer flex flex-col"
            >
              <strong class="text-body-sm-strong leading-none">Caveman Mode</strong>
              <span class="text-[11px] text-mute mt-1">Rule-based prose (~40% off)</span>
            </button>
            <button 
              type="button" 
              id="pipe-rtk"
              class="px-3 py-2.5 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm text-left transition-all text-ink cursor-pointer flex flex-col"
            >
              <strong class="text-body-sm-strong leading-none">RTK Filter</strong>
              <span class="text-[11px] text-mute mt-1">Tool log compaction (~75% off)</span>
            </button>
            <button 
              type="button" 
              id="pipe-stacked"
              class="col-span-2 px-3 py-2.5 bg-primary text-on-primary rounded-sm text-body-sm text-left transition-all cursor-pointer flex flex-col border border-primary shadow-level-2"
            >
              <strong class="text-body-sm-strong leading-none flex items-center gap-1.5">
                Stacked (RTK &rarr; Caveman)
                <span class="text-[9px] uppercase bg-violet text-white px-1.5 py-0.5 rounded-full font-mono">Max Saving</span>
              </strong>
              <span class="text-[11px] text-on-primary/80 mt-1">Stacked engines for compound reduction (~89% avg)</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Results & Interactive Analysis -->
      <div class="lg:col-span-7 p-6 flex flex-col gap-6">
        <!-- Live Metrics Bar -->
        <div class="grid grid-cols-3 gap-4 border-b border-hairline pb-5">
          <div class="flex flex-col gap-0.5">
            <span class="text-caption-mono text-mute leading-none">Tokens Saved</span>
            <span id="saved-pct" class="text-display-md text-emerald-500 font-semibold tracking-[-0.96px]">89.2%</span>
          </div>
          <div class="flex flex-col gap-0.5">
            <span class="text-caption-mono text-mute leading-none">Input Tokens</span>
            <span id="orig-tokens" class="text-display-md text-ink font-semibold tracking-[-0.96px]">235</span>
          </div>
          <div class="flex flex-col gap-0.5">
            <span class="text-caption-mono text-mute leading-none">Sent Tokens</span>
            <span id="sent-tokens" class="text-display-md text-ink font-semibold tracking-[-0.96px]">25</span>
          </div>
        </div>

        <!-- Before / After Side-by-Side -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 flex-1">
          <!-- Before Payload -->
          <div class="flex flex-col gap-2">
            <span class="text-caption-mono text-mute leading-none">Verbatim Payload (Original)</span>
            <div class="flex-1 p-3.5 bg-canvas-soft-2 border border-hairline rounded-sm font-mono text-[12px] text-body overflow-y-auto max-h-[220px] select-none whitespace-pre-wrap leading-relaxed" id="view-original"></div>
          </div>

          <!-- After Payload -->
          <div class="flex flex-col gap-2">
            <span class="text-caption-mono text-violet leading-none flex items-center justify-between">
              Compressed Payload
              <span class="text-[10px] font-mono text-emerald-500 bg-emerald-50 border border-emerald-200 px-1 rounded-sm">Protected Code</span>
            </span>
            <div class="flex-1 p-3.5 bg-canvas-soft border border-hairline rounded-sm font-mono text-[12px] text-ink overflow-y-auto max-h-[220px] whitespace-pre-wrap leading-relaxed" id="view-compressed"></div>
          </div>
        </div>

        <!-- Comparative Cost Savings Simulator card -->
        <div class="bg-violet-soft/20 border border-violet-soft/40 p-4 rounded-sm flex items-center justify-between gap-4">
          <div class="flex flex-col gap-0.5">
            <span class="text-body-sm-strong font-medium text-ink">Estimated Monthly Token Cost</span>
            <p class="text-caption text-body">Calculated based on 5M tokens/month using OpenAI / Anthropic base pricing.</p>
          </div>
          <div class="flex flex-col items-end shrink-0">
            <span class="text-caption text-mute line-through leading-none font-mono" id="original-cost-estimate">$75.00</span>
            <span class="text-body-md-strong font-bold text-violet font-mono text-lg" id="saved-cost-estimate">$8.10/mo</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Smart Routing & Fallback Simulator -->
  <section class="bg-primary text-on-primary py-20">
    <div class="max-w-[1200px] mx-auto px-4 flex flex-col gap-12">
      <div class="max-w-2xl flex flex-col gap-2">
        <span class="text-caption-mono text-violet-soft font-semibold">Resilience Engine</span>
        <h2 class="text-display-lg text-on-primary tracking-[-1.28px] font-semibold">
          Auto-fallback in milliseconds.
        </h2>
        <p class="text-body-md text-on-primary/80">
          Combos route request flows seamlessly across 4 hierarchical tiers. If a premium model fails or rate limits are triggered, the proxy slide-routes downstream instantly to avoid workflow disruptions.
        </p>
      </div>

      <!-- Simulator Interactive Canvas -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        <!-- Interactive Controller -->
        <div class="lg:col-span-4 p-6 bg-white/5 border border-white/10 rounded-lg flex flex-col gap-6 justify-between">
          <div class="flex flex-col gap-4">
            <h3 class="text-body-md-strong font-semibold">Simulate Failures</h3>
            <p class="text-body-sm text-on-primary/75">
              Click individual steps below to simulate upstream outages, timeouts, or quota blocks, and witness OmniRoute's real-time self-healing combo fallback.
            </p>
            
            <div class="flex flex-col gap-2.5 mt-2">
              <button 
                type="button" 
                id="btn-fail-tier1"
                class="w-full py-2.5 bg-red-600/20 hover:bg-red-600/40 border border-red-500/30 hover:border-red-500 rounded-sm text-body-sm font-mono text-red-200 transition-all cursor-pointer flex items-center justify-between px-3"
              >
                <span>Fail Tier 1 (429 Rate Limit)</span>
                <span id="status-tier1" class="text-[10px] uppercase bg-emerald-500 text-white font-mono px-1.5 py-0.5 rounded-sm tracking-wider font-semibold">Online</span>
              </button>
              <button 
                type="button" 
                id="btn-fail-tier2"
                class="w-full py-2.5 bg-red-600/20 hover:bg-red-600/40 border border-red-500/30 hover:border-red-500 rounded-sm text-body-sm font-mono text-red-200 transition-all cursor-pointer flex items-center justify-between px-3"
              >
                <span>Fail Tier 2 (Upstream Outage)</span>
                <span id="status-tier2" class="text-[10px] uppercase bg-emerald-500 text-white font-mono px-1.5 py-0.5 rounded-sm tracking-wider font-semibold">Online</span>
              </button>
              <button 
                type="button" 
                id="btn-fail-tier3"
                class="w-full py-2.5 bg-red-600/20 hover:bg-red-600/40 border border-red-500/30 hover:border-red-500 rounded-sm text-body-sm font-mono text-red-200 transition-all cursor-pointer flex items-center justify-between px-3"
              >
                <span>Fail Tier 3 (Budget Exceeded)</span>
                <span id="status-tier3" class="text-[10px] uppercase bg-emerald-500 text-white font-mono px-1.5 py-0.5 rounded-sm tracking-wider font-semibold">Online</span>
              </button>
            </div>
          </div>

          <button 
            type="button" 
            id="btn-reset-simulator"
            class="w-full py-2.5 bg-white text-primary hover:bg-white/95 rounded-sm text-body-sm-strong font-medium transition-all cursor-pointer"
          >
            Reset Simulator
          </button>
        </div>

        <!-- Simulation Flow visualizer -->
        <div class="lg:col-span-8 p-6 bg-white/5 border border-white/10 rounded-lg flex flex-col justify-between gap-8 relative overflow-hidden">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <span class="text-caption-mono text-violet-soft">Active Routing Chain</span>
            <span class="text-[11px] font-mono text-violet-soft flex items-center gap-1.5" id="simulation-verdict">
              <span class="w-2 h-2 bg-emerald-400 rounded-full animate-ping"></span>
              ROUTING FLOW ACTIVE: Claude 3.5 Sonnet
            </span>
          </div>

          <!-- Flow Node grid -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 py-4 relative">
            <!-- Flow line (bg decoration) -->
            <div class="absolute top-[42px] left-[10%] right-[10%] h-0.5 bg-white/10 hidden md:block z-0"></div>
            
            <!-- Tier 1 -->
            <div 
              id="node-tier1"
              class="relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-violet text-on-primary shadow-[0_0_15px_rgba(121,40,202,0.4)]"
            >
              <div class="text-[10px] font-mono text-violet-soft uppercase tracking-widest leading-none">Tier 1 &bull; Subscription</div>
              <strong class="text-body-md font-semibold mt-1 font-sans">Claude Opus</strong>
              <span class="text-[11px] font-mono text-violet-soft font-semibold leading-none" id="label-tier1">ACTIVE PATH</span>
            </div>

            <!-- Tier 2 -->
            <div 
              id="node-tier2"
              class="relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-white/15 text-on-primary/60"
            >
              <div class="text-[10px] font-mono text-white/40 uppercase tracking-widest leading-none">Tier 2 &bull; API Key</div>
              <strong class="text-body-md font-semibold mt-1 font-sans">DeepSeek V3</strong>
              <span class="text-[11px] font-mono text-white/30 leading-none" id="label-tier2">STANDBY</span>
            </div>

            <!-- Tier 3 -->
            <div 
              id="node-tier3"
              class="relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-white/15 text-on-primary/60"
            >
              <div class="text-[10px] font-mono text-white/40 uppercase tracking-widest leading-none">Tier 3 &bull; Cheap</div>
              <strong class="text-body-md font-semibold mt-1 font-sans">MiniMax 0.2</strong>
              <span class="text-[11px] font-mono text-white/30 leading-none" id="label-tier3">STANDBY</span>
            </div>

            <!-- Tier 4 -->
            <div 
              id="node-tier4"
              class="relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-white/15 text-on-primary/60"
            >
              <div class="text-[10px] font-mono text-white/40 uppercase tracking-widest leading-none">Tier 4 &bull; Free</div>
              <strong class="text-body-md font-semibold mt-1 font-sans">Pollinations</strong>
              <span class="text-[11px] font-mono text-white/30 leading-none" id="label-tier4">STANDBY</span>
            </div>
          </div>

          <!-- Log console output -->
          <div class="p-4 bg-black/40 border border-white/10 rounded-sm font-mono text-[12px] leading-relaxed max-h-[140px] overflow-y-auto text-white/80 flex flex-col gap-1" id="sim-console">
            <span class="text-white/45">[14:50:02] Initializing OmniRoute resilient request pipeline...</span>
            <span class="text-white/45">[14:50:02] Scored 237 connections. Built virtual auto-combo chain.</span>
            <span class="text-emerald-400 font-semibold">[14:50:02] Routing request to Claude Opus. Status: Healthy.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Interactive Providers Directory -->
  <section class="max-w-[1200px] mx-auto px-4 py-16 flex flex-col gap-8">
    <div class="flex flex-col gap-2">
      <span class="text-caption-mono text-violet font-semibold">Integrations</span>
      <h2 class="text-display-lg text-ink tracking-[-1.28px] font-semibold">
        Aggregate every major model.
      </h2>
      <p class="text-body-md text-body max-w-2xl">
        Point your tools to our universal proxy and configure connection secrets once. Browse the connected endpoints, filter by class, and select your fallbacks.
      </p>
    </div>

    <!-- Search & Filter Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-hairline pb-4">
      <div class="flex gap-2" id="provider-filters">
        <button 
          type="button" 
          class="h-8 px-4 rounded-pill-sm text-body-sm bg-primary text-on-primary transition-all cursor-pointer"
          data-filter="all"
        >
          All (237)
        </button>
        <button 
          type="button" 
          class="h-8 px-4 rounded-pill-sm text-body-sm text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
          data-filter="free"
        >
          Free Tiers (90+)
        </button>
        <button 
          type="button" 
          class="h-8 px-4 rounded-pill-sm text-body-sm text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
          data-filter="premium"
        >
          Premium Labs
        </button>
        <button 
          type="button" 
          class="h-8 px-4 rounded-pill-sm text-body-sm text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
          data-filter="local"
        >
          Local / Offline
        </button>
      </div>

      <div class="relative w-full md:w-64">
        <input 
          type="text" 
          placeholder="Filter providers..." 
          id="provider-search"
          class="w-full h-9 bg-canvas-soft border border-hairline rounded-sm pl-8 pr-3 text-body-sm text-ink placeholder:text-mute focus:outline-none focus:border-hairline-strong transition-colors"
        />
        <svg class="absolute left-2.5 top-2.5 text-mute" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
    </div>

    <!-- Provider Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="provider-grid">
      <!-- OpenAI -->
      <div class="p-4 bg-canvas border border-hairline rounded-md shadow-level-2 hover:border-hairline-strong hover:shadow-level-3 transition-all flex flex-col gap-2" data-type="premium" data-name="openai">
        <div class="flex items-center justify-between">
          <strong class="text-body-md font-semibold text-ink">OpenAI</strong>
          <span class="text-[10px] font-mono text-violet bg-violet-soft/20 border border-violet-soft/40 px-1.5 py-0.5 rounded-sm">Lab</span>
        </div>
        <p class="text-caption text-body">GPT-4o, GPT-4o-mini, o1-pro models catalog.</p>
        <span class="text-[11px] font-mono text-mute mt-auto">Pricing: API catalog</span>
      </div>

      <!-- Anthropic -->
      <div class="p-4 bg-canvas border border-hairline rounded-md shadow-level-2 hover:border-hairline-strong hover:shadow-level-3 transition-all flex flex-col gap-2" data-type="premium" data-name="anthropic">
        <div class="flex items-center justify-between">
          <strong class="text-body-md font-semibold text-ink">Anthropic</strong>
          <span class="text-[10px] font-mono text-violet bg-violet-soft/20 border border-violet-soft/40 px-1.5 py-0.5 rounded-sm">Lab</span>
        </div>
        <p class="text-caption text-body">Claude 3.5 Sonnet, Claude Opus, and Fable 5.</p>
        <span class="text-[11px] font-mono text-mute mt-auto">Pricing: API catalog</span>
      </div>

      <!-- DeepSeek -->
      <div class="p-4 bg-canvas border border-hairline rounded-md shadow-level-2 hover:border-hairline-strong hover:shadow-level-3 transition-all flex flex-col gap-2" data-type="premium" data-name="deepseek">
        <div class="flex items-center justify-between">
          <strong class="text-body-md font-semibold text-ink">DeepSeek</strong>
          <span class="text-[10px] font-mono text-emerald-600 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded-sm">Budget</span>
        </div>
        <p class="text-caption text-body">DeepSeek V3 and DeepSeek R1 reasoning.</p>
        <span class="text-[11px] font-mono text-mute mt-auto">Pricing: Ultra-cheap ($0.55/1M)</span>
      </div>

      <!-- Qoder AI -->
      <div class="p-4 bg-canvas border border-hairline rounded-md shadow-level-2 hover:border-hairline-strong hover:shadow-level-3 transition-all flex flex-col gap-2" data-type="free" data-name="qoder ai">
        <div class="flex items-center justify-between">
          <strong class="text-body-md font-semibold text-ink">Qoder AI</strong>
          <span class="text-[10px] font-mono text-emerald-600 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded-sm">Free</span>
        </div>
        <p class="text-caption text-body">Provides unlimited free access to DeepSeek-R1 and Kimi-K2.</p>
        <span class="text-[11px] font-mono text-mute mt-auto">Pricing: $0 Free</span>
      </div>

      <!-- Pollinations -->
      <div class="p-4 bg-canvas border border-hairline rounded-md shadow-level-2 hover:border-hairline-strong hover:shadow-level-3 transition-all flex flex-col gap-2" data-type="free" data-name="pollinations">
        <div class="flex items-center justify-between">
          <strong class="text-body-md font-semibold text-ink">Pollinations</strong>
          <span class="text-[10px] font-mono text-emerald-600 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded-sm">Free</span>
        </div>
        <p class="text-caption text-body">No API keys required. Serves Llama 3.1 & GPT-4o-mini.</p>
        <span class="text-[11px] font-mono text-mute mt-auto">Pricing: $0 Free</span>
      </div>

      <!-- Kiro AI -->
