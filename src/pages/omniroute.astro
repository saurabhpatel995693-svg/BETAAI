  <!-- Interactive Client-side Script for Simulator and Controls -->
  <script is:inline>
    // PRESETS FOR TOKEN COMPRESSION STUDIO
    const PRESETS = {
      codeErr: {
        text: `Error: Expected server HTML to contain a matching <div> in <div>.\n  at Header (Header.jsx:12)\n  at div (Layout.jsx:45)\n  at body\n  at html\n  at App\n\nThis hydration mismatch is likely caused by printing dynamic timestamps on server side:\nconst time = new Date().toLocaleTimeString();\nReactDOM.hydrate(<App time={time} />, document.getElementById('root'));\nServer time was 10:00:02 PM, but client time was 10:00:03 PM during hydration.`,
        comp: `Dynamic timestamps causes React hydration mismatch error. Wrap timestamp output in useEffect or pass statically to avoid matching warnings.`,
        tokens: 95,
        saved: 78
      },
      gitDiff: {
        text: `diff --git a/src/App.jsx b/src/App.jsx\nindex a1b2c3d..e4f5g6h 100644\n--- a/src/App.jsx\n+++ b/src/App.jsx\n@@ -12,5 +12,7 @@ function App() {\n   return (\n     <div class="container">\n-      <h1 class="text-3xl">Old Title</h1>\n+      <h1 class="text-3xl font-semibold tracking-tight text-ink font-sans">New Sentence Case Title.</h1>\n+      <p class="text-body-md text-body mt-2">Added fresh typography support matching DESIGN.md guidelines.</p>\n     </div>\n   )\n }`,
        comp: `Modified App.jsx title layout: changed to Vercel-style typography and added details sentence matching design guidelines.`,
        tokens: 125,
        saved: 84
      },
      prose: {
        text: `The reason your React component is re-rendering is likely because you're creating a new object reference on each render cycle. When you pass an inline object as a prop, React's shallow comparison sees it as a different object every time, which triggers a re-render. I would recommend using useMemo to memoize the object.`,
        comp: `New object ref each render. Inline object prop = new ref = re-render. Wrap in useMemo.`,
        tokens: 69,
        saved: 72
      }
    };

    const terminalPresets = {
      'claude-code': `# Run the guided launcher inside your project\nomniroute launch-codex\n\n# To configure Claude Code CLI:\nclaude mcp add-server omniroute \\\n  --type http \\\n  --url http://localhost:20128/api/mcp/stream\n\n# Test your endpoint returns healthy connections\ncurl http://localhost:20128/v1/models \\\n  -H "Authorization: Bearer YOUR_OMNIROUTE_KEY"`,
      'cursor': `# Open Cursor Settings -> Models -> OpenAI API\n# Set Endpoint URL to:\nhttp://localhost:20128/v1\n\n# Set API Key to:\nYOUR_OMNIROUTE_API_KEY\n\n# Available Virtual Models:\n- auto\n- auto/coding\n- auto/fast`,
      'cline': `# In Cline / Roo Code settings:\n# 1. Select API Provider: "OpenAI Compatible"\n# 2. Base URL: http://localhost:20128/v1\n# 3. API Key: YOUR_OMNIROUTE_API_KEY\n# 4. Model ID: auto/coding`,
      'continue': `// Add to ~/.continue/config.json\n{\n  "models": [\n    {\n      "title": "OmniRoute Auto",\n      "provider": "openai",\n      "model": "auto",\n      "apiBase": "http://localhost:20128/v1",\n      "apiKey": "YOUR_OMNIROUTE_KEY"\n    }\n  ]\n}`
    };

    // INIT ELEMENTS
    const compInput = document.getElementById('comp-input');
    const viewOriginal = document.getElementById('view-original');
    const viewCompressed = document.getElementById('view-compressed');
    const savedPct = document.getElementById('saved-pct');
    const origTokens = document.getElementById('orig-tokens');
    const sentTokens = document.getElementById('sent-tokens');
    const origCost = document.getElementById('original-cost-estimate');
    const savedCost = document.getElementById('saved-cost-estimate');

    const presetCodeErr = document.getElementById('preset-code-err');
    const presetGitDiff = document.getElementById('preset-git-diff');
    const presetProse = document.getElementById('preset-prose');

    const pipeCaveman = document.getElementById('pipe-caveman');
    const pipeRtk = document.getElementById('pipe-rtk');
    const pipeStacked = document.getElementById('pipe-stacked');

    let activePreset = 'prose';
    let activePipe = 'stacked';

    // UPDATE SIMULATOR MATH
    function updateCompressionStudio() {
      const textVal = compInput.value;
      viewOriginal.textContent = textVal;

      // Custom scaling factor based on selections
      let baseSavings = 0.89; // Stacked
      let displayOutput = '';
      
      const presetData = PRESETS[activePreset];

      if (activePipe === 'caveman') {
        baseSavings = 0.40;
        displayOutput = presetData ? presetData.comp + '\n\n[Prose compressed, syntax retained]' : 'Caveman condensed form...';
      } else if (activePipe === 'rtk') {
        baseSavings = 0.72;
        displayOutput = presetData ? presetData.comp + '\n\n[Log outputs trimmed & normalized]' : 'RTK filtered content...';
      } else {
        // Stacked
        baseSavings = presetData ? (presetData.saved / 100) : 0.89;
        displayOutput = presetData ? presetData.comp : 'Stacked output form...';
      }

      const inputLen = textVal.length;
      // Estimate token count roughly (1 token ~ 4 chars)
      const inputTokens = Math.max(15, Math.round(inputLen / 4.1));
      const outputTokens = Math.max(4, Math.round(inputTokens * (1 - baseSavings)));
      const finalSavings = ((1 - (outputTokens / inputTokens)) * 100).toFixed(1);

      savedPct.textContent = `${finalSavings}%`;
      origTokens.textContent = inputTokens;
      sentTokens.textContent = outputTokens;
      viewCompressed.textContent = displayOutput;

      // Cost estimation based on 5M tokens per month
      const rawCost = (5000000 / 1000000) * 15.0; // ~$15 per million avg
      const compCost = rawCost * (1 - (finalSavings / 100));

      origCost.textContent = `$${rawCost.toFixed(2)}`;
      savedCost.textContent = `$${compCost.toFixed(2)}/mo`;
    }

    // EVENT BINDINGS FOR COMPRESSION STUDIO
    presetCodeErr?.addEventListener('click', () => {
      activePreset = 'codeErr';
      compInput.value = PRESETS.codeErr.text;
      updateCompressionStudio();
    });

    presetGitDiff?.addEventListener('click', () => {
      activePreset = 'gitDiff';
      compInput.value = PRESETS.gitDiff.text;
      updateCompressionStudio();
    });

    presetProse?.addEventListener('click', () => {
      activePreset = 'prose';
      compInput.value = PRESETS.prose.text;
      updateCompressionStudio();
    });

    pipeCaveman?.addEventListener('click', () => {
      activePipe = 'caveman';
      pipeCaveman.className = 'px-3 py-2.5 bg-primary text-on-primary rounded-sm text-body-sm text-left transition-all cursor-pointer flex flex-col border border-primary shadow-level-2';
      pipeRtk.className = 'px-3 py-2.5 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm text-left transition-all text-ink cursor-pointer flex flex-col';
      pipeStacked.className = 'col-span-2 px-3 py-2.5 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm text-left transition-all text-ink cursor-pointer flex flex-col';
      updateCompressionStudio();
    });

    pipeRtk?.addEventListener('click', () => {
      activePipe = 'rtk';
      pipeCaveman.className = 'px-3 py-2.5 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm text-left transition-all text-ink cursor-pointer flex flex-col';
      pipeRtk.className = 'px-3 py-2.5 bg-primary text-on-primary rounded-sm text-body-sm text-left transition-all cursor-pointer flex flex-col border border-primary shadow-level-2';
      pipeStacked.className = 'col-span-2 px-3 py-2.5 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm text-left transition-all text-ink cursor-pointer flex flex-col';
      updateCompressionStudio();
    });

    pipeStacked?.addEventListener('click', () => {
      activePipe = 'stacked';
      pipeCaveman.className = 'px-3 py-2.5 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm text-left transition-all text-ink cursor-pointer flex flex-col';
      pipeRtk.className = 'px-3 py-2.5 bg-canvas border border-hairline hover:border-hairline-strong rounded-sm text-body-sm text-left transition-all text-ink cursor-pointer flex flex-col';
      pipeStacked.className = 'col-span-2 px-3 py-2.5 bg-primary text-on-primary rounded-sm text-body-sm text-left transition-all cursor-pointer flex flex-col border border-primary shadow-level-2';
      updateCompressionStudio();
    });

    compInput?.addEventListener('input', updateCompressionStudio);

    // Initial load setup for compression
    if (compInput) compInput.value = PRESETS.prose.text;
    updateCompressionStudio();


    // ----------------------------------------------------
    // FALLBACK SIMULATOR ENGINE
    // ----------------------------------------------------
    const btnFailTier1 = document.getElementById('btn-fail-tier1');
    const btnFailTier2 = document.getElementById('btn-fail-tier2');
    const btnFailTier3 = document.getElementById('btn-fail-tier3');
    const btnResetSim = document.getElementById('btn-reset-simulator');

    const statusTier1 = document.getElementById('status-tier1');
    const statusTier2 = document.getElementById('status-tier2');
    const statusTier3 = document.getElementById('status-tier3');

    const nodeTier1 = document.getElementById('node-tier1');
    const nodeTier2 = document.getElementById('node-tier2');
    const nodeTier3 = document.getElementById('node-tier3');
    const nodeTier4 = document.getElementById('node-tier4');

    const labelTier1 = document.getElementById('label-tier1');
    const labelTier2 = document.getElementById('label-tier2');
    const labelTier3 = document.getElementById('label-tier3');
    const labelTier4 = document.getElementById('label-tier4');

    const simConsole = document.getElementById('sim-console');
    const simulationVerdict = document.getElementById('simulation-verdict');

    let tierStatus = { t1: true, t2: true, t3: true };

    function writeConsoleLog(msg, color = 'text-white/45') {
      const span = document.createElement('span');
      span.className = color;
      const now = new Date();
      const timeStr = `[${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}:${now.getSeconds().toString().padStart(2,'0')}]`;
      span.textContent = `${timeStr} ${msg}`;
      simConsole?.appendChild(span);
      if (simConsole) simConsole.scrollTop = simConsole.scrollHeight;
    }

    function updateSimulationFlow() {
      // Clear styles
      const nodes = [nodeTier1, nodeTier2, nodeTier3, nodeTier4];
      const labels = [labelTier1, labelTier2, labelTier3, labelTier4];

      nodes.forEach(n => {
        if (n) {
          n.className = "relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-white/15 text-on-primary/60";
        }
      });
      labels.forEach(l => {
        if (l) {
          l.textContent = "STANDBY";
          l.className = "text-[11px] font-mono text-white/30 leading-none";
        }
      });

      if (tierStatus.t1) {
        // T1 Active
        if (nodeTier1) nodeTier1.className = "relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-violet text-on-primary shadow-[0_0_15px_rgba(121,40,202,0.4)]";
        if (labelTier1) {
          labelTier1.textContent = "ACTIVE PATH";
          labelTier1.className = "text-[11px] font-mono text-violet-soft font-semibold leading-none";
        }
        if (simulationVerdict) simulationVerdict.innerHTML = '<span class="w-2 h-2 bg-emerald-400 rounded-full animate-ping"></span> ROUTING FLOW ACTIVE: Claude Opus';
      } else if (tierStatus.t2) {
        // T2 Active
        if (nodeTier2) nodeTier2.className = "relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-violet text-on-primary shadow-[0_0_15px_rgba(121,40,202,0.4)]";
        if (labelTier2) {
          labelTier2.textContent = "ACTIVE PATH";
          labelTier2.className = "text-[11px] font-mono text-violet-soft font-semibold leading-none";
        }
        if (nodeTier1) nodeTier1.className = "relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-red-500/40 text-red-300/60";
        if (labelTier1) {
          labelTier1.textContent = "FAILED";
          labelTier1.className = "text-[11px] font-mono text-red-400 font-semibold leading-none";
        }
        if (simulationVerdict) simulationVerdict.innerHTML = '<span class="w-2 h-2 bg-emerald-400 rounded-full animate-ping"></span> ROUTING FLOW ACTIVE: DeepSeek V3';
      } else if (tierStatus.t3) {
        // T3 Active
        if (nodeTier3) nodeTier3.className = "relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-violet text-on-primary shadow-[0_0_15px_rgba(121,40,202,0.4)]";
        if (labelTier3) {
          labelTier3.textContent = "ACTIVE PATH";
          labelTier3.className = "text-[11px] font-mono text-violet-soft font-semibold leading-none";
        }
        if (nodeTier1) nodeTier1.className = "relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-red-500/40 text-red-300/60";
        if (labelTier1) {
          labelTier1.textContent = "FAILED";
          labelTier1.className = "text-[11px] font-mono text-red-400 font-semibold leading-none";
        }
        if (nodeTier2) nodeTier2.className = "relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-red-500/40 text-red-300/60";
        if (labelTier2) {
          labelTier2.textContent = "FAILED";
          labelTier2.className = "text-[11px] font-mono text-red-400 font-semibold leading-none";
        }
        if (simulationVerdict) simulationVerdict.innerHTML = '<span class="w-2 h-2 bg-emerald-400 rounded-full animate-ping"></span> ROUTING FLOW ACTIVE: MiniMax';
      } else {
        // T4 Active (Free fallback)
        if (nodeTier4) nodeTier4.className = "relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-violet text-on-primary shadow-[0_0_15px_rgba(121,40,202,0.4)]";
        if (labelTier4) {
          labelTier4.textContent = "ACTIVE PATH";
          labelTier4.className = "text-[11px] font-mono text-violet-soft font-semibold leading-none";
        }
        nodes.slice(0,3).forEach((n, idx) => {
          if (n) n.className = "relative z-10 p-4 border rounded-sm flex flex-col gap-2 transition-all duration-300 bg-primary border-red-500/40 text-red-300/60";
          const l = labels[idx];
          if (l) {
            l.textContent = "FAILED";
            l.className = "text-[11px] font-mono text-red-400 font-semibold leading-none";
          }
        });
        if (simulationVerdict) simulationVerdict.innerHTML = '<span class="w-2 h-2 bg-emerald-400 rounded-full animate-ping"></span> ROUTING FLOW ACTIVE: Pollinations (Free)';
      }
    }

    btnFailTier1?.addEventListener('click', () => {
      if (tierStatus.t1) {
        tierStatus.t1 = false;
        if (statusTier1) {
          statusTier1.textContent = "Offline (429)";
          statusTier1.className = "text-[10px] uppercase bg-red-600 text-white font-mono px-1.5 py-0.5 rounded-sm tracking-wider font-semibold";
        }
        writeConsoleLog("WARN: Claude Opus returned HTTP 429 (Too Many Requests). Quota Limit breached.", "text-yellow-400");
        writeConsoleLog("Resilience triggering: sliding to Tier 2 (DeepSeek V3). Time elapsed: 14ms.", "text-violet-soft");
        updateSimulationFlow();
      }
    });

    btnFailTier2?.addEventListener('click', () => {
      if (tierStatus.t2) {
        tierStatus.t2 = false;
        if (statusTier2) {
          statusTier2.textContent = "Offline (503)";
          statusTier2.className = "text-[10px] uppercase bg-red-600 text-white font-mono px-1.5 py-0.5 rounded-sm tracking-wider font-semibold";
        }
        writeConsoleLog("WARN: DeepSeek V3 returned HTTP 503 (Outage). Server unreachable.", "text-yellow-400");
        writeConsoleLog("Resilience triggering: sliding to Tier 3 (MiniMax 0.2). Time elapsed: 18ms.", "text-violet-soft");
        updateSimulationFlow();
      }
    });

    btnFailTier3?.addEventListener('click', () => {
      if (tierStatus.t3) {
        tierStatus.t3 = false;
        if (statusTier3) {
          statusTier3.textContent = "Offline";
          statusTier3.className = "text-[10px] uppercase bg-red-600 text-white font-mono px-1.5 py-0.5 rounded-sm tracking-wider font-semibold";
        }
        writeConsoleLog("WARN: MiniMax USD budget quota check failed (Limit reached).", "text-yellow-400");
        writeConsoleLog("Resilience triggering: sliding to Tier 4 (Free - Pollinations). Time elapsed: 22ms.", "text-violet-soft");
        updateSimulationFlow();
      }
    });

    btnResetSim?.addEventListener('click', () => {
      tierStatus = { t1: true, t2: true, t3: true };
      
      if (statusTier1) {
        statusTier1.textContent = "Online";
        statusTier1.className = "text-[10px] uppercase bg-emerald-500 text-white font-mono px-1.5 py-0.5 rounded-sm tracking-wider font-semibold";
      }
      if (statusTier2) {
        statusTier2.textContent = "Online";
        statusTier2.className = "text-[10px] uppercase bg-emerald-500 text-white font-mono px-1.5 py-0.5 rounded-sm tracking-wider font-semibold";
      }
      if (statusTier3) {
        statusTier3.textContent = "Online";
        statusTier3.className = "text-[10px] uppercase bg-emerald-500 text-white font-mono px-1.5 py-0.5 rounded-sm tracking-wider font-semibold";
      }

      if (simConsole) simConsole.innerHTML = '';
      writeConsoleLog("Initializing OmniRoute resilient request pipeline...", "text-white/45");
      writeConsoleLog("Scored 237 connections. Built virtual auto-combo chain.", "text-white/45");
      writeConsoleLog("Routing request to Claude Opus. Status: Healthy.", "text-emerald-400 font-semibold");

      updateSimulationFlow();
    });


    // ----------------------------------------------------
    // PROVIDERS SEARCH & FILTER
    // ----------------------------------------------------
    const providerSearch = document.getElementById('provider-search');
    const providerGrid = document.getElementById('provider-grid');
    const filterButtons = document.querySelectorAll('#provider-filters button');

    let activeFilter = 'all';

    function filterProviders() {
      const query = providerSearch.value.toLowerCase().trim();
      const items = providerGrid.querySelectorAll('div[data-type]');

      items.forEach(item => {
        const type = item.getAttribute('data-type');
        const name = item.getAttribute('data-name');
        
        const matchesFilter = activeFilter === 'all' || type === activeFilter;
        const matchesSearch = name.includes(query);

        if (matchesFilter && matchesSearch) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.className = 'h-8 px-4 rounded-pill-sm text-body-sm text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer';
        });
        btn.className = 'h-8 px-4 rounded-pill-sm text-body-sm bg-primary text-on-primary transition-all cursor-pointer';
        activeFilter = btn.getAttribute('data-filter');
        filterProviders();
      });
    });

    providerSearch?.addEventListener('input', filterProviders);


    // ----------------------------------------------------
    // INTEGRATION TABS & COPY
    // ----------------------------------------------------
    const tabButtons = document.querySelectorAll('#cli-tool-tabs button');
    const terminalTitle = document.getElementById('terminal-title');
    const terminalContent = document.getElementById('terminal-content');
    const btnCopyCode = document.getElementById('btn-copy-code');

    let activeTool = 'claude-code';

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tabButtons.forEach(b => {
          b.className = 'flex items-center justify-between p-3 rounded-sm text-left text-body-sm hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer w-full';
          const indicator = b.querySelector('span:last-child');
          if (indicator) indicator.className = 'text-[10px] font-mono text-mute';
        });
        
        btn.className = 'flex items-center justify-between p-3 rounded-sm text-left text-body-sm-strong font-medium bg-primary text-on-primary transition-all cursor-pointer w-full';
        const activeIndicator = btn.querySelector('span:last-child');
        if (activeIndicator) activeIndicator.className = 'text-[10px] font-mono opacity-85';

        activeTool = btn.getAttribute('data-tool');
        terminalTitle.textContent = `terminal • ${activeTool} setup`;
        terminalContent.textContent = terminalPresets[activeTool];
      });
    });

    btnCopyCode?.addEventListener('click', () => {
      const codeText = terminalContent.textContent;
      navigator.clipboard.writeText(codeText).then(() => {
        const origText = btnCopyCode.innerHTML;
        btnCopyCode.innerHTML = 'Copied!';
        setTimeout(() => {
          btnCopyCode.innerHTML = origText;
        }, 1500);
      });
    });
  </script>
</Layout>
