      let availableLangs = [];
      if (isYouTubeUrl(topicInput)) {
        document.getElementById('loading-msg').innerText = '⬇️ YouTube video se transcript fetch ho raha hai...';
        document.getElementById('loading-sub-msg').innerText = 'Kripya pratiksha karein — video ka content padha ja raha hai';
        const result = await fetchYouTubeTranscript(topicInput);
        if (result.error) {
          // Transcript unavailable — show clear error and STOP
          loadingView.classList.add('hidden');
          document.getElementById('default-preview').classList.remove('hidden');
          // Update the default preview to show error message
          document.querySelector('#default-preview h4').innerText = '❌ Transcript / Captions Available Nahi Hain';
          document.querySelector('#default-preview p').innerHTML = `<strong>${result.error}</strong><br><br>${result.errorEn || 'YouTube ne is video ke liye captions disable kar diye hain. Kripya koi doosra video try karein jisme captions hon, ya topic/text directly type karein.'}<br><br>💡 <em>Tip: Video ka topic text field mein directly type karke bhi notes bana sakte hain.</em>`;
          // Also try to show the API error detail
          const errorDetail = result.error || 'No captions available for this video';
          const statusEl = document.getElementById('file-upload-status');
          statusEl.classList.remove('hidden');
          statusEl.className = 'mt-1 text-[10px] font-mono text-error';
          statusEl.innerText = `⚠️ ${errorDetail}`;
          return; // Stop generation — don't fall back to generic answers
        } else {
          // Transcript available — use the actual video content
          actualTopic = result.title || topicInput;
          transcriptText = result.transcript || '';
          transcriptLanguage = result.language || 'unknown';
          availableLangs = result.availableLanguages || [];
          const langDisplay = availableLangs.length ? availableLangs.join(', ') : transcriptLanguage;
          document.getElementById('loading-sub-msg').innerText = `Video "${actualTopic}" se ${(transcriptText.length / 1000).toFixed(0)}K characters ka transcript mila (language: ${langDisplay})`;
        }
        // Small delay so user can read the message
        await new Promise(r => setTimeout(r, 600));
      }

      // ── Build transcript context (YouTube video captions) ──
      const transcriptContext = transcriptText ? `\n\n=== YAHAN SE ACTUAL VIDEO TRANSCRIPT SHURU HOTA HAI ===\nTranscript language: ${transcriptLanguage}.\nBase ALL answers on the content below. Do NOT use general knowledge.\n"""\n${transcriptText.substring(0, 8000)}\n"""\n=== YAHAN TAK ACTUAL VIDEO TRANSCRIPT ===` : '';

      // ── Build file upload context (PDF, TXT, MD content) ──
      const fileContext = uploadedFileContent ? `\n\n=== YAHAN SE UPLOADED FILE KA CONTENT SHURU HOTA HAI ===\nBase ALL answers on the content below. Do NOT use general knowledge.\n"""\n${uploadedFileContent.substring(0, 8000)}\n"""\n=== YAHAN TAK UPLOADED FILE KA CONTENT ===` : '';

      document.getElementById('loading-msg').innerText = `🧠 AI aapke ${toneLabel} ke liye study pack bana raha hai...`;
      document.getElementById('loading-sub-msg').innerText = 'SHESHAAI Engine content generate kar raha hai';

      try {
        if (currentMode === 'notes') {
          titleBadge.innerText = "Generated Easy Notes";
          iconBadge.innerText = "📋";

          const prompt = `Create comprehensive educational study notes. CRITICAL: Base the notes ENTIRELY on the actual content below, NOT on general knowledge about the topic name. If actual transcript/content is provided below (between """ markers), use ONLY that content — ignore the topic name if it conflicts.

Topic reference: "${actualTopic}"
Target Grade Level: ${toneLabel}.${transcriptContext}${fileContext}

Provide (based ONLY on actual content provided above):
1. A summary overview paragraph (5-6 sentences).
2. 8-12 key bullet points explaining core concepts.
3. 5-7 key vocabulary terms with short definitions.
4. 3-4 important formulas or facts to remember.`;
          const responseText = await callKiddieAI(prompt);

          document.getElementById('notes-topic-heading').innerText = `📌 ${topicInput.substring(0, 45)}`;
          document.getElementById('notes-summary-text').innerText = responseText;

          // Extract bullet lines
          const bulletList = document.getElementById('notes-bullets-list');
          bulletList.innerHTML = '';
          const lines = responseText.split('\n').filter(l => l.trim().startsWith('-') || l.trim().startsWith('*') || l.trim().match(/^\d+\./));
          if (lines.length > 0) {
            lines.slice(0, 6).forEach(line => {
