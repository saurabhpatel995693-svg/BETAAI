---
import Layout from '../layouts/Layout.astro';
---

<Layout title="KiddieNotes AI — Smart Study Suite for Nursery to 12th Class" wide={true} noSidebars={true}>
  <!-- Top Hero Bar (Vercel Stark Mesh Aesthetic) -->
  <section class="relative pt-12 pb-10 overflow-hidden border-b border-hairline bg-canvas">
    <div class="max-w-[1200px] mx-auto px-4 text-center relative z-10">
      
      <!-- Mesh Gradient Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-canvas-soft border border-hairline rounded-full shadow-level-2 mb-4">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan animate-pulse"></span>
        <span class="text-caption-mono text-ink font-semibold uppercase tracking-wider">KiddieNotes AI Studio — Nursery to 12th Grade</span>
      </div>

      <h1 class="text-display-xl md:text-[50px] leading-[1.08] font-semibold text-ink tracking-[-2px] mb-3">
        Turn YouTube Videos & Notes into <span class="bg-gradient-to-r from-violet via-pink-500 to-cyan bg-clip-text text-transparent">Interactive AI Study Packs</span>
      </h1>
      <p class="text-body-lg text-body max-w-2xl mx-auto mb-6">
        Convert video lectures, topics, and classroom audio into bullet notes, active recall quizzes, 3D flashcards, and arcade revision games.
      </p>

      <!-- Grade Filter Chips -->
      <div class="flex flex-wrap justify-center gap-2" id="grade-chips-wrapper">
        <button class="grade-chip px-4 py-1.5 rounded-pill text-xs font-mono font-semibold bg-primary text-on-primary border border-primary transition shadow-level-2 cursor-pointer active-grade" data-grade="all">
          🌟 All Classes (Nursery - 12th)
        </button>
        <button class="grade-chip px-4 py-1.5 rounded-pill text-xs font-mono font-medium bg-canvas-soft text-body border border-hairline hover:border-hairline-strong transition cursor-pointer" data-grade="nursery-5">
          🧸 Nursery to 5th (Simple & Emojis)
        </button>
        <button class="grade-chip px-4 py-1.5 rounded-pill text-xs font-mono font-medium bg-canvas-soft text-body border border-hairline hover:border-hairline-strong transition cursor-pointer" data-grade="6-10">
          📚 6th to 10th (Structured Notes)
        </button>
        <button class="grade-chip px-4 py-1.5 rounded-pill text-xs font-mono font-medium bg-canvas-soft text-body border border-hairline hover:border-hairline-strong transition cursor-pointer" data-grade="11-12">
          🎓 11th & 12th (Board Formulas & Exams)
        </button>
      </div>

    </div>
  </section>

  <!-- Interactive App Workplace -->
  <section class="max-w-[1200px] mx-auto px-4 py-8">
    
    <!-- TOP API KEY BAR (Unified — single source of truth for KiddieNotes) -->
    <div class="mb-8 p-4 bg-canvas border border-hairline rounded-lg shadow-level-2 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 w-full md:w-auto">
        <div class="w-8 h-8 rounded-md bg-cyan/10 text-cyan-deep flex items-center justify-center font-mono font-bold text-sm">
          🔑
        </div>
        <div>
          <h4 class="text-caption-mono font-semibold text-ink">Gemini API Key (Unlocks Unlimited Generation)</h4>
          <p class="text-[11px] text-mute font-mono">Enter your Gemini API Key to unlock unlimited KiddieNotes generation for your child's study packs</p>
        </div>
      </div>

      <div class="flex items-center gap-2 w-full md:w-auto flex-1 max-w-xl">
        <input 
          type="password" 
          id="kiddie-api-key-input" 
          placeholder="Paste key (e.g. AIzaSy...)" 
          class="flex-1 px-3 py-2 text-xs font-mono bg-canvas-soft border border-hairline rounded-sm text-ink focus:outline-none focus:border-link transition"
        />
        <button 
          id="save-key-btn" 
          class="px-4 py-2 bg-primary text-on-primary rounded-sm text-xs font-mono font-semibold hover:bg-black transition shadow-level-1 cursor-pointer"
        >
          Save Key
        </button>
      </div>

      <div id="key-status-badge" class="text-[11px] font-mono px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 font-medium">
        ⚡ Server Engine Ready
      </div>
    </div>

    <!-- MAIN TWO-COLUMN WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- LEFT PANEL: Inputs (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- Input 1: YouTube & Voice Audio -->
        <div class="bg-canvas p-6 rounded-lg border border-hairline shadow-level-3">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-7 h-7 rounded bg-primary text-on-primary font-mono text-xs flex items-center justify-center font-bold">1</span>
            <div>
              <h2 class="text-display-sm text-ink text-base">YouTube or Class Topic</h2>
              <p class="text-caption-mono text-mute">Paste video link or type lesson subject</p>
            </div>
          </div>

          <div class="space-y-4">
            <div>
              <label class="block text-caption-mono text-ink font-semibold mb-1">YouTube Link / Lesson Topic</label>
              <input 
                type="text" 
                id="yt-url-input" 
                placeholder="https://youtu.be/E_4gRy4O03w or Photosynthesis process" 
                class="w-full px-3 py-2 text-xs font-mono bg-canvas-soft border border-hairline rounded-sm text-ink focus:outline-none focus:border-link transition"
                value="https://youtu.be/E_4gRy4O03w"
              />
            </div>

            <!-- YouTube Presets -->
            <div>
              <span class="block text-[10px] font-mono text-mute uppercase tracking-wider mb-2">Try Kid Study Demos:</span>
              <div class="flex flex-wrap gap-2">
                <button class="demo-btn text-[11px] font-mono px-2.5 py-1 bg-canvas-soft border border-hairline rounded text-ink hover:bg-canvas-soft-2 transition cursor-pointer" data-url="https://youtu.be/E_4gRy4O03w" data-topic="KiddieNotes AI Study Demo">
                  📹 YT KiddieNotes Demo
                </button>
                <button class="demo-btn text-[11px] font-mono px-2.5 py-1 bg-canvas-soft border border-hairline rounded text-ink hover:bg-canvas-soft-2 transition cursor-pointer" data-url="https://youtube.com/watch?v=solar_system" data-topic="Solar System & Planets (Class 4-8)">
                  🪐 Solar System
                </button>
                <button class="demo-btn text-[11px] font-mono px-2.5 py-1 bg-canvas-soft border border-hairline rounded text-ink hover:bg-canvas-soft-2 transition cursor-pointer" data-url="https://youtube.com/watch?v=photosynthesis" data-topic="Photosynthesis Science (Class 9-10)">
                  🌱 Photosynthesis
                </button>
                <button class="demo-btn text-[11px] font-mono px-2.5 py-1 bg-canvas-soft border border-hairline rounded text-ink hover:bg-canvas-soft-2 transition cursor-pointer" data-url="https://youtube.com/watch?v=calculus_basics" data-topic="Calculus & Physics (Class 11-12)">
                  📐 Math/Physics 12th
                </button>
              </div>
            </div>

            <!-- Audio Recording -->
            <div class="pt-2 border-t border-hairline">
              <label class="block text-caption-mono text-ink font-semibold mb-1">Live Classroom Microphone</label>
              <button id="record-mic-btn" class="w-full py-2.5 px-3 bg-rose-600 text-white rounded-sm text-xs font-mono font-medium flex items-center justify-center gap-2 hover:bg-rose-700 transition shadow-level-2 cursor-pointer">
                <span id="mic-icon">🎙️</span>
                <span id="mic-text">Start Classroom Voice Recording</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Input 2: Output Format Selector -->
        <div class="bg-canvas p-6 rounded-lg border border-hairline shadow-level-3">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-7 h-7 rounded bg-primary text-on-primary font-mono text-xs flex items-center justify-center font-bold">2</span>
            <div>
              <h2 class="text-display-sm text-ink text-base">Select Study Format</h2>
              <p class="text-caption-mono text-mute">Choose how KiddieNotes AI presents content</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 mb-4">
            <button class="mode-select-btn p-3 bg-primary text-on-primary rounded-sm text-left border border-primary transition shadow-level-2 font-medium text-xs flex flex-col gap-1 active-mode cursor-pointer" data-type="notes">
              <span class="text-base">📋</span>
              <span>Easy Kid Notes</span>
            </button>
            <button class="mode-select-btn p-3 bg-canvas-soft text-ink rounded-sm text-left border border-hairline hover:border-hairline-strong transition font-medium text-xs flex flex-col gap-1 cursor-pointer" data-type="quiz">
              <span class="text-base">📝</span>
              <span>Interactive Quiz</span>
            </button>
            <button class="mode-select-btn p-3 bg-canvas-soft text-ink rounded-sm text-left border border-hairline hover:border-hairline-strong transition font-medium text-xs flex flex-col gap-1 cursor-pointer" data-type="flashcard">
              <span class="text-base">🃏</span>
              <span>3D Flashcard Deck</span>
            </button>
            <button class="mode-select-btn p-3 bg-canvas-soft text-ink rounded-sm text-left border border-hairline hover:border-hairline-strong transition font-medium text-xs flex flex-col gap-1 cursor-pointer" data-type="game">
              <span class="text-base">🏃</span>
              <span>Study Run Game</span>
            </button>
          </div>

          <div class="mb-5">
            <label class="block text-caption-mono text-ink font-semibold mb-1">Class Grade Complexity</label>
            <select id="tone-select" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-sm text-xs font-mono text-ink focus:outline-none">
              <option value="nursery">🧸 Nursery / KG (Emoji & Story Sentences)</option>
              <option value="middle" selected>📚 Class 1st to 8th (Structured Bullet Points)</option>
              <option value="high">🎓 Class 9th to 12th (Board Exam Formulas & Notes)</option>
            </select>
          </div>

          <button id="generate-btn" class="w-full py-3.5 bg-gradient-to-r from-violet via-pink-600 to-cyan-500 text-white rounded-pill text-xs font-mono font-bold uppercase tracking-wider hover:opacity-95 transition shadow-level-4 flex items-center justify-center gap-2 cursor-pointer">
            <span>⚡</span> Generate KiddieNotes AI Pack
          </button>
        </div>

      </div>

      <!-- RIGHT PANEL: Display Workplace (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        
        <div class="bg-canvas p-6 rounded-lg border border-hairline shadow-level-3 min-h-[540px] flex flex-col">
          
          <!-- Top Action Toolbar -->
          <div class="flex flex-wrap items-center justify-between border-b border-hairline pb-4 mb-4 gap-2">
            <div class="flex items-center gap-2">
              <span id="output-badge-icon" class="text-lg">📋</span>
              <h3 id="output-title" class="text-display-sm text-ink text-base">Generated Study Notes</h3>
            </div>
            <div class="flex items-center gap-2">
              <button id="read-aloud-btn" class="px-3 py-1.5 bg-blue-500/10 text-blue-600 rounded-sm text-xs font-mono font-semibold hover:bg-blue-500/20 transition cursor-pointer flex items-center gap-1">
                🔊 Read Aloud
              </button>
              <button id="copy-btn" class="px-3 py-1.5 bg-canvas-soft text-ink border border-hairline rounded-sm text-xs font-mono font-semibold hover:bg-canvas-soft-2 transition cursor-pointer">
                📋 Copy
              </button>
              <button id="download-btn" class="px-3 py-1.5 bg-canvas-soft text-ink border border-hairline rounded-sm text-xs font-mono font-semibold hover:bg-canvas-soft-2 transition cursor-pointer">
                📥 Export
              </button>
            </div>
          </div>

          <!-- Dynamic Output Container -->
          <div id="output-content-box" class="flex-1 relative flex flex-col">
            
            <!-- Default Idle State -->
            <div id="default-preview" class="flex-1 flex flex-col items-center justify-center text-center p-8 border border-dashed border-hairline rounded-lg bg-canvas-soft">
              <div class="w-14 h-14 rounded-xl bg-gradient-to-tr from-violet to-cyan text-white flex items-center justify-center text-2xl mb-3 shadow-level-3">
                ✨
              </div>
              <h4 class="text-display-sm text-ink text-base mb-2">Ready to convert YouTube to Notes!</h4>
              <p class="text-body-sm text-body max-w-sm mb-4">
                Enter your YouTube URL or lesson topic, choose your grade level, and click "Generate KiddieNotes AI Pack".
              </p>
            </div>

            <!-- Loading Loader View -->
            <div id="loading-view" class="hidden flex-1 flex flex-col items-center justify-center text-center p-8 border border-hairline rounded-lg bg-canvas-soft space-y-4">
              <div class="w-12 h-12 border-4 border-cyan border-t-transparent rounded-full animate-spin"></div>
              <p class="text-xs font-mono text-cyan-deep font-bold animate-pulse" id="loading-msg">⚡ Transcribing YouTube & Generating AI KiddieNotes Pack...</p>
              <span class="text-[11px] text-mute font-mono">Routing through SHESHAAI Unified AI Engine</span>
            </div>

            <!-- 1. Easy Kid Notes View -->
            <div id="notes-view" class="hidden space-y-5 flex-1 overflow-y-auto pr-1">
              <div class="p-4 bg-canvas-soft border border-hairline rounded-md">
                <h4 class="text-body-sm-strong font-semibold text-ink mb-2 flex items-center justify-between">
                  <span id="notes-topic-heading">📌 KiddieNotes AI Study Notes (K-12 Edition)</span>
                  <span class="text-caption-mono text-cyan-deep bg-cyan/10 border border-cyan/20 px-2 py-0.5 rounded font-mono">Transcribed</span>
                </h4>
                <div id="notes-summary-text" class="text-body-sm text-body leading-relaxed whitespace-pre-wrap"></div>
              </div>

              <div>
                <h5 class="text-caption-mono text-mute uppercase tracking-wider mb-3 font-semibold">Key Bullet Takeaways</h5>
                <ul id="notes-bullets-list" class="space-y-2.5 text-body-sm text-body"></ul>
              </div>

              <!-- AI Question Box -->
              <div class="pt-4 border-t border-hairline mt-auto">
                <h5 class="text-caption-mono text-ink font-semibold mb-2 flex items-center gap-1">💬 Ask AI Study Teacher</h5>
                <div class="flex gap-2">
                  <input type="text" id="ai-chat-input" placeholder="Ask e.g. Explain point 1 in simple terms..." class="flex-1 px-3 py-2 bg-canvas-soft border border-hairline rounded-sm text-xs text-ink focus:outline-none focus:border-link transition"/>
                  <button id="ai-chat-btn" class="px-4 py-2 bg-primary text-on-primary rounded-sm text-xs font-mono font-medium hover:bg-black transition cursor-pointer">Ask AI</button>
                </div>
                <div id="ai-chat-response" class="hidden mt-2 p-3 bg-canvas-soft border border-hairline text-ink rounded-sm text-xs font-mono leading-relaxed"></div>
              </div>
            </div>

            <!-- 2. Interactive Quiz View -->
            <div id="quiz-view" class="hidden space-y-4 flex-1 flex flex-col justify-between">
              <div class="flex items-center justify-between bg-canvas-soft p-3 rounded border border-hairline font-mono text-xs">
                <span class="text-ink font-semibold">Score: <span id="quiz-score" class="text-emerald-500 font-bold">0</span> / <span id="quiz-total">3</span></span>
                <span class="text-mute">Question <span id="quiz-curr-idx" class="text-ink font-bold">1</span> of <span id="quiz-count-display">3</span></span>
              </div>

              <div id="quiz-card-box" class="p-6 bg-canvas border border-hairline rounded-md shadow-level-2 space-y-4">
                <h4 id="quiz-question-text" class="text-display-sm text-ink text-base">Loading question...</h4>
                <div id="quiz-options-box" class="space-y-2.5"></div>
              </div>

              <div id="quiz-feedback-box" class="text-xs font-mono p-3 rounded-md bg-canvas-soft border border-hairline hidden"></div>
            </div>

            <!-- 3. 3D Flashcard View -->
            <div id="flashcard-view" class="hidden space-y-5 flex-1 flex flex-col justify-between">
              <div class="text-center text-caption-mono text-mute">Click card below to flip 🔄</div>
              
              <div id="flashcard-element" class="w-full min-h-[220px] bg-gradient-to-br from-neutral-900 to-black text-white rounded-xl shadow-level-4 p-6 flex flex-col items-center justify-center text-center cursor-pointer transition-all duration-300 hover:border hover:border-cyan/30">
                <span id="fc-term-tag" class="text-caption-mono text-cyan uppercase mb-2 font-bold tracking-widest">Term 1</span>
                <h4 id="flashcard-text-front" class="text-display-sm text-white text-lg font-medium">Loading card...</h4>
                <p id="flashcard-text-back" class="hidden text-body-sm text-slate-200 mt-3 bg-white/10 p-3.5 rounded-md backdrop-blur-md border border-white/10">Answer details...</p>
              </div>

              <div class="flex justify-between items-center font-mono text-xs">
                <button id="fc-prev-btn" class="px-4 py-2 bg-canvas-soft border border-hairline rounded-sm text-ink hover:bg-canvas-soft-2 transition cursor-pointer">← Previous</button>
                <span id="fc-counter" class="text-mute">Card 1 of 3</span>
                <button id="fc-next-btn" class="px-4 py-2 bg-primary text-on-primary rounded-sm hover:bg-black transition cursor-pointer">Next →</button>
              </div>
            </div>

            <!-- 4. Study Run Game View -->
            <div id="game-view" class="hidden space-y-4 flex-1 flex flex-col justify-between">
              <div class="p-4 bg-canvas-soft border border-hairline rounded flex items-center justify-between font-mono text-xs">
                <div>
                  <h4 class="text-ink font-semibold">🎮 Study Run: Kids AI Revision Arcade</h4>
                  <p class="text-mute">Answer AI questions correctly to gain stars ⭐</p>
                </div>
                <div class="text-right">
                  <span class="text-ink font-bold text-sm">Stars: <span id="game-stars" class="text-amber-500">120</span> ⭐</span>
                </div>
              </div>

              <div id="game-canvas-area" class="relative min-h-[240px] bg-gradient-to-br from-slate-950 via-zinc-900 to-black rounded-xl p-6 text-white flex flex-col justify-between border border-hairline shadow-level-4">
                <div class="flex justify-between items-center text-caption-mono text-slate-400">
                  <span>Level 1: AI Runner</span>
                  <span class="animate-pulse text-cyan font-bold">Speed: 2x</span>
                </div>

                <div id="game-prompt-box" class="my-auto text-center space-y-3">
                  <div class="text-4xl animate-bounce">🏃‍♂️💨</div>
                  <h5 id="game-q-text" class="text-display-sm text-white text-base max-w-md mx-auto">Loading game question...</h5>
                  <div id="game-options-container" class="flex justify-center gap-3 flex-wrap pt-2"></div>
                </div>

                <div id="game-feedback" class="text-center text-caption-mono text-cyan h-5 font-bold"></div>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Interactive JavaScript Engine -->
  <script is:inline>
    let currentMode = 'notes';
    let isRecording = false;
    let quizScore = 0;
    let currentQuizIdx = 0;
    let flashcardIdx = 0;
    let flashcardFlipped = false;
    let gameStars = 120;
    let currentGameIdx = 0;

    let aiQuizzes = [
      { q: "What is the primary objective of this lesson?", options: ["Understand core concepts", "Memorize dates", "Skip study", "Draw pictures"], answer: 0 },
      { q: "How do active recall quizzes aid long-term memory?", options: ["By testing key facts", "By making noise", "By sleeping", "By reading once"], answer: 0 }
    ];

    let aiFlashcards = [
      { front: "Core Subject Topic", back: "Key principles and fundamentals synthesized by KiddieNotes AI." },
      { front: "Study Method", back: "Active recall and spaced repetition for K-12 students." }
    ];

    let aiGameQuestions = [
      { q: "Is active review testing effective for school exams?", options: ["YES ✅ (Jump)", "NO ❌ (Duck)"], answer: 0, explanation: "Active testing boosts retention!" }
    ];

    // Load saved API Key from localStorage on page load (unified key)
    window.addEventListener('DOMContentLoaded', () => {
      const savedKey = localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_user_key') || localStorage.getItem('sheshaai_gemini_key') || '';
      if (savedKey) {
        document.getElementById('kiddie-api-key-input').value = savedKey;
        document.getElementById('key-status-badge').innerText = '⚡ Custom Key Active';
      }
    });

    // Save API Key button click — uses unified GEMINI_API_KEY
    document.getElementById('save-key-btn')?.addEventListener('click', () => {
      const val = document.getElementById('kiddie-api-key-input').value.trim();
      if (val) {
        localStorage.setItem('GEMINI_API_KEY', val);
        localStorage.setItem('sheshaai_user_key', val);
        localStorage.setItem('sheshaai_gemini_key', val);
        document.getElementById('key-status-badge').innerText = '⚡ Custom Key Saved & Active';
        // Dispatch event so Layout.astro status pill updates too
        window.dispatchEvent(new Event('api-key-updated'));
        alert('API Key saved successfully! KiddieNotes will now use your custom key for all requests.');
} else {
        localStorage.removeItem('GEMINI_API_KEY');
        localStorage.removeItem('sheshaai_user_key');
        localStorage.removeItem('sheshaai_gemini_key');
        document.getElementById('key-status-badge').innerText = '? Server Engine Ready';
        window.dispatchEvent(new Event('api-key-updated'));
      }
    });

    // Helper to call unified /api/chat server endpoint
    async function callKiddieAI(promptText) {
      const userKey = localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_user_key') || localStorage.getItem('sheshaai_gemini_key') || '';
      const openrouterKey = localStorage.getItem('sheshaai_openrouter_key') || '';
      
      const headers = {
        'Content-Type': 'application/json',
        'x-custom-key': userKey,
        'x-gemini-key': userKey,
        'x-openrouter-key': openrouterKey
      };

      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: headers,
        body: JSON.stringify({
          customKey: userKey,
          geminiKey: userKey,
          messages: [
            {
              role: 'system',
              content: 'You are KiddieNotes AI developed by SAURABH, an educational study assistant for K-12 students (Nursery to 12th Class). Deliver clear, precise, and accurate study notes.'
            },
            { role: 'user', content: promptText }
          ],
          mode: 'general'
        })
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.error?.message || `API error ${res.status}`);
      }

      const data = await res.json();
      return data.choices?.[0]?.message?.content || '';
    }

    // Helper to safely extract JSON array from model text
    function extractJSONArray(text) {
      try {
        const clean = text.replace(/```json/gi, '').replace(/```/g, '').trim();
        const start = clean.indexOf('[');
        const end = clean.lastIndexOf(']');
        if (start !== -1 && end !== -1) {
          return JSON.parse(clean.substring(start, end + 1));
        }
        return JSON.parse(clean);
      } catch (e) {
        return null;
      }
    }

    // Grade Filter Chips Click
    document.querySelectorAll('.grade-chip').forEach(chip => {
      chip.addEventListener('click', (e) => {
        document.querySelectorAll('.grade-chip').forEach(c => {
          c.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'active-grade');
          c.classList.add('bg-canvas-soft', 'text-body', 'border-hairline');
        });
        const target = e.currentTarget;
        target.classList.remove('bg-canvas-soft', 'text-body', 'border-hairline');
        target.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'active-grade');

        const grade = target.getAttribute('data-grade');
        const select = document.getElementById('tone-select');
        if (grade === 'nursery-5') select.value = 'nursery';
        else if (grade === '6-10') select.value = 'middle';
        else if (grade === '11-12') select.value = 'high';
      });
    });

    // Mode Selector Handler
    document.querySelectorAll('.mode-select-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.mode-select-btn').forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'active-mode');
          b.classList.add('bg-canvas-soft', 'text-ink', 'border-hairline');
        });
        const targetBtn = e.currentTarget;
        targetBtn.classList.remove('bg-canvas-soft', 'text-ink', 'border-hairline');
        targetBtn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'active-mode');
        currentMode = targetBtn.getAttribute('data-type');
      });
    });

    // Preset Video Buttons
    document.querySelectorAll('.demo-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        const topic = btn.getAttribute('data-topic');
        document.getElementById('yt-url-input').value = topic ? `${topic} (${url})` : url;
      });
    });

    // Mic Toggle
    document.getElementById('record-mic-btn')?.addEventListener('click', () => {
      isRecording = !isRecording;
      const micText = document.getElementById('mic-text');
      const micIcon = document.getElementById('mic-icon');
      if (isRecording) {
        micText.innerText = "Listening to Lecture... Click to Stop";
        micIcon.innerText = "🔴";
      } else {
        micText.innerText = "Start Classroom Voice Recording";
        micIcon.innerText = "🎙️";
      }
    });

    // Main Generate Button Click
    document.getElementById('generate-btn')?.addEventListener('click', async () => {
      const topicInput = document.getElementById('yt-url-input').value.trim() || 'General Science & Study Basics';
      const tone = document.getElementById('tone-select').value;
      const titleBadge = document.getElementById('output-title');
      const iconBadge = document.getElementById('output-badge-icon');

      const toneLabel = tone === 'nursery' ? 'Nursery/KG Kids (simple words, emojis)' : tone === 'high' ? 'Class 9-12 (Board exam concepts, formulas)' : 'Class 1-8 (Clear structured bullets)';

      // Hide views, show loader
      ['default-preview','notes-view','quiz-view','flashcard-view','game-view'].forEach(id => document.getElementById(id)?.classList.add('hidden'));
      const loadingView = document.getElementById('loading-view');
      loadingView.classList.remove('hidden');
      document.getElementById('loading-msg').innerText = `⚡ Transcribing & Generating KiddieNotes AI for ${toneLabel}...`;

      try {
        if (currentMode === 'notes') {
          titleBadge.innerText = "Generated Easy Notes";
          iconBadge.innerText = "📋";

          const prompt = `Create comprehensive educational study notes based on this video/topic: "${topicInput}". Target Grade Level: ${toneLabel}.\n\nProvide:\n1. A summary overview paragraph (3-4 sentences).\n2. 4-6 key bullet points explaining main facts.\n3. 3 key vocabulary terms with short definitions.`;
          const responseText = await callKiddieAI(prompt);

          document.getElementById('notes-topic-heading').innerText = `📌 ${topicInput.substring(0, 45)}`;
          document.getElementById('notes-summary-text').innerText = responseText;

          // Extract bullet lines
          const bulletList = document.getElementById('notes-bullets-list');
          bulletList.innerHTML = '';
          const lines = responseText.split('\n').filter(l => l.trim().startsWith('-') || l.trim().startsWith('*') || l.trim().match(/^\d+\./));
          if (lines.length > 0) {
            lines.slice(0, 6).forEach(line => {
              const li = document.createElement('li');
              li.className = "p-3 bg-canvas-soft rounded-md border border-hairline flex items-start gap-2.5 text-xs font-mono";
              li.innerHTML = `<span class="text-link font-bold text-sm">•</span><span>${line.replace(/^[-*\d.]+\s*/, '')}</span>`;
              bulletList.appendChild(li);
            });
          } else {
            bulletList.innerHTML = '<li class="p-3 bg-canvas-soft rounded-md border border-hairline text-xs font-mono">✨ Notes synthesized cleanly above by KiddieNotes AI.</li>';
          }

          loadingView.classList.add('hidden');
          document.getElementById('notes-view').classList.remove('hidden');

        } else if (currentMode === 'quiz') {
          titleBadge.innerText = "Interactive Revision Quiz";
          iconBadge.innerText = "📝";

          const prompt = `Generate 3 multiple-choice quiz questions based on: "${topicInput}". Target Grade: ${toneLabel}.\n\nReturn ONLY a valid JSON array of 3 objects with exact keys: "q" (question string), "options" (array of 4 string options), "answer" (index number 0-3 of the correct option). No extra text outside JSON.`;
          const raw = await callKiddieAI(prompt);
          const parsed = extractJSONArray(raw);

          if (parsed && Array.isArray(parsed) && parsed.length > 0) {
            aiQuizzes = parsed;
          }

          quizScore = 0;
          currentQuizIdx = 0;
          document.getElementById('quiz-score').innerText = 0;
          document.getElementById('quiz-total').innerText = aiQuizzes.length;
          document.getElementById('quiz-count-display').innerText = aiQuizzes.length;

          loadingView.classList.add('hidden');
          document.getElementById('quiz-view').classList.remove('hidden');
          renderQuizCard();

        } else if (currentMode === 'flashcard') {
          titleBadge.innerText = "3D Study Flashcards";
          iconBadge.innerText = "🃏";

          const prompt = `Generate 4 study flashcards based on: "${topicInput}". Target Grade: ${toneLabel}.\n\nReturn ONLY a valid JSON array of objects with keys: "front" (question or term) and "back" (answer or concise explanation). No extra text outside JSON.`;
          const raw = await callKiddieAI(prompt);
          const parsed = extractJSONArray(raw);

          if (parsed && Array.isArray(parsed) && parsed.length > 0) {
            aiFlashcards = parsed;
          }

          flashcardIdx = 0;
          loadingView.classList.add('hidden');
          document.getElementById('flashcard-view').classList.remove('hidden');
          renderFlashcard();

        } else if (currentMode === 'game') {
          titleBadge.innerText = "Study Run Game";
          iconBadge.innerText = "🏃";

          const prompt = `Generate 3 fun true/false or quick choice game questions for kids based on: "${topicInput}". Target Grade: ${toneLabel}.\n\nReturn ONLY a valid JSON array of objects with keys: "q" (question string), "options" (array of 2 string options e.g. ["YES ✅ (Jump)", "NO ❌ (Duck)"]), "answer" (0 or 1 index), "explanation" (short string). No extra text.`;
          const raw = await callKiddieAI(prompt);
          const parsed = extractJSONArray(raw);

          if (parsed && Array.isArray(parsed) && parsed.length > 0) {
            aiGameQuestions = parsed;
          }

          currentGameIdx = 0;
          loadingView.classList.add('hidden');
          document.getElementById('game-view').classList.remove('hidden');
          renderGameQuestion();
        }

      } catch (err) {
        loadingView.classList.add('hidden');
        document.getElementById('default-preview').classList.remove('hidden');
        alert(`KiddieNotes Generation Error: ${err.message}`);
      }
    });

    // Quiz Render Function
    function renderQuizCard() {
      const qObj = aiQuizzes[currentQuizIdx];
      if (!qObj) return;
      document.getElementById('quiz-curr-idx').innerText = currentQuizIdx + 1;
      document.getElementById('quiz-question-text').innerText = `${currentQuizIdx + 1}. ${qObj.q}`;
      
      const optBox = document.getElementById('quiz-options-box');
      optBox.innerHTML = '';

      (qObj.options || []).forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left p-3.5 rounded-md border border-hairline text-xs font-mono hover:border-hairline-strong hover:bg-canvas-soft transition cursor-pointer";
        btn.innerText = opt;
        btn.onclick = () => {
          if (idx === qObj.answer) {
            btn.className = "w-full text-left p-3.5 rounded-md border border-cyan-deep bg-cyan-soft text-ink text-xs font-mono font-bold";
            quizScore++;
            document.getElementById('quiz-score').innerText = quizScore;
          } else {
            btn.className = "w-full text-left p-3.5 rounded-md border border-error bg-error-soft text-error-deep text-xs font-mono font-bold";
          }
          setTimeout(() => {
            if (currentQuizIdx < aiQuizzes.length - 1) {
              currentQuizIdx++;
              renderQuizCard();
            }
          }, 900);
        };
        optBox.appendChild(btn);
      });
    }

    // Flashcard Render Function
    function renderFlashcard() {
      const card = aiFlashcards[flashcardIdx] || { front: "End of Deck", back: "Restarting..." };
      document.getElementById('flashcard-text-front').innerText = card.front;
      document.getElementById('flashcard-text-back').innerText = card.back;
      document.getElementById('fc-counter').innerText = `Card ${flashcardIdx + 1} of ${aiFlashcards.length}`;
      document.getElementById('fc-term-tag').innerText = `Term ${flashcardIdx + 1} of ${aiFlashcards.length}`;
      
      document.getElementById('flashcard-text-back').classList.add('hidden');
      flashcardFlipped = false;
    }

    document.getElementById('flashcard-element')?.addEventListener('click', () => {
      flashcardFlipped = !flashcardFlipped;
      if (flashcardFlipped) {
        document.getElementById('flashcard-text-back').classList.remove('hidden');
      } else {
        document.getElementById('flashcard-text-back').classList.add('hidden');
      }
    });

    document.getElementById('fc-next-btn')?.addEventListener('click', () => {
      if (flashcardIdx < aiFlashcards.length - 1) {
        flashcardIdx++;
        renderFlashcard();
      }
    });

    document.getElementById('fc-prev-btn')?.addEventListener('click', () => {
      if (flashcardIdx > 0) {
        flashcardIdx--;
        renderFlashcard();
      }
    });

    // Game Question Render
    function renderGameQuestion() {
      const gObj = aiGameQuestions[currentGameIdx] || aiGameQuestions[0];
      document.getElementById('game-q-text').innerText = gObj.q;
      const container = document.getElementById('game-options-container');
      container.innerHTML = '';

      (gObj.options || ["YES ✅ (Jump)", "NO ❌ (Duck)"]).forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = `px-6 py-2.5 ${idx === 0 ? 'bg-link' : 'bg-rose-600'} text-white rounded-md text-xs font-mono font-bold hover:opacity-90 transition cursor-pointer`;
        btn.innerText = opt;
        btn.onclick = () => {
          const feedback = document.getElementById('game-feedback');
          if (idx === gObj.answer) {
            gameStars += 20;
            document.getElementById('game-stars').innerText = gameStars;
            feedback.innerText = `✨ Correct! ${gObj.explanation || '+20 Stars ⭐'}`;
          } else {
            feedback.innerText = `💥 Oops! ${gObj.explanation || 'Duck next time!'}`;
          }
          setTimeout(() => {
            if (currentGameIdx < aiGameQuestions.length - 1) {
              currentGameIdx++;
              renderGameQuestion();
            }
          }, 1200);
        };
        container.appendChild(btn);
      });
    }

    // AI Chat Teacher Q&A Box
    document.getElementById('ai-chat-btn')?.addEventListener('click', async () => {
      const input = document.getElementById('ai-chat-input');
      const q = input.value.trim();
      const respBox = document.getElementById('ai-chat-response');
      if (!q) return;

      respBox.classList.remove('hidden');
      respBox.innerText = '🤔 Kiddie Teacher is thinking...';

      try {
        const topic = document.getElementById('yt-url-input').value.trim() || 'this lesson';
        const tone = document.getElementById('tone-select').value;
        const answer = await callKiddieAI(`The student is asking about topic "${topic}": "${q}". Answer simply for grade level ${tone}.`);
        respBox.innerText = `🤖 Kiddie Teacher: ${answer}`;
        input.value = '';
      } catch (err) {
        respBox.innerText = `⚠️ Error: ${err.message}`;
      }
    });

    // Speech Synthesis Read Aloud
    document.getElementById('read-aloud-btn')?.addEventListener('click', () => {
      const text = document.getElementById('notes-summary-text').innerText;
      if ('speechSynthesis' in window && text) {
        window.speechSynthesis.cancel();
        const msg = new SpeechSynthesisUtterance(text);
        window.speechSynthesis.speak(msg);
      }
    });

    // Copy Button
    document.getElementById('copy-btn')?.addEventListener('click', () => {
      const text = document.getElementById('notes-summary-text').innerText;
      if (text) {
        navigator.clipboard.writeText(text);
        const btn = document.getElementById('copy-btn');
        btn.innerText = 'Copied! ✓';
        setTimeout(() => btn.innerText = '📋 Copy', 2000);
      }
    });

    // Export Button
    document.getElementById('download-btn')?.addEventListener('click', () => {
      const text = document.getElementById('notes-summary-text').innerText;
      if (text) {
        const blob = new Blob([text], { type: 'text/markdown' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'KiddieNotes_AI_Study_Pack.md';
        a.click();
      }
    });
  </script>
</Layout>
