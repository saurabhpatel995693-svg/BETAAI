        `Unique Topics Covered: ${data.topics.length}`,
        `Last Activity: ${data.last || 'N/A'}`,
        '',
        '--- Topics Studied ---',
        ...(data.topics.length ? data.topics.map((t, i) => `${i+1}. ${t}`) : ['(No topics recorded yet)']),
        '',
        '--- Device Info ---',
        `Browser: ${navigator.userAgent.substring(0, 80)}`,
        `Platform: ${navigator.platform || 'Unknown'}`,
        `Language: ${navigator.language}`,
        '',
        '========================================',
        '  Made by SAURABH — SHESHAAI Platform',
        '========================================'
      ].join('\n');

      const blob = new Blob([report], { type: 'text/plain' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `KiddieNotes_Report_${new Date().toISOString().slice(0,10)}.txt`;
      a.click();
      document.getElementById('report-status').classList.remove('hidden');
      document.getElementById('report-status').innerText = '✅ Report downloaded successfully!';
      setTimeout(() => document.getElementById('report-status').classList.add('hidden'), 3000);
    });

    // Custom premium toast notifications for KiddieNotes
    function toast(msg, type='info') {
      const el = document.createElement('div');
      el.className = `p-3 rounded-md text-xs font-mono border shadow-level-3 animate-fade-up ${
        type === 'success' ? 'bg-emerald-600/10 text-emerald-500 border-emerald-500/20' :
        type === 'error' ? 'bg-rose-600/10 text-rose-500 border-rose-500/20' :
        type === 'warning' ? 'bg-amber-600/10 text-amber-500 border-amber-500/20' :
        'bg-zinc-800 text-zinc-300 border-zinc-700'
      }`;
      el.textContent = msg;
      const box = document.getElementById('toast-box');
      if (box) {
        box.appendChild(el);
        setTimeout(() => el.remove(), 4000);
      } else {
        console.log(`[TOAST - ${type}]: ${msg}`);
      }
    }

    // Initialize progress on load
    renderProgress();
  </script>
  <div id="toast-box" class="fixed bottom-6 right-6 z-50 space-y-2 max-w-xs"></div>
</Layout>
