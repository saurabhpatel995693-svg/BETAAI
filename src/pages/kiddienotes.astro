              li.innerHTML = `<span class="text-link font-bold text-sm">•</span><span>${line.replace(/^[-*\d.]+\s*/, '')}</span>`;
              bulletList.appendChild(li);
            });
          } else {
            bulletList.innerHTML = '<li class="p-3 bg-canvas-soft rounded-md border border-hairline text-xs font-mono">✨ Notes synthesized cleanly above by KiddieNotes AI.</li>';
          }

          loadingView.classList.add('hidden');
          document.getElementById('notes-view').classList.remove('hidden');
          recordProgress(topicInput, 'Notes');

        } else if (currentMode === 'quiz') {
          titleBadge.innerText = "Interactive Revision Quiz";
          iconBadge.innerText = "📝";

          const prompt = `Generate EXACTLY 20 multiple-choice quiz questions. CRITICAL: Base ALL questions ENTIRELY on the actual content below (between """ markers), NOT on general knowledge or the topic name. Each question must test understanding of specific details from the actual transcript/content provided.

Topic reference: "${actualTopic}"
Target Grade: ${toneLabel}.${transcriptContext}${fileContext}

Return ONLY a valid JSON array of EXACTLY 20 objects with keys: "q" (question string), "options" (array of 4 string options), "answer" (index number 0-3 of correct option). No extra text outside the JSON array. Make questions progressively harder — first 5 easy, next 10 medium, last 5 advanced.`;
          const raw = await callKiddieAI(prompt);
          const parsed = extractJSONArray(raw);

          if (parsed && Array.isArray(parsed) && parsed.length > 0) {
            aiQuizzes = parsed;
          }

          quizScore = 0;
          currentQuizIdx = 0;
          document.getElementById('quiz-score').innerText = 0;
          document.getElementById('quiz-total').innerText = aiQuizzes.length;
          document.getElementById('quiz-count-display').innerText = aiQuizzes.length;

          loadingView.classList.add('hidden');
          document.getElementById('quiz-view').classList.remove('hidden');
          renderQuizCard();
          recordProgress(topicInput, 'Quiz');

        } else if (currentMode === 'flashcard') {
          titleBadge.innerText = "3D Study Flashcards";
          iconBadge.innerText = "🃏";

          const prompt = `Generate EXACTLY 20 study flashcards. CRITICAL: Base ALL flashcards ENTIRELY on the actual content below (between """ markers), NOT on general knowledge or assumptions about the topic. Every flashcard must derive from specific facts/statements in the content provided.

Topic reference: "${actualTopic}"
Target Grade: ${toneLabel}.${transcriptContext}${fileContext}

Return ONLY a valid JSON array of EXACTLY 20 objects with keys: "front" (question or term) and "back" (answer or concise explanation from the content). Cover the topic comprehensively from basics to advanced concepts. No extra text outside the JSON array.`;
          const raw = await callKiddieAI(prompt);
          const parsed = extractJSONArray(raw);

          if (parsed && Array.isArray(parsed) && parsed.length > 0) {
            aiFlashcards = parsed;
          }

          flashcardIdx = 0;
          loadingView.classList.add('hidden');
          document.getElementById('flashcard-view').classList.remove('hidden');
          renderFlashcard();
          recordProgress(topicInput, 'Flashcard');

        } else if (currentMode === 'game') {
          titleBadge.innerText = "Study Run Game";
          iconBadge.innerText = "🏃";

          const prompt = `Generate EXACTLY 20 fun true/false or quick-choice game questions for kids. CRITICAL: Base ALL questions ENTIRELY on the actual content below (between """ markers), NOT on general knowledge. The questions must test recall of specific facts from the provided content.

Topic reference: "${actualTopic}"
Target Grade: ${toneLabel}.${transcriptContext}${fileContext}

Return ONLY a valid JSON array of EXACTLY 20 objects with keys: "q" (question string from content), "options" (array of 2 string options e.g. ["YES ✅ (Jump)", "NO ❌ (Duck)"]), "answer" (0 or 1 index), "explanation" (short learning point string from the content). Make questions progressively harder. No extra text outside the JSON array.`;
          const raw = await callKiddieAI(prompt);
          const parsed = extractJSONArray(raw);

          if (parsed && Array.isArray(parsed) && parsed.length > 0) {
            aiGameQuestions = parsed;
          }

          currentGameIdx = 0;
          loadingView.classList.add('hidden');
          document.getElementById('game-view').classList.remove('hidden');
          renderGameQuestion();
          recordProgress(topicInput, 'Game');
        } else if (currentMode === 'worksheet') {
          titleBadge.innerText = "Practice Worksheet";
          iconBadge.innerText = "📝";

          const prompt = `Create a comprehensive practice worksheet for students. CRITICAL: Base ALL questions ENTIRELY on the actual content below (between """ markers), NOT on general knowledge or assumptions. Every question must derive from specific information in the provided transcript/content.

Topic reference: "${actualTopic}"
Target Grade: ${toneLabel}.${transcriptContext}${fileContext}

The worksheet MUST include:
1. A title and clear instructions
2. EXACTLY 20 questions of mixed types based on the content: 5 fill-in-the-blanks, 5 short-answer, 5 matching/true-false, 5 word problems or application questions
3. A separate "--- ANSWER KEY ---" section at the bottom with correct answers

Format with markdown headings. Make questions age-appropriate and progressively harder.`;
