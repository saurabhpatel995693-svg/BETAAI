      const toneLabel = tone === 'nursery' ? 'Nursery/KG Kids (simple words, emojis)' : tone === 'high' ? 'Class 9-12 (Board exam concepts, formulas)' : 'Class 1-8 (Clear structured bullets)';

      // Reset default preview to original state (in case a previous error changed it)
      const defaultPreviewH4 = document.querySelector('#default-preview h4');
      const defaultPreviewP = document.querySelector('#default-preview p');
      if (defaultPreviewH4) defaultPreviewH4.innerText = 'Ready to convert YouTube to Notes!';
      if (defaultPreviewP) defaultPreviewP.innerText = 'Enter your YouTube URL or lesson topic, choose your grade level, and click "Generate KiddieNotes AI Pack".';

      // Hide views, show loader
      ['default-preview','notes-view','quiz-view','flashcard-view','game-view','worksheet-view'].forEach(id => document.getElementById(id)?.classList.add('hidden'));
      const loadingView = document.getElementById('loading-view');
