            let usage = { date: today, count: 0 };
            try {
              const raw = localStorage.getItem('sheshaai_daily_usage');
              if (raw) {
                const parsed = JSON.parse(raw);
                if (parsed.date === today) usage = parsed;
              }
            } catch {}
            usage.count += 1;
            localStorage.setItem('sheshaai_daily_usage', JSON.stringify(usage));
            window.dispatchEvent(new Event('quota-updated'));
          }

        }

      } catch (err) {
        loadingView.classList.add('hidden');
        document.getElementById('default-preview').classList.remove('hidden');
        
        // Standardized user-friendly error formatting
        const rawMsg = err.message || '';
        let icon = '💡';
        let title = 'Processing Issue';
        let friendlyMsg = 'Request complete karne me dikkat aayi.';
        let actionTip = 'Kripya topic check karke dobara try karein.';

        if (rawMsg.includes('API key') || rawMsg.includes('api key') || rawMsg.includes('401') || rawMsg.includes('403')) {
          icon = '🔑';
          title = 'API Key Problem';
          friendlyMsg = 'Gemini API Key me problem hai.';
          actionTip = 'Upar "API Key" section me apna sahi key daalein ya server pool use karein.';
        } else if (rawMsg.includes('429') || rawMsg.includes('rate') || rawMsg.includes('limit')) {
          icon = '⏳';
          title = 'Rate Limit Exceeded';
          friendlyMsg = 'Bahut saare requests aaye hain.';
          actionTip = '2-3 minute ruk kar dobara try karein, ya custom API Key enter karein.';
        } else if (rawMsg.includes('500') || rawMsg.includes('503') || rawMsg.includes('fetch')) {
          icon = '🛠️';
          title = 'Server Temporarily Busy';
          friendlyMsg = 'AI backend response nahi de pa raha hai.';
          actionTip = 'Kripya thodi der baad dobara try karein.';
        }

        alert(`${icon} ${title}\n\n${friendlyMsg}\n\n💡 Tip: ${actionTip}`);
      }
