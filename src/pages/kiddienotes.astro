    // ── Progress Tracker ──
    function loadProgress() {
      try {
        return JSON.parse(localStorage.getItem('kiddienotes_progress') || '{"total":0,"topics":[],"last":""}');
      } catch { return { total: 0, topics: [], last: '' }; }
    }

    function saveProgress(data) {
      localStorage.setItem('kiddienotes_progress', JSON.stringify(data));
    }

    function recordProgress(topic, mode) {
      const data = loadProgress();
      data.total++;
      if (topic && !data.topics.includes(topic)) {
        data.topics.push(topic);
      }
      data.last = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      saveProgress(data);
      renderProgress();
    }

    function renderProgress() {
      const data = loadProgress();
      document.getElementById('progress-total').innerText = data.total;
      document.getElementById('progress-topics').innerText = data.topics.length;
      document.getElementById('progress-last').innerText = data.last || '—';
      const list = document.getElementById('progress-topics-list');
      list.innerHTML = data.topics.slice().reverse().slice(0, 10).map(t =>
        `<div class="flex items-center gap-1.5 text-[11px]"><span class="text-emerald-500">✓</span> ${t.substring(0, 40)}</div>`
      ).join('');
    }

    document.getElementById('reset-progress-btn')?.addEventListener('click', () => {
      if (confirm('Reset all progress tracking data?')) {
        localStorage.removeItem('kiddienotes_progress');
        renderProgress();
      }
    });

    // ── Parent/Teacher Report ──
    document.getElementById('download-report-btn')?.addEventListener('click', () => {
      const data = loadProgress();
      const report = [
        '========================================',
        '  KiddieNotes — Parent/Teacher Report',
        '  Generated: ' + new Date().toLocaleString('en-IN'),
        '========================================',
        '',
