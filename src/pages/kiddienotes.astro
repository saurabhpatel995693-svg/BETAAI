        <button id="download-report-btn" class="px-4 py-2 bg-primary text-on-primary rounded-sm text-xs font-mono font-semibold hover:bg-black transition cursor-pointer">
          📥 Download Report
        </button>
        <div id="report-status" class="mt-2 text-[10px] font-mono text-mute hidden"></div>
      </div>
    </div>
  </section>

  <!-- Interactive JavaScript Engine -->
  <script is:inline>
    let currentMode = 'notes';
    let quizScore = 0;
    let currentQuizIdx = 0;
    let flashcardIdx = 0;
    let flashcardFlipped = false;
    let gameStars = 120;
    let currentGameIdx = 0;
    let uploadedFileContent = '';
    let uploadedFileName = '';

    // ── Load PDF.js from CDN dynamically (for PDF text extraction) ──
    function loadPDFJS() {
      return new Promise((resolve, reject) => {
        if (window.pdfjsLib) {
          resolve(window.pdfjsLib);
          return;
        }
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
        script.onload = () => {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
          resolve(window.pdfjsLib);
        };
        script.onerror = () => reject(new Error('PDF.js library could not be loaded. Check internet connection.'));
        document.head.appendChild(script);
      });
    }

    // ── Extract text from PDF using PDF.js ──
    async function extractPDFText(arrayBuffer) {
      const pdfjsLib = await loadPDFJS();
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      let fullText = '';
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        const pageText = content.items.map(item => item.str).join(' ');
        fullText += `[Page ${i}]\n${pageText}\n\n`;
      }
      return fullText.trim();
    }

    let aiQuizzes = [
      { q: "What is the primary objective of this lesson?", options: ["Understand core concepts", "Memorize dates", "Skip study", "Draw pictures"], answer: 0 },
      { q: "How do active recall quizzes aid long-term memory?", options: ["By testing key facts", "By making noise", "By sleeping", "By reading once"], answer: 0 }
    ];

    let aiFlashcards = [
      { front: "Core Subject Topic", back: "Key principles and fundamentals synthesized by KiddieNotes AI." },
      { front: "Study Method", back: "Active recall and spaced repetition for K-12 students." }
    ];

    let aiGameQuestions = [
      { q: "Is active review testing effective for school exams?", options: ["YES ✅ (Jump)", "NO ❌ (Duck)"], answer: 0, explanation: "Active testing boosts retention!" }
    ];

    // ── UNIFIED SINGLE API KEY SYNCHRONIZATION FOR KIDDIENOTES ──
    // Ensures that the inline section input and status badge stay 100% in sync with GEMINI_API_KEY
    function syncKiddieApiKeyUI() {
      const savedKey = localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_user_key') || localStorage.getItem('sheshaai_gemini_key') || localStorage.getItem('betaai_custom_key') || '';
      const inputEl = document.getElementById('kiddie-api-key-input');
      const badgeEl = document.getElementById('key-status-badge');
      
      if (inputEl) {
        inputEl.value = savedKey;
      }
      if (badgeEl) {
        if (savedKey && savedKey.trim().length > 0) {
          badgeEl.innerText = '⚡ Custom Key Active';
          badgeEl.className = 'text-[11px] font-mono px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 font-medium';
        } else {
          badgeEl.innerText = '⚡ Server Engine Ready';
          badgeEl.className = 'text-[11px] font-mono px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-600 border border-cyan-500/20 font-medium';
        }
      }
    }

    // Synchronize on DOMContentLoaded, api-key-updated, and browser storage events
    window.addEventListener('DOMContentLoaded', () => {
      syncKiddieApiKeyUI();
      updateGenerateBtnState();
      updateStepIndicator(1);

      // Read URL params for shareable study links
      const urlParams = new URLSearchParams(window.location.search);
      const urlTopic = urlParams.get('topic');
      const urlGrade = urlParams.get('grade');
      const urlMode = urlParams.get('mode');

      if (urlTopic) {
        const topicInput = document.getElementById('yt-url-input');
        if (topicInput) {
          topicInput.value = urlTopic;
          topicInput.dispatchEvent(new Event('input'));
        }
      }
      if (urlGrade) {
        const select = document.getElementById('tone-select');
        if (select) select.value = urlGrade;
      }
      if (urlMode) {
        const modeBtn = document.querySelector(`.mode-select-btn[data-type="${urlMode}"]`);
        if (modeBtn) (modeBtn as HTMLElement).click();
      }
    });
    window.addEventListener('api-key-updated', syncKiddieApiKeyUI);
    window.addEventListener('storage', syncKiddieApiKeyUI);

    // ── Step indicator update helper ──
    function updateStepIndicator(step) {
      document.querySelectorAll('.step-active, .step-inactive').forEach(el => {
        el.classList.remove('step-active');
        el.classList.add('step-inactive');
        el.className = el.className.replace(/bg-primary text-on-primary/g, 'bg-canvas-soft text-body');
      });
      const activeEl = document.querySelector(`[data-step="${step}"]`);
      if (activeEl) {
        activeEl.classList.remove('step-inactive', 'bg-canvas-soft', 'text-body', 'border-hairline');
        activeEl.classList.add('step-active', 'bg-primary', 'text-on-primary', 'border-primary');
      }
    }

    // ── Generate button state management ──
    function updateGenerateBtnState() {
      const topicVal = document.getElementById('yt-url-input').value.trim();
      const hasTopic = topicVal.length > 0;
      const hasFormat = currentMode !== null && currentMode !== undefined;
      const btn = document.getElementById('generate-btn');
      if (hasTopic && hasFormat) {
        btn.style.opacity = '1';
        btn.style.pointerEvents = 'auto';
        btn.style.cursor = 'pointer';
        btn.title = '';
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
      } else {
        btn.style.opacity = '0.5';
        btn.style.pointerEvents = 'none';
        btn.style.cursor = 'not-allowed';
        btn.title = 'Please enter a topic and select a study format first';
      }
    }

    // Listen for topic input changes to update step + button state
    document.getElementById('yt-url-input')?.addEventListener('input', () => {
      updateGenerateBtnState();
      if (document.getElementById('yt-url-input').value.trim()) {
        updateStepIndicator(2);
      } else {
        updateStepIndicator(1);
      }
    });

    // Save/Clear API Key button click — uses unified GEMINI_API_KEY
    document.getElementById('save-key-btn')?.addEventListener('click', () => {
      const val = document.getElementById('kiddie-api-key-input').value.trim();
      if (val) {
        localStorage.setItem('GEMINI_API_KEY', val);
        localStorage.setItem('sheshaai_user_key', val);
        localStorage.setItem('sheshaai_gemini_key', val);
        localStorage.setItem('betaai_custom_key', val);
        window.dispatchEvent(new Event('api-key-updated'));
        alert('API Key saved successfully! KiddieNotes will now use your custom key for all requests.');
      } else {
        localStorage.removeItem('GEMINI_API_KEY');
        localStorage.removeItem('sheshaai_user_key');
        localStorage.removeItem('sheshaai_gemini_key');
        localStorage.removeItem('betaai_custom_key');
        window.dispatchEvent(new Event('api-key-updated'));
        alert('Custom API Key cleared. KiddieNotes will use the server engine pool.');
      }
    });

    // ── YouTube transcript fetcher ──
    async function fetchYouTubeTranscript(url) {
      try {
        const res = await fetch('/api/transcript', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          return { error: err.error || 'No transcript available' };
        }
        return await res.json();
      } catch (err) {
        return { error: `Transcript fetch failed: ${err.message}` };
      }
    }

    function isYouTubeUrl(text) {
      return /(youtube\.com|youtu\.be)/i.test(text);
    }

    // Helper to call unified /api/chat server endpoint
    async function callKiddieAI(promptText) {
      const userKey = localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_user_key') || localStorage.getItem('sheshaai_gemini_key') || '';
      const openrouterKey = localStorage.getItem('sheshaai_openrouter_key') || '';
      
      // Only send key headers when keys are genuinely non-empty
      const headers = {
        'Content-Type': 'application/json',
        'x-openrouter-key': openrouterKey
      };
      if (userKey && userKey.trim().length > 0) {
        headers['x-custom-key'] = userKey.trim();
        headers['x-gemini-key'] = userKey.trim();
      }

      const bodyPayload = {
        messages: [
          {
            role: 'system',
            content: 'You are KiddieNotes AI developed by SAURABH, an educational study assistant for K-12 students (Nursery to 12th Class). Deliver clear, precise, and accurate study notes.'
          },
          { role: 'user', content: promptText }
        ],
        mode: 'general'
      };
      // Only include customKey/geminiKey in body when non-empty
      if (userKey && userKey.trim().length > 0) {
        bodyPayload.customKey = userKey.trim();
        bodyPayload.geminiKey = userKey.trim();
      }

      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: headers,
        body: JSON.stringify(bodyPayload)
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.error?.message || `API error ${res.status}`);
      }

      const data = await res.json();
      return data.choices?.[0]?.message?.content || '';
    }

    // Helper to safely extract JSON array from model text
    function extractJSONArray(text) {
      try {
        const clean = text.replace(/```json/gi, '').replace(/```/g, '').trim();
        const start = clean.indexOf('[');
        const end = clean.lastIndexOf(']');
        if (start !== -1 && end !== -1) {
          return JSON.parse(clean.substring(start, end + 1));
        }
        return JSON.parse(clean);
      } catch (e) {
        return null;
      }
    }

    // Grade Filter Chips Click
    document.querySelectorAll('.grade-chip').forEach(chip => {
      chip.addEventListener('click', (e) => {
        document.querySelectorAll('.grade-chip').forEach(c => {
          c.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'active-grade');
          c.classList.add('bg-canvas-soft', 'text-body', 'border-hairline');
        });
        const target = e.currentTarget;
        target.classList.remove('bg-canvas-soft', 'text-body', 'border-hairline');
        target.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'active-grade');

        const grade = target.getAttribute('data-grade');
        const select = document.getElementById('tone-select');
        if (grade === 'nursery-5') select.value = 'nursery';
        else if (grade === '6-10') select.value = 'middle';
        else if (grade === '11-12') select.value = 'high';
      });
    });

    // Mode Selector Handler
    document.querySelectorAll('.mode-select-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.mode-select-btn').forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'active-mode');
          b.classList.add('bg-canvas-soft', 'text-ink', 'border-hairline');
        });
        const targetBtn = e.currentTarget;
        targetBtn.classList.remove('bg-canvas-soft', 'text-ink', 'border-hairline');
        targetBtn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'active-mode');
        currentMode = targetBtn.getAttribute('data-type');
        updateStepIndicator(3);
        updateGenerateBtnState();
      });
    });

    // Preset Video Buttons
    document.querySelectorAll('.demo-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        const topic = btn.getAttribute('data-topic');
        document.getElementById('yt-url-input').value = topic ? `${topic} (${url})` : url;
        // Manually trigger input event so button state + step update
        document.getElementById('yt-url-input').dispatchEvent(new Event('input'));
      });
    });

    // ── File Upload Handling ──
    document.getElementById('file-upload-btn')?.addEventListener('click', () => {
      document.getElementById('file-upload-input').click();
    });

    document.getElementById('file-upload-input')?.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      uploadedFileName = file.name;
      const maxSize = 10 * 1024 * 1024; // 10MB
      if (file.size > maxSize) {
        document.getElementById('file-upload-status').classList.remove('hidden');
        document.getElementById('file-upload-status').innerText = '⚠️ File too large (max 10MB)';
        document.getElementById('file-upload-status').className = 'mt-1 text-[10px] font-mono text-error';
        return;
      }
      document.getElementById('file-upload-status').className = 'mt-1 text-[10px] font-mono text-emerald-600';
      document.getElementById('file-upload-status').classList.remove('hidden');
      document.getElementById('file-upload-status').innerText = '📖 Reading file...';

      const isPDF = file.name.toLowerCase().endsWith('.pdf');

      if (isPDF) {
        // ── PDF file: use PDF.js for proper text extraction ──
        try {
          const arrayBuffer = await new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result);
            reader.onerror = () => reject(new Error('Could not read PDF file'));
            reader.readAsArrayBuffer(file);
          });
          const extractedText = await extractPDFText(arrayBuffer);
          uploadedFileContent = extractedText.substring(0, 8000);
          const charCount = uploadedFileContent.length;
          document.getElementById('file-upload-text').innerText = `📄 ${file.name} (${Math.round(file.size/1024)}KB)`;
          document.getElementById('file-upload-status').innerText = `✅ PDF text extracted — ${charCount} characters`;
          document.getElementById('file-clear-btn').classList.remove('hidden');
        } catch (err) {
          document.getElementById('file-upload-status').innerText = `❌ PDF text extraction failed: ${err.message}`;
          document.getElementById('file-upload-status').className = 'mt-1 text-[10px] font-mono text-error';
          return;
        }
      } else {
        // ── Non-PDF file: read as text ──
        const reader = new FileReader();
        const text = await new Promise((resolve, reject) => {
          reader.onload = (ev) => resolve(ev.target.result);
          reader.onerror = () => reject(new Error('Could not read file'));
          reader.readAsText(file);
        });
        uploadedFileContent = text.substring(0, 8000);
        document.getElementById('file-upload-text').innerText = `📄 ${file.name} (${Math.round(file.size/1024)}KB)`;
        document.getElementById('file-upload-status').innerText = `✅ File loaded — ${uploadedFileContent.length} characters extracted`;
        document.getElementById('file-clear-btn').classList.remove('hidden');
      }

      // Auto-fill topic
      const currentTopic = document.getElementById('yt-url-input').value;
      if (!currentTopic || currentTopic === 'https://youtu.be/E_4gRy4O03w') {
        document.getElementById('yt-url-input').value = `Study material: ${file.name.replace(/\.[^/.]+$/, '')}`;
        document.getElementById('yt-url-input').dispatchEvent(new Event('input'));
      }
    });

    document.getElementById('file-clear-btn')?.addEventListener('click', () => {
      uploadedFileContent = '';
      uploadedFileName = '';
      document.getElementById('file-upload-input').value = '';
      document.getElementById('file-upload-text').innerText = 'Choose PDF, text file, or image';
      document.getElementById('file-upload-status').classList.add('hidden');
      document.getElementById('file-clear-btn').classList.add('hidden');
    });

    // Voice Recording Variables
    let mediaRecorder = null;
    let audioChunks = [];
    let recognition = null;
    let isRecording = false;
    let recordingTimer = null;
    let recordingSeconds = 0;
    let speechResultAccumulated = '';
    let micStream = null;

    function formatTime(sec) {
      const m = Math.floor(sec / 60).toString().padStart(2, '0');
      const s = (sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    document.getElementById('record-mic-btn')?.addEventListener('click', async () => {
      if (isRecording) {
        await stopRecording();
      } else {
        await startRecording();
      }
    });

    async function startRecording() {
      const micText = document.getElementById('mic-text');
      const micIcon = document.getElementById('mic-icon');
      const statusEl = document.getElementById('file-upload-status');
      const micBtn = document.getElementById('record-mic-btn');

      audioChunks = [];
      recordingSeconds = 0;
      speechResultAccumulated = '';

      try {
        micStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch (err) {
        console.error('[MIC ACCESS DENIED/ERROR]:', err);
        if (statusEl) {
          statusEl.classList.remove('hidden');
          statusEl.className = 'mt-1 text-[10px] font-mono text-error';
          statusEl.innerText = '⚠️ Microphone access denied / not found. Please enable mic permissions or type your topic directly. (माइक्रोफ़ोन एक्सेस नहीं मिला, कृपया अनुमति दें या सीधे टॉपिक लिखें)';
        }
        toast('Microphone access denied / not found', 'error');
        return;
      }

      isRecording = true;
      micBtn.classList.remove('bg-rose-600', 'hover:bg-rose-700');
      micBtn.classList.add('bg-rose-800', 'animate-pulse');
      micText.innerText = 'Stop Recording (00:00)';
      micIcon.innerText = '🔴';

      if (statusEl) {
        statusEl.classList.remove('hidden');
        statusEl.className = 'mt-1 text-[10px] font-mono text-rose-600 animate-pulse';
        statusEl.innerText = '🎙️ Recording live classroom audio... Speak now.';
      }

      // Initialize MediaRecorder (background audio backup)
      mediaRecorder = new MediaRecorder(micStream, { mimeType: 'audio/webm' });
      mediaRecorder.ondataavailable = e => {
        if (e.data && e.data.size > 0) {
          audioChunks.push(e.data);
        }
      };
      mediaRecorder.start(1000);

      // Start timer
      recordingTimer = setInterval(() => {
        recordingSeconds++;
        micText.innerText = `Stop Recording (${formatTime(recordingSeconds)})`;
        if (recordingSeconds >= 600) { // 10 minutes limit
          stopRecording();
        }
      }, 1000);

      // Layer 1: Browser Web Speech API
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (SpeechRecognition) {
        try {
          recognition = new SpeechRecognition();
          recognition.continuous = true;
          recognition.interimResults = true;
          recognition.lang = document.getElementById('mic-lang-select').value;

          recognition.onresult = e => {
            let interimTranscript = '';
            let finalTranscript = '';
            for (let i = e.resultIndex; i < e.results.length; ++i) {
              if (e.results[i].isFinal) {
                finalTranscript += e.results[i][0].transcript;
              } else {
                interimTranscript += e.results[i][0].transcript;
              }
            }
            if (finalTranscript) {
              speechResultAccumulated += finalTranscript + ' ';
            }
            if (statusEl && isRecording) {
              statusEl.innerText = `🎙️ [Layer 1 Live]: ${speechResultAccumulated}${interimTranscript}`;
            }
          };

          recognition.onerror = err => {
            console.warn('[SPEECH RECOGNITION ERROR] Handled, fallback to cloud if needed:', err);
          };

          recognition.start();
        } catch (e) {
          console.warn('[SPEECH RECOGNITION START FAILED] Handled:', e.message);
        }
      } else {
        console.log('[SPEECH RECOGNITION] Not supported in this browser. Will fallback to Groq Whisper/Gemini.');
      }
    }

    async function stopRecording() {
      const micText = document.getElementById('mic-text');
      const micIcon = document.getElementById('mic-icon');
      const statusEl = document.getElementById('file-upload-status');
      const micBtn = document.getElementById('record-mic-btn');

      if (!isRecording) return;
      isRecording = false;

      // Reset button UI
      micBtn.classList.remove('bg-rose-800', 'animate-pulse');
      micBtn.classList.add('bg-rose-600', 'hover:bg-rose-700');
      micText.innerText = 'Start Classroom Voice Recording';
      micIcon.innerText = '🎙️';

      // Clear timer
      if (recordingTimer) {
        clearInterval(recordingTimer);
        recordingTimer = null;
      }

      // Stop SpeechRecognition
      if (recognition) {
        try {
          recognition.stop();
        } catch (e) {}
        recognition = null;
      }

      // Stop MediaRecorder
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
      }

      // Release hardware mic lock
      if (micStream) {
        micStream.getTracks().forEach(track => track.stop());
        micStream = null;
      }

      // Wait a moment for MediaRecorder to collect remaining chunks
      await new Promise(r => setTimeout(r, 200));

      const finalSpeechResult = speechResultAccumulated.trim();
      
      // ── Layer 1 Result Verification ──
      if (finalSpeechResult && finalSpeechResult.length > 15) {
        console.log(`[TRANSCRIBE] Layer 1 (Browser Speech API) succeeded: ${finalSpeechResult}`);
        if (statusEl) {
          statusEl.classList.remove('hidden');
          statusEl.className = 'mt-1 text-[10px] font-mono text-emerald-600';
          statusEl.innerText = `✅ Transcript successful! (Layer: Browser Web Speech API)`;
        }
        document.getElementById('yt-url-input').value = finalSpeechResult;
        toast('Live transcript added successfully!', 'success');
        
        // Auto trigger notes generation
        document.getElementById('generate-btn').click();
        return;
      }

      // ── Fallback to Serverless API (Layer 2: Groq Whisper -> Layer 3: Gemini Audio) ──
      if (audioChunks.length === 0) {
        if (statusEl) {
          statusEl.className = 'mt-1 text-[10px] font-mono text-error';
          statusEl.innerText = '⚠️ Recording audio empty. Please speak closer to the mic.';
        }
        return;
      }

      if (statusEl) {
        statusEl.className = 'mt-1 text-[10px] font-mono text-cyan-600 animate-pulse';
        statusEl.innerText = '⏳ Processing recording with Cloud AI (Layers 2 & 3)...';
      }

      const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
      
      // Convert to Base64 and send
      const reader = new FileReader();
      reader.readAsDataURL(audioBlob);
      reader.onloadend = async () => {
        const base64Data = reader.result.split(',')[1];
        try {
          const userKey = localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_user_key') || localStorage.getItem('sheshaai_gemini_key') || '';
          const userGroqKey = localStorage.getItem('sheshaai_groq_key') || '';

          const response = await fetch('/api/transcribe-audio', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'x-gemini-key': userKey,
              'x-groq-key': userGroqKey
            },
            body: JSON.stringify({
              audio: base64Data,
              mimeType: 'audio/webm',
              lang: document.getElementById('mic-lang-select').value
            })
          });

          if (!response.ok) {
            const errData = await response.json().catch(() => ({}));
            throw new Error(errData.error || 'Server processing error');
          }

          const resData = await response.json();
          if (resData.transcript && resData.transcript.trim().length > 0) {
            const layerUsed = resData.layer || 'Cloud AI';
            if (statusEl) {
              statusEl.classList.remove('hidden');
              statusEl.className = 'mt-1 text-[10px] font-mono text-emerald-600';
              statusEl.innerText = `✅ Transcript successful! (Layer: ${layerUsed})`;
            }
            toast(`Processed successfully with ${layerUsed}!`, 'success');
            document.getElementById('yt-url-input').value = resData.transcript.trim();
            
            // Auto trigger notes generation
            document.getElementById('generate-btn').click();
          } else {
            throw new Error('Transcript empty');
          }
        } catch (err) {
          console.error('[CLOUD AI TRANSCRIBE ERROR]:', err);
          if (statusEl) {
            statusEl.classList.remove('hidden');
            statusEl.className = 'mt-1 text-[10px] font-mono text-error';
            statusEl.innerText = '⚠️ Recording process nahi ho payi. Please try again or type directly.';
          }
          toast('Cloud transcription failed', 'error');
        }
      };
    }

    // Main Generate Button Click
    document.getElementById('generate-btn')?.addEventListener('click', async () => {
      // Check daily guest limit
      const hasCustomKey = (localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_user_key') || localStorage.getItem('sheshaai_gemini_key') || '').trim().length > 0;
      if (!hasCustomKey) {
        const today = new Date().toISOString().slice(0, 10);
        let usage = { date: today, count: 0 };
        try {
          const raw = localStorage.getItem('sheshaai_daily_usage');
          if (raw) {
            const parsed = JSON.parse(raw);
            if (parsed.date === today) usage = parsed;
          }
        } catch {}

        if (usage.count >= 10) {
          alert('📊 Daily Guest Quota Reached!\n\nAaj ke 10 free guest generations poore ho chuke hain.\n\nUnlimited generations ke liye apna free Google Gemini API key enter karein (Upar 🔑 section me).');
          return;
        }
      }

      const topicInput = document.getElementById('yt-url-input').value.trim() || 'General Science & Study Basics';
      const tone = document.getElementById('tone-select').value;
      const titleBadge = document.getElementById('output-title');
