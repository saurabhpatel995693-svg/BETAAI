---
import Layout from '../../layouts/Layout.astro';
import { MOCK_QUESTIONS, MOCK_USERS } from '../../utils/db';

const defaultQuestions = MOCK_QUESTIONS;
const defaultUsers = MOCK_USERS;

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Layout title="Q&A Forum - Viblo AI">
  <!-- Q&A Forum Header -->
  <div class="flex flex-col gap-4">
    <div class="flex items-center justify-between border-b border-hairline pb-2">
      <!-- Q&A Filter Tabs -->
      <nav class="flex gap-2" aria-label="Q&A Navigation">
        <button 
          type="button" 
          id="q-tab-all"
          class="h-8 px-4 rounded-pill-sm text-body-sm font-medium bg-primary text-on-primary shadow-level-2 transition-all cursor-pointer"
        >
          All Questions
        </button>
        <button 
          type="button" 
          id="q-tab-unresolved"
          class="h-8 px-4 rounded-pill-sm text-body-sm text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
        >
          Unresolved
        </button>
        <button 
          type="button" 
          id="q-tab-resolved"
          class="h-8 px-4 rounded-pill-sm text-body-sm text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
        >
          Resolved
        </button>
      </nav>

      <!-- Ask Question CTA Button -->
      <button 
        type="button"
        id="ask-question-trigger"
        class="h-8 px-4 bg-primary text-on-primary rounded-sm text-[12px] font-medium hover:bg-black transition-all shadow-level-3 cursor-pointer"
      >
        Ask Question
      </button>
    </div>

    <!-- Active Filter Banner (Hidden by default) -->
    <div id="q-filter-banner" class="hidden items-center justify-between bg-link-bg-soft/40 border border-link-bg-soft px-4 py-2 rounded-sm text-body-sm text-link-deep font-medium">
      <span id="q-filter-message">Filtering...</span>
      <button type="button" id="q-clear-filter-btn" class="hover:underline text-[12px] uppercase tracking-wider font-mono">Clear</button>
    </div>
  </div>

  <!-- Questions List Container -->
  <div class="flex flex-col gap-4" id="questions-list-container">
    {defaultQuestions.map(q => {
      const author = defaultUsers.find(u => u.id === q.authorId) || defaultUsers[0];
      return (
        <article 
          class="bg-canvas border border-hairline rounded-md p-5 hover:shadow-level-3 hover:border-hairline-strong transition-all duration-200 shadow-level-2 flex gap-4 items-start"
          data-question-id={q.id}
        >
          <!-- Score Stats Column -->
          <div class="flex flex-col items-center gap-2 font-mono min-w-[50px] text-center select-none pt-1">
            <!-- Up/Down buttons (visual default) -->
            <span class="text-body-sm-strong font-semibold text-ink text-sm block">{q.votes}</span>
            <span class="text-[10px] text-mute uppercase">votes</span>
            
            <div class={`mt-1.5 px-2 py-1 rounded-sm border ${q.resolved ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-500' : 'bg-canvas-soft-2 border-hairline text-body'} text-[11px] font-medium flex flex-col items-center`}>
              <span class="font-bold">{q.answersCount}</span>
              <span class="text-[9px] uppercase leading-none">answers</span>
            </div>
          </div>

          <!-- Main Info Column -->
          <div class="flex-1 flex flex-col gap-2">
            <!-- Header Author metadata -->
            <div class="flex items-center gap-2 text-mute text-xs">
              <div class={`w-5 h-5 rounded-full bg-gradient-to-tr ${author.avatarColor} text-white flex items-center justify-center text-[9px] font-bold`}>
                {author.displayName.charAt(0)}
              </div>
              <a href={`/profile/${author.username}`} class="hover:text-ink hover:underline font-medium">{author.displayName}</a>
              <span>&bull;</span>
              <span class="font-mono">{formatDate(q.createdAt)}</span>
            </div>

            <!-- Title Link -->
            <h2 class="text-display-sm leading-tight font-semibold hover:text-link transition-colors">
              <a href={`/questions/${q.id}`}>{q.title}</a>
            </h2>

            <!-- Question Tags -->
            <div class="flex flex-wrap gap-1.5 mt-1">
              {q.tags.map(tag => (
                <a href={`/questions?tag=${tag}`} class="text-[11px] font-mono text-mute bg-canvas-soft-2 hover:bg-canvas-soft border border-hairline px-2 py-0.5 rounded-sm transition-all">
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Sidebar widgets -->
  <Fragment slot="sidebar">
    <!-- Community Rules and helper tips -->
    <div class="bg-canvas border border-hairline rounded-md p-5 shadow-level-2 flex flex-col gap-3">
      <h3 class="text-caption-mono text-mute font-semibold">Asking Guidelines</h3>
      <ul class="text-body-sm text-body space-y-2 list-disc pl-4 leading-relaxed">
        <li>Provide specific details and context of your coding problem.</li>
        <li>Paste clean, minimal code blocks with appropriate formatting.</li>
        <li>Tag relevant languages/frameworks for prompt sorting.</li>
        <li>Verify answers from community or run AI answering drafts.</li>
      </ul>
    </div>
  </Fragment>

  <!-- ASK QUESTION MODAL -->
  <div 
    id="ask-modal-overlay" 
    class="fixed inset-0 z-50 bg-primary/40 backdrop-blur-sm hidden items-center justify-center p-4 transition-all duration-300"
  >
    <div 
      class="bg-canvas border border-hairline w-full max-w-lg rounded-lg shadow-level-5 p-6 transform scale-95 transition-all duration-300 flex flex-col gap-4"
      id="ask-modal-card"
    >
      <div class="flex items-center justify-between border-b border-hairline pb-3">
        <h2 class="text-display-sm tracking-tight text-ink font-semibold flex items-center gap-2">
          Ask a Question
        </h2>
        <button 
          type="button" 
          id="ask-modal-close" 
          class="text-mute hover:text-ink rounded-full w-6 h-6 flex items-center justify-center hover:bg-canvas-soft-2 transition-all"
        >
          &times;
        </button>
      </div>

      <div class="flex flex-col gap-4">
        <!-- Title input -->
        <div class="flex flex-col gap-1">
          <label for="q-input-title" class="text-caption-mono text-mute font-medium">Question Title</label>
          <input 
            type="text" 
            id="q-input-title" 
            placeholder="e.g. How to pass props to Astro server layout components?" 
            class="w-full h-10 bg-canvas-soft border border-hairline rounded-sm px-3 text-body-sm text-ink placeholder:text-mute focus:outline-none focus:border-hairline-strong transition-colors"
          />
        </div>

        <!-- Tags input -->
        <div class="flex flex-col gap-1">
          <label for="q-input-tags" class="text-caption-mono text-mute font-medium">Tags (comma-separated)</label>
          <input 
            type="text" 
            id="q-input-tags" 
            placeholder="Astro, props, TypeScript" 
            class="w-full h-10 bg-canvas-soft border border-hairline rounded-sm px-3 text-body-sm text-ink placeholder:text-mute focus:outline-none focus:border-hairline-strong transition-colors"
          />
        </div>

        <!-- Details text area -->
        <div class="flex flex-col gap-1">
          <label for="q-input-content" class="text-caption-mono text-mute font-medium">Explain your problem</label>
          <textarea 
            id="q-input-content" 
            placeholder="Provide context, share what you have tried, paste code blocks..." 
            rows="5"
            class="w-full bg-canvas-soft border border-hairline rounded-sm p-3 text-body-sm text-ink placeholder:text-mute focus:outline-none focus:border-hairline-strong transition-colors font-sans"
          ></textarea>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-hairline mt-2">
        <button 
          type="button" 
          id="ask-modal-cancel"
          class="h-9 px-4 rounded-pill border border-hairline text-body text-[13px] font-medium hover:border-hairline-strong transition-all cursor-pointer"
        >
          Cancel
        </button>
        <button 
          type="button" 
          id="q-submit-btn"
          class="h-9 px-5 bg-primary text-on-primary rounded-pill text-[13px] font-medium hover:bg-black transition-all cursor-pointer"
        >
          Submit Question
        </button>
      </div>
    </div>
  </div>

  <script>
    import { getDb, saveDb, getCurrentUser, type Question } from '../../utils/db';

    let db = getDb();
    let qFilter: 'all' | 'unresolved' | 'resolved' = 'all';
    let qSearchTag: string | null = null;

    // Parse Tag filter from URL query string
    function parseQuery() {
      const params = new URLSearchParams(window.location.search);
      qSearchTag = params.get('tag');
    }

    // Hydrate and render questions list
    function renderQuestions() {
      const container = document.getElementById('questions-list-container');
      const banner = document.getElementById('q-filter-banner');
      const bannerMsg = document.getElementById('q-filter-message');

      if (!container) return;

      let list = [...db.questions];

      // Tag query filtering
      if (qSearchTag) {
        list = list.filter(q => q.tags.includes(qSearchTag!));
        if (banner && bannerMsg) {
          banner.classList.remove('hidden');
          banner.classList.add('flex');
          bannerMsg.textContent = `Filtering questions by tag: #${qSearchTag}`;
        }
      } else {
        if (banner) {
          banner.classList.add('hidden');
          banner.classList.remove('flex');
        }
      }

      // Resolved / Unresolved tabs filtering
      if (qFilter === 'resolved') {
        list = list.filter(q => q.resolved);
      } else if (qFilter === 'unresolved') {
        list = list.filter(q => !q.resolved);
      }

      // Sort: newest questions first
      list.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

      if (list.length === 0) {
        container.innerHTML = `
          <div class="bg-canvas border border-hairline rounded-md p-10 text-center flex flex-col items-center justify-center gap-3 shadow-level-2 py-12">
            <svg class="text-mute" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span class="text-body-sm font-medium text-ink">No questions found matching your filter constraints.</span>
            <button type="button" id="q-reset-filters" class="text-link hover:underline text-xs">Reset filters</button>
          </div>
        `;
        const resetBtn = document.getElementById('q-reset-filters');
        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            window.location.search = '';
          });
        }
        return;
      }

      container.innerHTML = list.map(q => {
        const author = db.users.find(u => u.id === q.authorId) || db.users[0];
        const dateFormatted = new Date(q.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        
        return `
          <article 
            class="bg-canvas border border-hairline rounded-md p-5 hover:shadow-level-3 hover:border-hairline-strong transition-all duration-200 shadow-level-2 flex gap-4 items-start"
            data-question-id="${q.id}"
          >
            <!-- Score Stats Column -->
            <div class="flex flex-col items-center gap-2 font-mono min-w-[50px] text-center select-none pt-1">
              <span class="text-body-sm-strong font-semibold text-ink text-sm block">${q.votes}</span>
              <span class="text-[10px] text-mute uppercase">votes</span>
              
              <div class="mt-1.5 px-2 py-1 rounded-sm border ${q.resolved ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-500' : 'bg-canvas-soft-2 border-hairline text-body'} text-[11px] font-medium flex flex-col items-center">
                <span class="font-bold">${q.answersCount}</span>
                <span class="text-[9px] uppercase leading-none">answers</span>
              </div>
            </div>

            <!-- Main Info Column -->
            <div class="flex-1 flex flex-col gap-2">
              <!-- Header Author metadata -->
              <div class="flex items-center gap-2 text-mute text-xs">
                <div class="w-5 h-5 rounded-full bg-gradient-to-tr ${author.avatarColor} text-white flex items-center justify-center text-[9px] font-bold">
                  ${author.displayName.charAt(0)}
                </div>
                <a href="/profile/${author.username}" class="hover:text-ink hover:underline font-medium">${author.displayName}</a>
                <span>&bull;</span>
                <span class="font-mono">${dateFormatted}</span>
              </div>

              <!-- Title Link -->
              <h2 class="text-display-sm leading-tight font-semibold hover:text-link transition-colors">
                <a href="/questions/${q.id}">${q.title}</a>
              </h2>

              <!-- Question Tags -->
              <div class="flex flex-wrap gap-1.5 mt-1">
                ${q.tags.map(tag => `
                  <a href="/questions?tag=${tag}" class="tag-link-item text-[11px] font-mono text-mute bg-canvas-soft-2 hover:bg-canvas-soft border border-hairline px-2 py-0.5 rounded-sm transition-all">
                    #${tag}
                  </a>
                `).join('')}
              </div>
            </div>
          </article>
        `;
      }).join('');

      attachClickListeners();
    }

    function attachClickListeners() {
      // Connect Tag filter clicks inside list
      document.querySelectorAll('.tag-link-item').forEach(el => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          const target = e.currentTarget as HTMLElement;
          const href = target.getAttribute('href');
          if (href) {
            window.location.href = href;
          }
        });
      });
    }

    // Connect Tab click triggers
    const tabAll = document.getElementById('q-tab-all');
    const tabUnresolved = document.getElementById('q-tab-unresolved');
    const tabResolved = document.getElementById('q-tab-resolved');

    function selectQFilter(filter: 'all' | 'unresolved' | 'resolved') {
      qFilter = filter;
      const tabs = [
        { el: tabAll, type: 'all' },
        { el: tabUnresolved, type: 'unresolved' },
        { el: tabResolved, type: 'resolved' }
      ];

      tabs.forEach(t => {
        if (!t.el) return;
        if (t.type === filter) {
          t.el.className = "h-8 px-4 rounded-pill-sm text-body-sm font-medium bg-primary text-on-primary shadow-level-2 transition-all cursor-pointer";
        } else {
          t.el.className = "h-8 px-4 rounded-pill-sm text-body-sm text-body hover:text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer";
        }
      });

      renderQuestions();
    }

    if (tabAll) tabAll.addEventListener('click', () => selectQFilter('all'));
    if (tabUnresolved) tabUnresolved.addEventListener('click', () => selectQFilter('unresolved'));
    if (tabResolved) tabResolved.addEventListener('click', () => selectQFilter('resolved'));

    // Clear Filter Banner Button
    const clearBtn = document.getElementById('q-clear-filter-btn');
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        window.location.search = '';
      });
    }

    // Modal Form trigger scripts
    const trigger = document.getElementById('ask-question-trigger');
    const overlay = document.getElementById('ask-modal-overlay');
    const closeBtn = document.getElementById('ask-modal-close');
    const cancelBtn = document.getElementById('ask-modal-cancel');
    const submitBtn = document.getElementById('q-submit-btn');

    const titleInput = document.getElementById('q-input-title') as HTMLInputElement;
    const tagsInput = document.getElementById('q-input-tags') as HTMLInputElement;
    const contentInput = document.getElementById('q-input-content') as HTMLTextAreaElement;

    function openModal() {
      if (overlay) {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
      }
    }

    function closeModal() {
      if (overlay) {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
      }
    }

    if (trigger) trigger.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
    if (overlay) {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeModal();
      });
    }

    // Submit Question logic
    if (submitBtn) {
      submitBtn.addEventListener('click', () => {
        const title = titleInput.value.trim();
        const tagsRaw = tagsInput.value.trim();
        const content = contentInput.value.trim();

        if (!title || !content) {
          alert('Please fill out both the Title and the Details of your question.');
          return;
        }

        const tags = tagsRaw 
          ? tagsRaw.split(',').map(t => t.trim()).filter(t => t.length > 0)
          : ["General"];

        db = getDb();
        const currentUser = getCurrentUser();

        // Check for empty slots in static routes
        const existingIds = db.questions.map(q => q.id);
        let selectedId = '';
        for (let i = 1; i <= 10; i++) {
          const candidateId = `custom-q-${i}`;
          if (!existingIds.includes(candidateId)) {
            selectedId = candidateId;
            break;
          }
        }

        if (!selectedId) {
          // Recycle oldest custom question
          const oldestCustom = db.questions.find(q => q.id.startsWith('custom-q-'));
          if (oldestCustom) {
            selectedId = oldestCustom.id;
            db.questions = db.questions.filter(q => q.id !== selectedId);
            db.answers = db.answers.filter(ans => ans.questionId !== selectedId);
          } else {
            selectedId = 'custom-q-1';
          }
        }

        const newQuestion: Question = {
          id: selectedId,
          title: title,
          content: content,
          tags: tags,
          authorId: currentUser.id,
          views: 0,
          votes: 0,
          votedUserIds: {},
          resolved: false,
          createdAt: new Date().toISOString(),
          answersCount: 0
        };

        db.questions.push(newQuestion);
        saveDb(db);

        // Reset fields and close modal
        titleInput.value = '';
        tagsInput.value = '';
        contentInput.value = '';
        closeModal();

        // Redirect to detail page
        window.location.href = `/questions/${selectedId}`;
      });
    }

    // Startup Execution
    parseQuery();
    renderQuestions();
  </script>
</Layout>
