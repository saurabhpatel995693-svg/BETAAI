---
import Layout from '../layouts/Layout.astro';
---

<Layout title="KiddieNotes AI — Coconote for K-12 Students (Nursery to 12th)" wide={true} noSidebars={true}>
  <!-- Top Hero Bar (Vercel stark aesthetic according to DESIGN.md) -->
  <section class="relative pt-16 pb-12 overflow-hidden border-b border-hairline bg-canvas">
    <div class="max-w-[1200px] mx-auto px-4 text-center relative z-10">
      
      <!-- Mesh Gradient Glow Tag -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-canvas-soft border border-hairline rounded-full shadow-level-2 mb-4">
        <span class="w-2 h-2 rounded-full bg-cyan animate-pulse"></span>
        <span class="text-caption-mono text-mute font-semibold uppercase tracking-wider">KiddieNotes AI Engine (Nursery to 12th Class)</span>
      </div>

      <h1 class="text-display-xl md:text-[52px] leading-[1.05] font-semibold text-ink tracking-[-2.4px] mb-4">
        Turn YouTube & Lectures into <span class="bg-gradient-to-r from-violet via-pink-500 to-cyan bg-clip-text text-transparent">KiddieNotes AI</span>.
      </h1>
      <p class="text-body-lg text-body max-w-2xl mx-auto mb-8">
        Convert school video links and classroom voice audio into easy bullet notes, interactive quizzes, flashcard packs, and study games. Powered by live AI models.
      </p>

      <!-- Grade Filter Chips -->
      <div class="flex flex-wrap justify-center gap-2" id="grade-chips-wrapper">
        <button class="grade-chip px-4 py-1.5 rounded-pill text-xs font-mono font-medium bg-primary text-on-primary border border-primary transition shadow-level-2 active-grade" data-grade="all">
          🌟 All Grades (Nursery - 12th)
        </button>
        <button class="grade-chip px-4 py-1.5 rounded-pill text-xs font-mono font-medium bg-canvas-soft text-body border border-hairline hover:border-hairline-strong transition" data-grade="nursery-5">
          🧸 Nursery to 5th Class
        </button>
        <button class="grade-chip px-4 py-1.5 rounded-pill text-xs font-mono font-medium bg-canvas-soft text-body border border-hairline hover:border-hairline-strong transition" data-grade="6-10">
          📚 6th to 10th Class
        </button>
        <button class="grade-chip px-4 py-1.5 rounded-pill text-xs font-mono font-medium bg-canvas-soft text-body border border-hairline hover:border-hairline-strong transition" data-grade="11-12">
          🎓 11th & 12th Class
        </button>
      </div>

    </div>
  </section>

  <!-- Interactive App Workplace -->
  <section class="max-w-[1200px] mx-auto px-4 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- LEFT PANEL: Inputs (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- Input 1: YouTube & Voice Audio -->
        <div class="bg-canvas p-6 rounded-lg border border-hairline shadow-level-3">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-7 h-7 rounded bg-primary text-on-primary font-mono text-xs flex items-center justify-center font-bold">1</span>
            <div>
              <h2 class="text-display-sm text-ink text-base">YouTube or Class Audio</h2>
              <p class="text-caption-mono text-mute">Paste video link or enter study topic</p>
            </div>
          </div>

          <div class="space-y-4">
            <div>
              <label class="block text-caption-mono text-ink font-semibold mb-1">YouTube URL / Video Topic</label>
              <input 
                type="text" 
                id="yt-url-input" 
                placeholder="https://youtu.be/E_4gRy4O03w or Solar System basics" 
                class="w-full px-3 py-2 text-xs font-mono bg-canvas-soft border border-hairline rounded-sm text-ink focus:outline-none focus:border-link transition"
                value="https://youtu.be/E_4gRy4O03w"
              />
            </div>

            <!-- YouTube Presets -->
            <div>
              <span class="block text-[10px] font-mono text-mute uppercase tracking-wider mb-2">Try Kid Study Demos:</span>
              <div class="flex flex-wrap gap-2">
                <button class="demo-btn text-[11px] font-mono px-2.5 py-1 bg-canvas-soft border border-hairline rounded text-ink hover:bg-canvas-soft-2 transition" data-url="https://youtu.be/E_4gRy4O03w" data-topic="Coconote AI Study Demo">
                  📹 YT Coconote Demo
                </button>
                <button class="demo-btn text-[11px] font-mono px-2.5 py-1 bg-canvas-soft border border-hairline rounded text-ink hover:bg-canvas-soft-2 transition" data-url="https://youtube.com/watch?v=solar_system" data-topic="Solar System & Planets (Class 4-8)">
                  🪐 Solar System
                </button>
                <button class="demo-btn text-[11px] font-mono px-2.5 py-1 bg-canvas-soft border border-hairline rounded text-ink hover:bg-canvas-soft-2 transition" data-url="https://youtube.com/watch?v=photosynthesis" data-topic="Photosynthesis Science (Class 9-10)">
                  🌱 Photosynthesis
                </button>
                <button class="demo-btn text-[11px] font-mono px-2.5 py-1 bg-canvas-soft border border-hairline rounded text-ink hover:bg-canvas-soft-2 transition" data-url="https://youtube.com/watch?v=calculus_basics" data-topic="Calculus & Physics (Class 11-12)">
                  📐 Math/Physics 12th
                </button>
              </div>
            </div>

            <!-- Audio Recording -->
            <div class="pt-2 border-t border-hairline">
              <label class="block text-caption-mono text-ink font-semibold mb-1">Live Classroom Microphone</label>
              <button id="record-mic-btn" class="w-full py-2 px-3 bg-error text-white rounded-sm text-xs font-mono font-medium flex items-center justify-center gap-2 hover:bg-error-deep transition shadow-level-2">
                <span id="mic-icon">🎙️</span>
                <span id="mic-text">Start Classroom Voice Recording</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Input 2: Output Selector -->
        <div class="bg-canvas p-6 rounded-lg border border-hairline shadow-level-3">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-7 h-7 rounded bg-primary text-on-primary font-mono text-xs flex items-center justify-center font-bold">2</span>
            <div>
              <h2 class="text-display-sm text-ink text-base">Select Study Format</h2>
              <p class="text-caption-mono text-mute">Pick what KiddieNotes AI should generate</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 mb-4">
            <button class="mode-select-btn p-3 bg-primary text-on-primary rounded-sm text-left border border-primary transition shadow-level-2 font-medium text-xs flex flex-col gap-1 active-mode" data-type="notes">
              <span class="text-base">📋</span>
              <span>Easy Kid Notes</span>
            </button>
            <button class="mode-select-btn p-3 bg-canvas-soft text-ink rounded-sm text-left border border-hairline hover:border-hairline-strong transition font-medium text-xs flex flex-col gap-1" data-type="quiz">
              <span class="text-base">📝</span>
              <span>Interactive Quiz</span>
            </button>
            <button class="mode-select-btn p-3 bg-canvas-soft text-ink rounded-sm text-left border border-hairline hover:border-hairline-strong transition font-medium text-xs flex flex-col gap-1" data-type="flashcard">
              <span class="text-base">🃏</span>
              <span>Flashcard Deck</span>
            </button>
            <button class="mode-select-btn p-3 bg-canvas-soft text-ink rounded-sm text-left border border-hairline hover:border-hairline-strong transition font-medium text-xs flex flex-col gap-1" data-type="game">
              <span class="text-base">🏃</span>
              <span>Study Run Game</span>
            </button>
          </div>

          <div class="mb-4">
            <label class="block text-caption-mono text-ink font-semibold mb-1">Class Grade Complexity</label>
            <select id="tone-select" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-sm text-xs font-mono text-ink focus:outline-none">
              <option value="nursery">🧸 Nursery / KG (Emoji & Simple Sentences)</option>
              <option value="middle" selected>📚 Class 1st to 8th (Structured Bullet Points)</option>
              <option value="high">🎓 Class 9th to 12th (Board Exam Formulas & Notes)</option>
            </select>
          </div>

          <button id="generate-btn" class="w-full py-3 bg-primary text-on-primary rounded-pill text-xs font-mono font-semibold uppercase tracking-wider hover:bg-black transition shadow-level-4 flex items-center justify-center gap-2 cursor-pointer">
            <span>⚡</span> Generate KiddieNotes
          </button>
        </div>

      </div>

      <!-- RIGHT PANEL: Display (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        
        <div class="bg-canvas p-6 rounded-lg border border-hairline shadow-level-3 min-h-[500px] flex flex-col">
          
          <div class="flex items-center justify-between border-b border-hairline pb-4 mb-4">
            <div class="flex items-center gap-2">
              <span id="output-badge-icon" class="text-lg">📋</span>
              <h3 id="output-title" class="text-display-sm text-ink text-base">Generated Study Notes</h3>
            </div>
            <div class="flex items-center gap-2">
              <button id="read-aloud-btn" class="px-3 py-1 bg-link-bg-soft text-link-deep rounded-sm text-xs font-mono font-semibold hover:bg-blue-200 transition">
                🔊 Read Aloud
              </button>
              <button id="copy-btn" class="px-3 py-1 bg-canvas-soft text-ink border border-hairline rounded-sm text-xs font-mono font-semibold hover:bg-canvas-soft-2 transition">
                📋 Copy
              </button>
            </div>
          </div>

          <!-- Dynamic Output View -->
          <div id="output-content-box" class="flex-1 relative">
            
            <!-- Default Idle State -->
            <div id="default-preview" class="h-full flex flex-col items-center justify-center text-center p-8 border border-dashed border-hairline rounded-lg bg-canvas-soft">
              <div class="w-14 h-14 rounded-lg bg-primary text-on-primary flex items-center justify-center text-2xl mb-3 shadow-level-2">
                ✨
              </div>
              <h4 class="text-display-sm text-ink text-base mb-2">Ready to convert YouTube to Notes!</h4>
              <p class="text-body-sm text-body max-w-sm mb-4">
                Click "Generate KiddieNotes" to transform your video link into active study materials powered by AI models.
              </p>
            </div>

            <!-- Loading Spinner View -->
            <div id="loading-view" class="hidden h-full flex flex-col items-center justify-center text-center p-8 border border-hairline rounded-lg bg-canvas-soft space-y-3">
              <div class="w-10 h-10 border-3 border-primary border-t-transparent rounded-full animate-spin"></div>
              <p class="text-xs font-mono text-cyan-deep font-semibold animate-pulse" id="loading-msg">⚡ Transcribing YouTube & Generating AI KiddieNotes...</p>
              <span class="text-[11px] text-mute">Powered by SHESHAAI Unified AI Engine</span>
            </div>

            <!-- 1. Notes View -->
            <div id="notes-view" class="hidden space-y-4">
              <div class="p-4 bg-canvas-soft border border-hairline rounded-md">
                <h4 class="text-body-sm-strong font-semibold text-ink mb-1 flex items-center justify-between">
                  <span id="notes-topic-heading">📌 Coconote AI Study Notes (K-12 Edition)</span>
                  <span class="text-caption-mono text-cyan-deep bg-cyan-soft px-2 py-0.5 rounded font-mono">Live AI Transcribed</span>
                </h4>
                <div id="notes-summary-text" class="text-body-sm text-body leading-relaxed whitespace-pre-wrap"></div>
              </div>

              <div>
                <h5 class="text-caption-mono text-mute uppercase tracking-wider mb-2 font-semibold">Key Takeaways & Concept Breakdown</h5>
                <ul id="notes-bullets-list" class="space-y-2 text-body-sm text-body"></ul>
              </div>

              <!-- AI Question Box -->
              <div class="pt-4 border-t border-hairline">
                <h5 class="text-caption-mono text-ink font-semibold mb-2">💬 Ask AI Study Teacher</h5>
                <div class="flex gap-2">
                  <input type="text" id="ai-chat-input" placeholder="Ask e.g. Explain photosynthesis in simpler words..." class="flex-1 px-3 py-1.5 bg-canvas-soft border border-hairline rounded-sm text-xs text-ink focus:outline-none"/>
                  <button id="ai-chat-btn" class="px-4 py-1.5 bg-primary text-on-primary rounded-sm text-xs font-mono font-medium hover:bg-black transition">Ask AI</button>
                </div>
                <div id="ai-chat-response" class="hidden mt-2 p-3 bg-canvas-soft border border-hairline text-ink rounded-sm text-xs font-mono leading-relaxed"></div>
              </div>
            </div>

            <!-- 2. Quiz View -->
            <div id="quiz-view" class="hidden space-y-4">
              <div class="flex items-center justify-between bg-canvas-soft p-3 rounded border border-hairline">
                <span class="text-caption-mono text-ink font-semibold">Score: <span id="quiz-score">0</span> / <span id="quiz-total">3</span></span>
                <span class="text-caption-mono text-mute">Question <span id="quiz-curr-idx">1</span> of <span id="quiz-count-display">3</span></span>
              </div>

              <div id="quiz-card-box" class="p-6 bg-canvas border border-hairline rounded-md shadow-level-2 space-y-4">
                <h4 id="quiz-question-text" class="text-display-sm text-ink text-sm">Loading question...</h4>
                <div id="quiz-options-box" class="space-y-2"></div>
              </div>
            </div>

            <!-- 3. Flashcard View -->
            <div id="flashcard-view" class="hidden space-y-4">
              <div class="text-center text-caption-mono text-mute">Click card to flip 🔄</div>
              
              <div id="flashcard-element" class="w-full h-52 bg-primary text-on-primary rounded-lg shadow-level-4 p-6 flex flex-col items-center justify-center text-center cursor-pointer transition-transform duration-200">
                <span id="fc-term-tag" class="text-caption-mono text-mute uppercase mb-2">Term 1</span>
                <h4 id="flashcard-text-front" class="text-display-sm text-white text-base">Loading card...</h4>
                <p id="flashcard-text-back" class="hidden text-body-sm text-slate-200 mt-2 bg-white/10 p-3 rounded-sm">Answer details...</p>
              </div>

              <div class="flex justify-between items-center">
                <button id="fc-prev-btn" class="px-4 py-1.5 bg-canvas-soft border border-hairline rounded-sm text-xs font-mono font-medium text-ink hover:bg-canvas-soft-2">← Previous</button>
                <span id="fc-counter" class="text-caption-mono text-mute">Card 1 of 3</span>
                <button id="fc-next-btn" class="px-4 py-1.5 bg-primary text-on-primary rounded-sm text-xs font-mono font-medium hover:bg-black">Next →</button>
              </div>
            </div>

            <!-- 4. Game View -->
            <div id="game-view" class="hidden space-y-4">
              <div class="p-4 bg-canvas-soft border border-hairline rounded flex items-center justify-between">
                <div>
                  <h4 class="text-caption-mono text-ink font-semibold">🎮 Study Run: Kids Revision Game</h4>
                  <p class="text-caption-mono text-mute">Answer AI questions correctly to gain stars ⭐</p>
                </div>
                <div class="text-right">
                  <span class="text-caption-mono text-ink font-bold">Stars: <span id="game-stars">120</span> ⭐</span>
                </div>
              </div>

              <div id="game-canvas-area" class="relative h-64 bg-primary rounded-lg p-4 text-on-primary flex flex-col justify-between border border-hairline shadow-level-4">
                <div class="flex justify-between items-center text-caption-mono text-mute">
                  <span>Level 1: AI Study Runner</span>
                  <span class="animate-pulse text-cyan">Running Speed: 2x</span>
                </div>

                <div id="game-prompt-box" class="my-auto text-center">
                  <div class="text-3xl mb-2">🏃‍♂️💨</div>
                  <h5 id="game-q-text" class="text-display-sm text-white text-base mb-3">Loading game question...</h5>
                  <div id="game-options-container" class="flex justify-center gap-4 flex-wrap"></div>
                </div>

                <div id="game-feedback" class="text-center text-caption-mono text-cyan h-4 font-bold"></div>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Interactive JavaScript Engine -->
  <script is:inline>
    let currentMode = 'notes';
    let isRecording = false;
    let quizScore = 0;
    let currentQuizIdx = 0;
    let flashcardIdx = 0;
    let flashcardFlipped = false;
    let gameStars = 120;
    let currentGameIdx = 0;
    let activeAIResponse = null;

    let aiQuizzes = [
      { q: "What is the primary goal of this lesson?", options: ["Understand core concepts", "Memorize dates", "Skip study", "Draw pictures"], answer: 0 },
      { q: "How do active recall quizzes aid memory?", options: ["By testing key facts", "By making noise", "By sleeping", "By reading once"], answer: 0 }
    ];

    let aiFlashcards = [
      { front: "Core Subject Topic", back: "Key principles and fundamentals synthesized by KiddieNotes AI." },
      { front: "Study Method", back: "Active recall and spaced repetition for K-12 students." }
    ];

    let aiGameQuestions = [
      { q: "Is review testing important for school exams?", options: ["YES ✅", "NO ❌"], answer: 0, explanation: "Active testing boosts retention!" }
    ];

    // Helper to call unified /api/chat server endpoint with user's key
    async function callKiddieAI(promptText) {
      const geminiKey = localStorage.getItem('sheshaai_gemini_key') || '';
      const openrouterKey = localStorage.getItem('sheshaai_openrouter_key') || '';
      
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-gemini-key': geminiKey,
          'x-openrouter-key': openrouterKey
        },
        body: JSON.stringify({
          messages: [
            {
              role: 'system',
              content: 'You are KiddieNotes AI by SAURABH, an educational study engine for K-12 students (Nursery to 12th Class). Provide clear, accurate, age-appropriate answers.'
            },
            { role: 'user', content: promptText }
          ],
          mode: 'general'
        })
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.error?.message || `API error ${res.status}`);
      }

      const data = await res.json();
      return data.choices?.[0]?.message?.content || '';
    }

    // Helper to parse JSON array from AI output
    function extractJSONArray(text) {
      try {
        const clean = text.replace(/```json/gi, '').replace(/```/g, '').trim();
        const start = clean.indexOf('[');
        const end = clean.lastIndexOf(']');
        if (start !== -1 && end !== -1) {
          return JSON.parse(clean.substring(start, end + 1));
        }
        return JSON.parse(clean);
      } catch (e) {
        return null;
      }
    }

    // Grade Filter Chips Click
    document.querySelectorAll('.grade-chip').forEach(chip => {
      chip.addEventListener('click', (e) => {
        document.querySelectorAll('.grade-chip').forEach(c => {
          c.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'active-grade');
          c.classList.add('bg-canvas-soft', 'text-body', 'border-hairline');
        });
        const target = e.currentTarget;
        target.classList.remove('bg-canvas-soft', 'text-body', 'border-hairline');
        target.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'active-grade');

        const grade = target.getAttribute('data-grade');
        const select = document.getElementById('tone-select');
        if (grade === 'nursery-5') select.value = 'nursery';
        else if (grade === '6-10') select.value = 'middle';
        else if (grade === '11-12') select.value = 'high';
      });
    });

    // Mode Selector Handler
    document.querySelectorAll('.mode-select-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.mode-select-btn').forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'active-mode');
          b.classList.add('bg-canvas-soft', 'text-ink', 'border-hairline');
        });
        const targetBtn = e.currentTarget;
        targetBtn.classList.remove('bg-canvas-soft', 'text-ink', 'border-hairline');
        targetBtn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'active-mode');
        currentMode = targetBtn.getAttribute('data-type');
      });
    });

    // Preset Video Buttons
    document.querySelectorAll('.demo-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        const topic = btn.getAttribute('data-topic');
        document.getElementById('yt-url-input').value = topic ? `${topic} (${url})` : url;
      });
    });

    // Mic Toggle
    document.getElementById('record-mic-btn')?.addEventListener('click', () => {
      isRecording = !isRecording;
      const micText = document.getElementById('mic-text');
      const micIcon = document.getElementById('mic-icon');
      if (isRecording) {
        micText.innerText = "Listening to Lecture... Click to Stop";
        micIcon.innerText = "🔴";
      } else {
        micText.innerText = "Start Classroom Voice Recording";
        micIcon.innerText = "🎙️";
      }
    });

    // Generate Button Click
    document.getElementById('generate-btn')?.addEventListener('click', async () => {
      const topicInput = document.getElementById('yt-url-input').value.trim() || 'General Science & Study Basics';
      const tone = document.getElementById('tone-select').value;
      const titleBadge = document.getElementById('output-title');
      const iconBadge = document.getElementById('output-badge-icon');

      const toneLabel = tone === 'nursery' ? 'Nursery/KG Kids (simple words, emojis)' : tone === 'high' ? 'Class 9-12 (Board exam concepts, formulas)' : 'Class 1-8 (Clear structured bullets)';

      // Hide views, show loader
      ['default-preview','notes-view','quiz-view','flashcard-view','game-view'].forEach(id => document.getElementById(id)?.classList.add('hidden'));
      const loadingView = document.getElementById('loading-view');
      loadingView.classList.remove('hidden');
      document.getElementById('loading-msg').innerText = `⚡ Transcribing & Generating KiddieNotes AI for ${toneLabel}...`;

      try {
        if (currentMode === 'notes') {
          titleBadge.innerText = "Generated Easy Notes";
          iconBadge.innerText = "📋";

          const prompt = `Create comprehensive educational study notes based on this video/topic: "${topicInput}". Target Grade Level: ${toneLabel}.\n\nProvide:\n1. A short summary paragraph (3-4 sentences).\n2. 4 key bullet points explaining main facts.\n3. 3 key vocabulary terms with short definitions.`;
          const responseText = await callKiddieAI(prompt);

          document.getElementById('notes-topic-heading').innerText = `📌 ${topicInput.substring(0, 45)}`;
          document.getElementById('notes-summary-text').innerText = responseText;

          // Extract bullet lines if any
          const bulletList = document.getElementById('notes-bullets-list');
          bulletList.innerHTML = '';
          const lines = responseText.split('\n').filter(l => l.trim().startsWith('-') || l.trim().startsWith('*') || l.trim().match(/^\d+\./));
          if (lines.length > 0) {
            lines.slice(0, 6).forEach(line => {
              const li = document.createElement('li');
              li.className = "p-2.5 bg-canvas-soft rounded border border-hairline flex items-start gap-2 text-xs font-mono";
              li.innerHTML = `<span class="text-link font-bold">•</span><span>${line.replace(/^[-*\d.]+\s*/, '')}</span>`;
              bulletList.appendChild(li);
            });
          } else {
            bulletList.innerHTML = '<li class="p-2.5 bg-canvas-soft rounded border border-hairline text-xs font-mono">✨ Notes synthesized cleanly above by KiddieNotes AI.</li>';
          }

          loadingView.classList.add('hidden');
          document.getElementById('notes-view').classList.remove('hidden');

        } else if (currentMode === 'quiz') {
          titleBadge.innerText = "Interactive Revision Quiz";
          iconBadge.innerText = "📝";

          const prompt = `Generate 3 multiple-choice quiz questions based on: "${topicInput}". Target Grade: ${toneLabel}.\n\nReturn ONLY a valid JSON array of 3 objects with exact keys: "q" (question string), "options" (array of 4 string options), "answer" (index number 0-3 of the correct option). No extra text outside JSON.`;
          const raw = await callKiddieAI(prompt);
          const parsed = extractJSONArray(raw);

          if (parsed && Array.isArray(parsed) && parsed.length > 0) {
            aiQuizzes = parsed;
          }

          quizScore = 0;
          currentQuizIdx = 0;
          document.getElementById('quiz-score').innerText = 0;
          document.getElementById('quiz-total').innerText = aiQuizzes.length;
          document.getElementById('quiz-count-display').innerText = aiQuizzes.length;

          loadingView.classList.add('hidden');
          document.getElementById('quiz-view').classList.remove('hidden');
          renderQuizCard();

        } else if (currentMode === 'flashcard') {
          titleBadge.innerText = "Study Flashcards";
          iconBadge.innerText = "🃏";

          const prompt = `Generate 4 study flashcards based on: "${topicInput}". Target Grade: ${toneLabel}.\n\nReturn ONLY a valid JSON array of objects with keys: "front" (question or term) and "back" (answer or concise explanation). No extra text outside JSON.`;
          const raw = await callKiddieAI(prompt);
          const parsed = extractJSONArray(raw);

          if (parsed && Array.isArray(parsed) && parsed.length > 0) {
            aiFlashcards = parsed;
          }

          flashcardIdx = 0;
          loadingView.classList.add('hidden');
          document.getElementById('flashcard-view').classList.remove('hidden');
          renderFlashcard();

        } else if (currentMode === 'game') {
          titleBadge.innerText = "Study Run Game";
          iconBadge.innerText = "🏃";

          const prompt = `Generate 3 fun true/false or quick-choice game questions for kids based on: "${topicInput}". Target Grade: ${toneLabel}.\n\nReturn ONLY a valid JSON array of objects with keys: "q" (question string), "options" (array of 2 string options e.g. ["YES ✅", "NO ❌"]), "answer" (0 or 1 index), "explanation" (short string). No extra text.`;
          const raw = await callKiddieAI(prompt);
          const parsed = extractJSONArray(raw);

          if (parsed && Array.isArray(parsed) && parsed.length > 0) {
            aiGameQuestions = parsed;
          }

          currentGameIdx = 0;
          loadingView.classList.add('hidden');
          document.getElementById('game-view').classList.remove('hidden');
          renderGameQuestion();
        }

      } catch (err) {
        loadingView.classList.add('hidden');
        document.getElementById('default-preview').classList.remove('hidden');
        alert(`KiddieNotes Generation Error: ${err.message}`);
      }
    });

    // Quiz Render Function
    function renderQuizCard() {
      const qObj = aiQuizzes[currentQuizIdx];
      if (!qObj) return;
      document.getElementById('quiz-curr-idx').innerText = currentQuizIdx + 1;
      document.getElementById('quiz-question-text').innerText = `${currentQuizIdx + 1}. ${qObj.q}`;
      
      const optBox = document.getElementById('quiz-options-box');
      optBox.innerHTML = '';

      (qObj.options || []).forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left p-3 rounded border border-hairline text-xs font-mono hover:border-hairline-strong hover:bg-canvas-soft transition cursor-pointer";
        btn.innerText = opt;
        btn.onclick = () => {
          if (idx === qObj.answer) {
            btn.className = "w-full text-left p-3 rounded border border-cyan-deep bg-cyan-soft text-ink text-xs font-mono font-bold";
            quizScore++;
            document.getElementById('quiz-score').innerText = quizScore;
          } else {
            btn.className = "w-full text-left p-3 rounded border border-error bg-error-soft text-error-deep text-xs font-mono font-bold";
          }
          setTimeout(() => {
            if (currentQuizIdx < aiQuizzes.length - 1) {
              currentQuizIdx++;
              renderQuizCard();
            }
          }, 900);
        };
        optBox.appendChild(btn);
      });
    }

    // Flashcard Render Function
    function renderFlashcard() {
      const card = aiFlashcards[flashcardIdx] || { front: "End of Deck", back: "Restarting..." };
      document.getElementById('flashcard-text-front').innerText = card.front;
      document.getElementById('flashcard-text-back').innerText = card.back;
      document.getElementById('fc-counter').innerText = `Card ${flashcardIdx + 1} of ${aiFlashcards.length}`;
      document.getElementById('fc-term-tag').innerText = `Term ${flashcardIdx + 1} of ${aiFlashcards.length}`;
      
      document.getElementById('flashcard-text-back').classList.add('hidden');
      flashcardFlipped = false;
    }

    document.getElementById('flashcard-element')?.addEventListener('click', () => {
      flashcardFlipped = !flashcardFlipped;
      if (flashcardFlipped) {
        document.getElementById('flashcard-text-back').classList.remove('hidden');
      } else {
        document.getElementById('flashcard-text-back').classList.add('hidden');
      }
    });

    document.getElementById('fc-next-btn')?.addEventListener('click', () => {
      if (flashcardIdx < aiFlashcards.length - 1) {
        flashcardIdx++;
        renderFlashcard();
      }
    });

    document.getElementById('fc-prev-btn')?.addEventListener('click', () => {
      if (flashcardIdx > 0) {
        flashcardIdx--;
        renderFlashcard();
      }
    });

    // Game Question Render
    function renderGameQuestion() {
      const gObj = aiGameQuestions[currentGameIdx] || aiGameQuestions[0];
      document.getElementById('game-q-text').innerText = gObj.q;
      const container = document.getElementById('game-options-container');
      container.innerHTML = '';

      (gObj.options || ["YES ✅", "NO ❌"]).forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = `px-6 py-2 ${idx === 0 ? 'bg-link' : 'bg-error'} text-white rounded-sm text-xs font-mono font-bold hover:opacity-90 transition cursor-pointer`;
        btn.innerText = opt;
        btn.onclick = () => {
          const feedback = document.getElementById('game-feedback');
          if (idx === gObj.answer) {
            gameStars += 20;
            document.getElementById('game-stars').innerText = gameStars;
            feedback.innerText = `✨ Correct! ${gObj.explanation || '+20 Stars ⭐'}`;
          } else {
            feedback.innerText = `💥 Oops! ${gObj.explanation || 'Try next question!'}`;
          }
          setTimeout(() => {
            if (currentGameIdx < aiGameQuestions.length - 1) {
              currentGameIdx++;
              renderGameQuestion();
            }
          }, 1200);
        };
        container.appendChild(btn);
      });
    }

    // AI Chat Teacher Q&A Box
    document.getElementById('ai-chat-btn')?.addEventListener('click', async () => {
      const input = document.getElementById('ai-chat-input');
      const q = input.value.trim();
      const respBox = document.getElementById('ai-chat-response');
      if (!q) return;

      respBox.classList.remove('hidden');
      respBox.innerText = '🤔 Kiddie Teacher is thinking...';

      try {
        const topic = document.getElementById('yt-url-input').value.trim() || 'this lesson';
        const tone = document.getElementById('tone-select').value;
        const answer = await callKiddieAI(`The student is asking about topic "${topic}": "${q}". Answer simply for grade level ${tone}.`);
        respBox.innerText = `🤖 Kiddie Teacher: ${answer}`;
        input.value = '';
      } catch (err) {
        respBox.innerText = `⚠️ Error: ${err.message}`;
      }
    });

    // Speech Synthesis Read Aloud
    document.getElementById('read-aloud-btn')?.addEventListener('click', () => {
      const text = document.getElementById('notes-summary-text').innerText;
      if ('speechSynthesis' in window && text) {
        window.speechSynthesis.cancel();
        const msg = new SpeechSynthesisUtterance(text);
        window.speechSynthesis.speak(msg);
      }
    });

    // Copy Button
    document.getElementById('copy-btn')?.addEventListener('click', () => {
      const text = document.getElementById('notes-summary-text').innerText;
      if (text) {
        navigator.clipboard.writeText(text);
        const btn = document.getElementById('copy-btn');
        btn.innerText = 'Copied! ✓';
        setTimeout(() => btn.innerText = '📋 Copy', 2000);
      }
    });
  </script>
</Layout>
