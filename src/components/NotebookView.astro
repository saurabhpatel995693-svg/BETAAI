---
---

<div id="notebook-view" class="hidden flex-1 max-w-5xl w-full mx-auto p-4 md:p-6 space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-display-sm text-themed-ink font-semibold tracking-tight">Study Notebooks</h2>
      <p class="text-xs text-themed-body">Create flashcards, practice quizzes, and summaries from your notes.</p>
    </div>
    <button id="create-note-btn" class="px-3.5 py-2 rounded-md btn-ink text-xs font-medium hover:opacity-90 transition-all shadow-level-2">
      + New Note
    </button>
  </div>

  <!-- Notebook Grid -->
  <div id="notebook-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <!-- Default Sample Note -->
    <div class="p-5 rounded-lg border border-themed surface-card hover:surface-card2 transition-all space-y-3 shadow-level-2">
      <div class="flex items-center justify-between text-xs">
        <span class="px-2 py-0.5 rounded-full surface-card2 border border-themed text-themed-mute font-mono">Physics</span>
        <span class="text-themed-mute text-[10px]">Just now</span>
      </div>
    </div>
  </div>
</div>
