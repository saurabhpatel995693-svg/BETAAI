---
---
<div id="notebook-view" class="hidden flex-1 max-w-5xl w-full mx-auto p-4 md:p-6 space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold font-syne text-themed-ink">Study Notebooks</h2>
      <p class="text-xs text-themed-mute">Create flashcards, practice quizzes, and summaries from your notes.</p>
    </div>
    <button id="create-note-btn" class="px-3.5 py-2 rounded-xl bg-amber-500 text-slate-950 font-semibold text-xs hover:bg-amber-400 transition-all">
      + New Note
    </button>
  </div>

  <!-- Notebook Grid -->
  <div id="notebook-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <!-- Default Sample Note -->
    <div class="p-5 rounded-2xl border border-themed bg-themed-card hover:border-amber-500/30 transition-all space-y-3">
      <div class="flex items-center justify-between text-xs">
        <span class="px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-500 font-mono">Physics</span>
        <span class="text-themed-mute">Just now</span>
      </div>
      <h3 class="font-bold text-themed-ink text-sm">Light & Optics Fundamentals</h3>
      <p class="text-xs text-themed-mute line-clamp-3">
        Refraction is the bending of light as it passes from one transparent substance into another...
      </p>
      <div class="pt-2 flex items-center gap-2 text-xs">
        <button class="px-2.5 py-1 rounded-lg border border-themed hover:border-amber-500/40 text-themed-ink">Quiz (4Q)</button>
        <button class="px-2.5 py-1 rounded-lg border border-themed hover:border-amber-500/40 text-themed-ink">Flashcards</button>
      </div>
    </div>
  </div>
</div>
