---
---

<div id="chat-view" class="flex-1 flex flex-col max-w-5xl w-full mx-auto p-4 md:p-6 overflow-hidden">
  <!-- Message Feed -->
  <div id="message-container" class="flex-1 overflow-y-auto space-y-6 pr-2 mb-4">
    <!-- Welcome Card -->
    <div id="welcome-banner" class="p-6 md:p-8 rounded-lg border border-themed surface-card shadow-level-2 text-center space-y-4 my-auto">
      <div class="w-16 h-16 rounded-lg mesh-gradient flex items-center justify-center text-white text-3xl mx-auto animate-float shadow-level-3">
        Š
      </div>
      <h2 class="text-display-md text-themed-ink font-semibold tracking-tight">Welcome to SHESHAAI</h2>
      <p class="text-sm text-themed-body max-w-md mx-auto">
        Multi-modal AI assistant with real-time response generation, code synthesis, image generation, and study notebooks.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-left max-w-2xl mx-auto pt-2">
        <button class="quick-prompt-btn p-3 rounded-md border border-themed surface-card hover:surface-card2 transition-all text-xs space-y-1 shadow-level-2">
          <div class="font-semibold text-themed-ink">💡 Coding Assistant</div>
          <div class="text-themed-body text-[11px]">Build a clean responsive Astro UI component with CSS</div>
        </button>
        <button class="quick-prompt-btn p-3 rounded-md border border-themed surface-card hover:surface-card2 transition-all text-xs space-y-1 shadow-level-2">
          <div class="font-semibold text-themed-ink">📚 Study Quiz</div>
          <div class="text-themed-body text-[11px]">Create a 5-question quiz on Quantum Physics</div>
        </button>
        <button class="quick-prompt-btn p-3 rounded-md border border-themed surface-card hover:surface-card2 transition-all text-xs space-y-1 shadow-level-2">
          <div class="font-semibold text-themed-ink">🎨 Image Prompt</div>
          <div class="text-themed-body text-[11px]">Generate a futuristic cyberpunk city at sunset</div>
        </button>
      </div>
    </div>
  </div>

  <!-- Input Form -->
  <div class="sticky bottom-0 surface-page pt-2">
    <form id="chat-form" class="relative flex items-end gap-2 surface-card p-2 rounded-lg border border-themed focus-within:border-link/60 shadow-level-3 transition-all">
      <textarea
        id="user-input"
        rows="1"
        placeholder="Ask SHESHAAI anything (Code, Questions, Study, Prompts)..."
        class="flex-1 bg-transparent border-none outline-none resize-none text-sm text-themed-ink placeholder:text-themed-mute px-3 py-2 max-h-36 overflow-y-auto"
      ></textarea>
      
      <button
        type="submit"
        id="send-btn"
        class="px-4 py-2.5 rounded-md btn-ink text-sm font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1.5 shadow-level-2 hover:opacity-90"
      >
        <span>Send</span>
        <svg class="w-3.5 h-3.5 rotate-90" fill="currentColor" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
      </button>
    </form>
    <div class="flex items-center justify-between text-[11px] text-themed-mute px-3 mt-1.5">
      <span>Shift + Enter for new line</span>
      <span class="text-themed-mute font-mono text-[10px]">SHESHAAI v3.0</span>
    </div>
  </div>
</div>
