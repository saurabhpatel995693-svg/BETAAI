---
---
<div id="chat-view" class="flex-1 flex flex-col max-w-5xl w-full mx-auto p-4 md:p-6 overflow-hidden">
  <!-- Message Feed -->
  <div id="message-container" class="flex-1 overflow-y-auto space-y-6 pr-2 mb-4">
    <!-- Welcome Card -->
    <div id="welcome-banner" class="p-6 md:p-8 rounded-2xl border border-amber-500/20 bg-gradient-to-b from-amber-500/5 to-transparent text-center space-y-4 my-auto">
      <div class="w-16 h-16 rounded-2xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center text-3xl mx-auto animate-float">
        🚀
      </div>
      <h2 class="text-2xl font-bold font-syne text-themed-ink">Welcome to SHESHAAI</h2>
      <p class="text-sm text-themed-mute max-w-md mx-auto">
        Multi-modal AI assistant with real-time response generation, code synthesis, image generation, and study notebooks.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-left max-w-2xl mx-auto pt-2">
        <button class="quick-prompt-btn p-3 rounded-xl border border-themed bg-themed-card hover:border-amber-500/40 transition-all text-xs space-y-1">
          <div class="font-semibold text-themed-ink">💡 Coding Assistant</div>
          <div class="text-themed-mute">Build a clean responsive Astro UI component with CSS</div>
        </button>
        <button class="quick-prompt-btn p-3 rounded-xl border border-themed bg-themed-card hover:border-amber-500/40 transition-all text-xs space-y-1">
          <div class="font-semibold text-themed-ink">📚 Study Quiz</div>
          <div class="text-themed-mute">Create a 5-question quiz on Quantum Physics</div>
        </button>
        <button class="quick-prompt-btn p-3 rounded-xl border border-themed bg-themed-card hover:border-amber-500/40 transition-all text-xs space-y-1">
          <div class="font-semibold text-themed-ink">🎨 Image Prompt</div>
          <div class="text-themed-mute">Generate a futuristic cyberpunk city at sunset</div>
        </button>
      </div>
    </div>
  </div>

  <!-- Input Form -->
  <div class="sticky bottom-0 bg-surface pt-2">
    <form id="chat-form" class="relative flex items-end gap-2 bg-themed-card p-2 rounded-2xl border border-themed focus-within:border-amber-500/60 shadow-lg transition-all">
      <textarea
        id="user-input"
        rows="1"
        placeholder="Ask SHESHAAI anything (Code, Questions, Study, Prompts)..."
        class="flex-1 bg-transparent border-none outline-none resize-none text-sm text-themed-ink px-3 py-2 max-h-36 overflow-y-auto"
      ></textarea>
      
      <button
        type="submit"
        id="send-btn"
        class="px-4 py-2.5 rounded-xl bg-amber-500 text-slate-950 font-semibold text-xs hover:bg-amber-400 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1.5 shadow-sm"
      >
        <span>Send</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </button>
    </form>
    <div class="flex items-center justify-between text-[11px] text-themed-mute px-3 mt-1.5">
      <span>Shift + Enter for new line</span>
      <span class="text-amber-500/80 font-mono">Ponytail Engine v1.0</span>
    </div>
  </div>
</div>
