---
---
<header class="h-16 border-b border-themed bg-surface flex items-center justify-between px-4 md:px-8 sticky top-0 z-30 backdrop-blur-md bg-opacity-90">
  <div class="flex items-center gap-3">
    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-300 flex items-center justify-center text-slate-950 font-bold text-lg shadow-md shadow-amber-500/20">
      ⚡
    </div>
    <div>
      <h1 class="font-syne font-bold text-lg tracking-tight text-themed-ink flex items-center gap-2">
        SHESHAAI
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20 font-mono">by SAURABH</span>
      </h1>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <!-- Mode Switcher -->
    <div class="hidden sm:flex bg-themed-card p-1 rounded-xl border border-themed text-xs font-medium">
      <button id="nav-chat-btn" class="px-3 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-semibold shadow-sm transition-all">Chat & Code</button>
      <button id="nav-notebook-btn" class="px-3 py-1.5 rounded-lg text-themed-mute hover:text-themed-ink transition-all">Notebooks</button>
    </div>

    <!-- Theme Toggle -->
    <button id="theme-toggle-btn" class="p-2 rounded-xl border border-themed bg-themed-card text-themed-ink hover:border-amber-500/50 transition-all text-sm" title="Toggle Dark/Light Mode">
      🌙
    </button>

    <!-- Clear Chat -->
    <button id="clear-chat-btn" class="p-2 rounded-xl border border-themed bg-themed-card text-themed-mute hover:text-red-400 hover:border-red-500/30 transition-all text-sm" title="Clear Chat History">
      🗑️
    </button>
  </div>
</header>
